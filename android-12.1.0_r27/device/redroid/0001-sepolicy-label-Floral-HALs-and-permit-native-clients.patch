index 2bfd4d3..f21df60 100644
--- a/redroid_arm64_only/BoardConfig.mk
+++ b/redroid_arm64_only/BoardConfig.mk
@@ -19,6 +19,7 @@ BOARD_GPU_DRIVERS := kmsro swrast virgl radeonsi nouveau freedreno panfrost v3d
 BOARD_MESA3D_VULKAN_DRIVERS := swrast
 
 BOARD_VENDOR_SEPOLICY_DIRS += \
