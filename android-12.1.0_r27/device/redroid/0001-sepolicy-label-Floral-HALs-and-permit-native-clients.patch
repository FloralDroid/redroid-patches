diff --git a/sepolicy/vendor/app.te b/sepolicy/vendor/app.te
new file mode 100644
index 0000000..31a09c5
--- /dev/null
+++ b/sepolicy/vendor/app.te
@@ -0,0 +1,21 @@
+# Mesa/Minigbm uses the standard allocator/mapper HAL client boundary.
+# Register concrete app domains so isolated_app retains its HIDL prohibition.
+hal_client_domain(zygote, hal_graphics_allocator)
+hal_client_domain(platform_app, hal_graphics_allocator)
+hal_client_domain(priv_app, hal_graphics_allocator)
+hal_client_domain(system_app, hal_graphics_allocator)
+hal_client_domain(untrusted_app, hal_graphics_allocator)
+hal_client_domain(untrusted_app_25, hal_graphics_allocator)
+hal_client_domain(untrusted_app_27, hal_graphics_allocator)
+hal_client_domain(untrusted_app_29, hal_graphics_allocator)
+hal_client_domain(ephemeral_app, hal_graphics_allocator)
+
+# NDK MediaCodec clients use the Codec2 store directly.
+hal_client_domain(platform_app, hal_codec2)
+hal_client_domain(priv_app, hal_codec2)
+hal_client_domain(system_app, hal_codec2)
+hal_client_domain(untrusted_app, hal_codec2)
+hal_client_domain(untrusted_app_25, hal_codec2)
+hal_client_domain(untrusted_app_27, hal_codec2)
+hal_client_domain(untrusted_app_29, hal_codec2)
+hal_client_domain(ephemeral_app, hal_codec2)
diff --git a/sepolicy/vendor/domain.te b/sepolicy/vendor/domain.te
new file mode 100644
index 0000000..f030f12
--- /dev/null
+++ b/sepolicy/vendor/domain.te
@@ -0,0 +1,2 @@
+# Public presentation identity, separate from private boot configuration.
+get_prop(domain, vendor_floral_identity_prop)
diff --git a/sepolicy/vendor/file.te b/sepolicy/vendor/file.te
new file mode 100644
index 0000000..0334ccb
--- /dev/null
+++ b/sepolicy/vendor/file.te
@@ -0,0 +1,8 @@
+# libdrm reads the SDM845 DRM parent's uevent to enumerate render devices.
+type sysfs_redroid_gpu, fs_type, sysfs_type;
+
+# Immutable public instance profile, separate from private radio/Wi-Fi inputs.
+type floral_profile_file, file_type;
+allow init floral_profile_file:file r_file_perms;
+allow system_server floral_stream_file:dir search;
+allow system_server floral_profile_file:file r_file_perms;
diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
new file mode 100644
index 0000000..fc52f38
--- /dev/null
+++ b/sepolicy/vendor/file_contexts
@@ -0,0 +1,19 @@
+/dev/dri(/.*)?    u:object_r:gpu_device:s0
+/dev/pts/ptmx    u:object_r:ptmx_device:s0
+/ipc/floral_stream/device\.prop    u:object_r:floral_profile_file:s0
+/dev/media[0-9]+    u:object_r:video_device:s0
+
+/vendor/bin/(gpu_config|post-fs-data\.redroid)\.sh    u:object_r:redroid_init_exec:s0
+/vendor/bin/hw/android\.hardware\.bluetooth@1\.1-service\.sim    u:object_r:hal_bluetooth_default_exec:s0
+/vendor/bin/hw/android\.hardware\.gatekeeper@1\.0-service\.software    u:object_r:hal_gatekeeper_default_exec:s0
+/vendor/bin/hw/android\.hardware\.graphics\.allocator@4\.0-service\.minigbm    u:object_r:hal_graphics_allocator_default_exec:s0
+/vendor/bin/hw/android\.hardware\.media\.c2@1\.2-service-floral    u:object_r:mediacodec_exec:s0
+
+# Mesa/Minigbm dependencies loaded into framework and app processes.
+/vendor/lib(64)?/hw/android\.hardware\.graphics\.mapper@4\.0-impl\.minigbm\.so    u:object_r:same_process_hal_file:s0
+/vendor/lib(64)?/hw/vulkan\.[^/]+\.so    u:object_r:same_process_hal_file:s0
+/vendor/lib(64)?/libdrm(_amdgpu|_radeon|_nouveau)?\.so(\.[0-9]+)*    u:object_r:same_process_hal_file:s0
+/vendor/lib(64)?/libglapi\.so(\.[0-9]+)*    u:object_r:same_process_hal_file:s0
+/vendor/lib(64)?/libc\+\+_shared\.so    u:object_r:same_process_hal_file:s0
+/vendor/lib(64)?/dri(/.*)?    u:object_r:same_process_hal_file:s0
+/vendor/lib(64)?/libLLVM-[0-9]+\.so    u:object_r:same_process_hal_file:s0
diff --git a/sepolicy/vendor/genfs_contexts b/sepolicy/vendor/genfs_contexts
new file mode 100644
index 0000000..565513f
--- /dev/null
+++ b/sepolicy/vendor/genfs_contexts
@@ -0,0 +1 @@
+genfscon sysfs /devices/platform/soc@0/ae00000.display-subsystem/ae01000.display-controller/uevent u:object_r:sysfs_redroid_gpu:s0
diff --git a/sepolicy/vendor/hal_codec2.te b/sepolicy/vendor/hal_codec2.te
new file mode 100644
index 0000000..71e88ce
--- /dev/null
+++ b/sepolicy/vendor/hal_codec2.te
@@ -0,0 +1,5 @@
+# FMQ uses memfd when ashmem is absent. Keep codec shared memory separate
+# from generic tmpfs and preserve ashmem's cross-UID sharing semantics.
+type redroid_codec2_tmpfs, file_type, mlstrustedobject;
+type_transition hal_codec2_server tmpfs:file redroid_codec2_tmpfs;
+allow { hal_codec2_client hal_codec2_server } redroid_codec2_tmpfs:file rw_file_perms;
diff --git a/sepolicy/vendor/hal_graphics_allocator.te b/sepolicy/vendor/hal_graphics_allocator.te
new file mode 100644
index 0000000..ccea1b1
--- /dev/null
+++ b/sepolicy/vendor/hal_graphics_allocator.te
@@ -0,0 +1,3 @@
+# Mesa and Minigbm enumerate render nodes from clients as well as the HAL.
+allow { hal_graphics_allocator_client hal_graphics_allocator_server appdomain } gpu_device:dir r_dir_perms;
+allow { hal_graphics_allocator_client hal_graphics_allocator_server appdomain -isolated_app } sysfs_redroid_gpu:file r_file_perms;
diff --git a/sepolicy/vendor/hal_graphics_composer_default.te b/sepolicy/vendor/hal_graphics_composer_default.te
new file mode 100644
index 0000000..2d8cb8d
--- /dev/null
+++ b/sepolicy/vendor/hal_graphics_composer_default.te
@@ -0,0 +1,5 @@
+# Display dimensions, density, frame rate and control-channel lease.
+get_prop(hal_graphics_composer_default, vendor_floral_config_prop)
+
+# The standard HIDL composer service initializes its vendor Binder thread pool.
+vndbinder_use(hal_graphics_composer_default)
diff --git a/sepolicy/vendor/hal_power_default.te b/sepolicy/vendor/hal_power_default.te
new file mode 100644
index 0000000..7bf6602
--- /dev/null
+++ b/sepolicy/vendor/hal_power_default.te
@@ -0,0 +1,4 @@
+# Read the immutable instance profile, never host power_supply state. The
+# transport directory grants traversal only; socket ownership is unchanged.
+allow hal_power_default floral_stream_file:dir search;
+allow hal_power_default floral_profile_file:file r_file_perms;
diff --git a/sepolicy/vendor/hal_sensors_default.te b/sepolicy/vendor/hal_sensors_default.te
new file mode 100644
index 0000000..68e1521
--- /dev/null
+++ b/sepolicy/vendor/hal_sensors_default.te
@@ -0,0 +1,3 @@
+# Sensor identities come from the same immutable instance profile as init.
+allow hal_sensors_default floral_stream_file:dir search;
+allow hal_sensors_default floral_profile_file:file r_file_perms;
diff --git a/sepolicy/vendor/mediacodec.te b/sepolicy/vendor/mediacodec.te
new file mode 100644
index 0000000..7a34904
--- /dev/null
+++ b/sepolicy/vendor/mediacodec.te
@@ -0,0 +1,6 @@
+# Optional V4L2/VA-API device selection.
+get_prop(mediacodec, vendor_floral_config_prop)
+
+# CapabilityProbe enumerates /dev/video* on ARM and render nodes for VA-API.
+allow mediacodec device:dir r_dir_perms;
+allow mediacodec gpu_device:dir r_dir_perms;
diff --git a/sepolicy/vendor/property.te b/sepolicy/vendor/property.te
new file mode 100644
index 0000000..a2670ad
--- /dev/null
+++ b/sepolicy/vendor/property.te
@@ -0,0 +1,2 @@
+vendor_internal_prop(vendor_redroid_init_prop)
+vendor_public_prop(vendor_floral_identity_prop)
diff --git a/sepolicy/vendor/property_contexts b/sepolicy/vendor/property_contexts
new file mode 100644
index 0000000..a657a37
--- /dev/null
+++ b/sepolicy/vendor/property_contexts
@@ -0,0 +1,8 @@
+vendor.floral.gpu.                 u:object_r:vendor_redroid_init_prop:s0
+vendor.floral.init.memfd            u:object_r:vendor_redroid_init_prop:s0 exact bool
+
+# uname and the public GPU identity API are called from every app domain.
+ro.boot.floral_kernel_release       u:object_r:vendor_floral_identity_prop:s0 exact string
+ro.boot.floral_kernel_version       u:object_r:vendor_floral_identity_prop:s0 exact string
+ro.boot.floral_gpu_vendor           u:object_r:vendor_floral_identity_prop:s0 exact string
+ro.boot.floral_gpu_model            u:object_r:vendor_floral_identity_prop:s0 exact string
diff --git a/sepolicy/vendor/redroid_init.te b/sepolicy/vendor/redroid_init.te
new file mode 100644
index 0000000..e6726da
--- /dev/null
+++ b/sepolicy/vendor/redroid_init.te
@@ -0,0 +1,20 @@
+# One-shot vendor probes. Protected platform properties are set by init.
+type redroid_init, domain;
+type redroid_init_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(redroid_init)
+
+# Public platform role: read the selected DRM identity labels, not GPU controls.
+typeattribute redroid_init floral_graphics_probe;
+
+allow redroid_init vendor_shell_exec:file rx_file_perms;
+allow redroid_init vendor_toolbox_exec:file rx_file_perms;
+get_prop(redroid_init, vendor_floral_config_prop)
+set_prop(redroid_init, vendor_redroid_init_prop)
+get_prop(vendor_init, vendor_redroid_init_prop)
+
+# Enumerate render nodes and identify their kernel driver without opening DRM.
+allow redroid_init gpu_device:dir r_dir_perms;
+allow redroid_init gpu_device:chr_file { getattr setattr };
+allow redroid_init ashmem_device:chr_file getattr;
+r_dir_file(redroid_init, sysfs)
+allow redroid_init sysfs_redroid_gpu:file r_file_perms;
diff --git a/sepolicy/vendor/rild.te b/sepolicy/vendor/rild.te
new file mode 100644
index 0000000..d74de77
--- /dev/null
+++ b/sepolicy/vendor/rild.te
@@ -0,0 +1,2 @@
+# Floral radio also publishes its companion AIDL service on /dev/binder.
+binder_use(rild)
diff --git a/sepolicy/vendor/surfaceflinger.te b/sepolicy/vendor/surfaceflinger.te
new file mode 100644
index 0000000..4488b5e
--- /dev/null
+++ b/sepolicy/vendor/surfaceflinger.te
@@ -0,0 +1,2 @@
+# Read the explicit secure-capture setting used by the Floral compositor.
+get_prop(surfaceflinger, vendor_floral_config_prop)
