+static bool WaitForCgroupSetup(int fd) {
+    uint8_t result;
+    return TEMP_FAILURE_RETRY(read(fd, &result, sizeof(result))) == 1 && result == 1;
+}
+
+static bool ReadCgroupChildIdentity(pid_t pid, uid_t* uid, pid_t* parent) {
+    std::string status;
+    if (!ReadFileToString(StringPrintf("/proc/%d/status", pid), &status)) {
+        PLOG(WARNING) << "Unable to read cgroup child identity for pid " << pid;
+        return false;
+    }
+    size_t uid_offset = status.find("\nUid:");
+    size_t parent_offset = status.find("\nPPid:");
+    unsigned int real, effective, saved, filesystem;
+    int parent_pid;
+    if (uid_offset == std::string::npos || parent_offset == std::string::npos ||
+        sscanf(status.c_str() + uid_offset, "\nUid: %u %u %u %u", &real, &effective,
+               &saved, &filesystem) != 4 ||
+        sscanf(status.c_str() + parent_offset, "\nPPid: %d", &parent_pid) != 1 ||
+        real != effective || real != saved || real != filesystem || parent_pid <= 0) {
+        ALOGW("Invalid cgroup child identity for pid %d", pid);
+        return false;
+    }
+    *uid = real;
+    *parent = parent_pid;
+    return true;
+}
