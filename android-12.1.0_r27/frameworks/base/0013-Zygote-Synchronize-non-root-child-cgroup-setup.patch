+    private static boolean waitForCgroupChild(FileDescriptor pipe) {
+        StructPollfd pollFd = new StructPollfd();
+        pollFd.fd = pipe;
+        pollFd.events = (short) POLLIN;
+        StructPollfd[] fds = new StructPollfd[]{pollFd};
+        byte[] ready = new byte[1];
+        long startTime = System.nanoTime();
+        while (true) {
+            long elapsed = TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - startTime);
+            if (elapsed >= WRAPPED_PID_TIMEOUT_MILLIS) {
+                Log.w(TAG, "Timed out waiting for child cgroup identity");
+                return false;
+            }
+            try {
+                pollFd.revents = 0;
+                if (Os.poll(fds, WRAPPED_PID_TIMEOUT_MILLIS - (int) elapsed) == 0
+                        || (pollFd.revents & POLLIN) == 0) {
+                    return false;
+                }
+                return Os.read(pipe, ready, 0, 1) == 1 && ready[0] == 1;
+            } catch (ErrnoException ex) {
+                if (ex.errno != OsConstants.EINTR) {
+                    Log.w(TAG, "Unable to read child cgroup identity acknowledgement", ex);
+                    return false;
+                }
+            } catch (IOException ex) {
+                Log.w(TAG, "Unable to read child cgroup identity acknowledgement", ex);
+                return false;
+            }
+        }
+    }
