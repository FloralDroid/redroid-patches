+    public boolean shouldHideGestureNavigationBar() {
+        return !areNavigationButtonForcedVisible()
+                && Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                        Settings.Secure.HIDE_GESTURE_NAVIGATION_BAR, 0,
+                        UserHandle.USER_CURRENT) != 0;
+    }
