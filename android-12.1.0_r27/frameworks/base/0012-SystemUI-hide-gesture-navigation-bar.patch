+    private void updateGestureNavigationBarVisibility() {
+        if (mNavigationBarView == null) return;
+        final boolean hidden = mNavBarMode == NAV_BAR_MODE_GESTURAL
+                && mGestureNavigationSettingsObserver.shouldHideGestureNavigationBar();
+        mNavigationBarView.setGestureNavigationBarHidden(hidden);
+        if (hidden) {
+            resetSecondaryHandle();
+        }
+    }
+
     private boolean canShowSecondaryHandle() {
-        return mNavBarMode == NAV_BAR_MODE_GESTURAL && mOrientationHandle != null;
+        return mNavBarMode == NAV_BAR_MODE_GESTURAL && mOrientationHandle != null
+                && !mNavigationBarView.isGestureNavigationBarHidden();
     }
 
     private final Consumer<Integer> mRotationWatcher = rotation -> {
@@ -1642,6 +1663,7 @@ public class NavigationBar implements View.OnAttachStateChangeListener,
