     private final OnComputeInternalInsetsListener mOnComputeInternalInsetsListener = info -> {
+        if (mGestureNavigationBarHidden) {
+            info.setTouchableInsets(InternalInsetsInfo.TOUCHABLE_INSETS_REGION);
+            info.touchableRegion.setEmpty();
+            return;
+        }
         // When the nav bar is in 2-button or 3-button mode, or when IME is visible in fully
         // gestural mode, the entire nav bar should be touchable.
         if (!mEdgeBackGestureHandler.isHandlingGestures()) {
@@ -973,6 +979,27 @@ public class NavigationBarView extends FrameLayout implements
         reloadNavIcons();
     }
 
+    public void setGestureNavigationBarHidden(boolean hidden) {
+        if (mGestureNavigationBarHidden == hidden) return;
+        mGestureNavigationBarHidden = hidden;
+        setImportantForAccessibility(hidden ? IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS
+                : IMPORTANT_FOR_ACCESSIBILITY_AUTO);
+        invalidate();
+        requestLayout();
+    }
+
+    public boolean isGestureNavigationBarHidden() {
+        return mGestureNavigationBarHidden;
+    }
+
+    @Override
+    public void draw(Canvas canvas) {
+        // Keep the window and gesture input providers, but draw neither bar nor background.
+        if (!mGestureNavigationBarHidden) {
+            super.draw(canvas);
+        }
+    }
+
     @Override
     protected void onDraw(Canvas canvas) {
         mDeadZone.onDraw(canvas);
