@@ -270,6 +272,7 @@ private:
     std::shared_ptr<IResourceManagerService> mService;
     std::shared_ptr<IResourceManagerClient> mClient;
     ::ndk::ScopedAIBinder_DeathRecipient mDeathRecipient;
+    bool mVideoBatteryPosted = false;
 };
 
 MediaCodec::ResourceManagerServiceProxy::ResourceManagerServiceProxy(
@@ -367,8 +370,31 @@ void MediaCodec::ResourceManagerServiceProxy::removeResource(
     mService->removeResource(mPid, getId(mClient), resources);
 }
 
+void MediaCodec::ResourceManagerServiceProxy::reportVideoBatteryResource(bool active) {
+    Mutex::Autolock _l(mLock);
+    if (mService == nullptr) {
+        return;
+    }
+    // Keep the service/client alive without holding mLock during the RPC.
+    // A queued call to an old, dead service must not reach a replacement.
+    VideoBatteryReporter::getInstance()->post(
+            [service = mService, client = mClient, pid = mPid, uid = mUid, active] {
+        std::vector<MediaResourceParcel> resources{MediaResource::VideoBatteryResource()};
+        Status status = active
+                ? service->addResource(pid, uid, getId(client), client, resources)
+                : service->removeResource(pid, getId(client), resources);
+        if (!status.isOk()) {
+            ALOGW("Video battery resource update failed: %s", status.getDescription().c_str());
+        }
+    });
+    mVideoBatteryPosted = true;
+}
+
 void MediaCodec::ResourceManagerServiceProxy::removeClient() {
     Mutex::Autolock _l(mLock);
+    if (mVideoBatteryPosted) {
+        VideoBatteryReporter::getInstance()->flush();
+    }
     if (mService == nullptr) {
         return;
     }
@@ -377,6 +403,9 @@ void MediaCodec::ResourceManagerServiceProxy::removeClient() {
 
 void MediaCodec::ResourceManagerServiceProxy::markClientForPendingRemoval() {
     Mutex::Autolock _l(mLock);
+    if (mVideoBatteryPosted) {
+        VideoBatteryReporter::getInstance()->flush();
+    }
     if (mService == nullptr) {
         return;
     }
@@ -1151,7 +1180,7 @@ void MediaCodec::statsBufferSent(int64_t presentationUs, const sp<MediaCodecBuff
 
     if (mBatteryChecker != nullptr) {
         mBatteryChecker->onCodecActivity([this] () {
-            mResourceManagerProxy->addResource(MediaResource::VideoBatteryResource());
+            mResourceManagerProxy->reportVideoBatteryResource(true);
         });
     }
 
@@ -1225,7 +1254,7 @@ void MediaCodec::statsBufferReceived(int64_t presentationUs, const sp<MediaCodec
 
     if (mBatteryChecker != nullptr) {
         mBatteryChecker->onCodecActivity([this] () {
-            mResourceManagerProxy->addResource(MediaResource::VideoBatteryResource());
+            mResourceManagerProxy->reportVideoBatteryResource(true);
         });
     }
 
@@ -4441,8 +4470,7 @@ void MediaCodec::onMessageReceived(const sp<AMessage> &msg) {
         {
             if (mBatteryChecker != nullptr) {
                 mBatteryChecker->onCheckBatteryTimer(msg, [this] () {
-                    mResourceManagerProxy->removeResource(
-                            MediaResource::VideoBatteryResource());
+                    mResourceManagerProxy->reportVideoBatteryResource(false);
                 });
             }
             break;
diff --git a/media/libstagefright/VideoBatteryReporter.h b/media/libstagefright/VideoBatteryReporter.h
new file mode 100644
index 0000000..34700ae
--- /dev/null
+++ b/media/libstagefright/VideoBatteryReporter.h
@@ -0,0 +1,80 @@
