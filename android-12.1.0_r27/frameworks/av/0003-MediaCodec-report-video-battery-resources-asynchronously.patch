+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <media/stagefright/foundation/ADebug.h>
+#include <media/stagefright/foundation/AHandler.h>
+#include <media/stagefright/foundation/AMessage.h>
+
+#include <functional>
+#include <utility>
+
+namespace android {
+
+// Battery statistics must not hold up codec input/output. Share one FIFO
+// between codecs, and drain it before removing their ResourceManager clients.
+class VideoBatteryReporter : public AHandler {
+public:
+    static sp<VideoBatteryReporter> getInstance() {
+        static sp<VideoBatteryReporter> instance = [] {
+            sp<VideoBatteryReporter> reporter = new VideoBatteryReporter;
+            reporter->mLooper = new ALooper;
+            reporter->mLooper->setName("VideoBattery");
+            reporter->mLooper->registerHandler(reporter);
+            CHECK_EQ(reporter->mLooper->start(), OK);
+            return reporter;
+        }();
+        return instance;
+    }
+
+    void post(std::function<void()> action) {
+        sp<AMessage> message = new AMessage(0, this);
+        message->setObject("task", new Task(std::move(action)));
+        CHECK_EQ(message->post(), OK);
+    }
+
+    void flush() {
+        sp<AMessage> response;
+        CHECK_EQ((new AMessage(0, this))->postAndAwaitResponse(&response), OK);
+    }
+
+private:
+    struct Task : public RefBase {
+        explicit Task(std::function<void()> callback) : action(std::move(callback)) {}
+        const std::function<void()> action;
+    };
+
+    VideoBatteryReporter() = default;
+    ~VideoBatteryReporter() override {
+        mLooper->stop();
+    }
+
+    void onMessageReceived(const sp<AMessage>& message) override {
+        sp<RefBase> object;
+        if (message->findObject("task", &object)) {
+            static_cast<Task*>(object.get())->action();
+        }
+        sp<AReplyToken> reply;
+        if (message->senderAwaitsResponse(&reply)) {
+            (new AMessage)->postReply(reply);
+        }
+    }
+
+    sp<ALooper> mLooper;
+};
+
+}  // namespace android
