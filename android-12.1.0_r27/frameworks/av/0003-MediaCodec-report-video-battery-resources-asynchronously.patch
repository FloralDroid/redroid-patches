+#include <future>
+#include <thread>
+#include <vector>
+
+using namespace android;
+using namespace std::chrono_literals;
+
+TEST(VideoBatteryReporterTest, QueuingDoesNotWaitForBlockedReport) {
+    sp<VideoBatteryReporter> reporter = VideoBatteryReporter::getInstance();
+    std::promise<void> entered, release, queued;
+    std::shared_future<void> released = release.get_future().share();
+    std::thread::id worker;
+    reporter->post([&] {
+        worker = std::this_thread::get_id();
+        entered.set_value();
+        released.wait();
+    });
+    EXPECT_EQ(entered.get_future().wait_for(2s), std::future_status::ready);
+    auto posting = std::async(std::launch::async, [&] {
+        reporter->post([&] { queued.set_value(); });
+    });
+    EXPECT_EQ(posting.wait_for(2s), std::future_status::ready);
+    EXPECT_EQ(queued.get_future().wait_for(0s), std::future_status::timeout);
+    release.set_value();
+    posting.get();
+    reporter->flush();
+    EXPECT_NE(worker, std::this_thread::get_id());
+}
+
+TEST(VideoBatteryReporterTest, FlushOrdersClientRemovalAfterReports) {
+    sp<VideoBatteryReporter> reporter = VideoBatteryReporter::getInstance();
+    std::vector<int> events;
+    std::thread::id worker;
+    reporter->post([&] {
+        worker = std::this_thread::get_id();
+        events.push_back(1);  // add
+    });
+    reporter->post([&] {
+        EXPECT_EQ(worker, std::this_thread::get_id());
+        events.push_back(2);  // remove
+    });
+    reporter->post([&] { events.push_back(3); });  // restart
+    reporter->flush();
+    events.push_back(4);  // removeClient, after the barrier
+    EXPECT_EQ(events, (std::vector<int>{1, 2, 3, 4}));
+    EXPECT_EQ(reporter, VideoBatteryReporter::getInstance());
+}
+
+TEST(VideoBatteryReporterTest, PendingReportRetainsItsService) {
+    auto service = std::make_shared<int>(0);
+    std::weak_ptr<int> weak = service;
+    std::promise<void> release;
+    std::shared_future<void> released = release.get_future().share();
+    auto reporter = VideoBatteryReporter::getInstance();
+    reporter->post([released] { released.wait(); });
+    reporter->post([service] { ++*service; });
+    service.reset();
+    EXPECT_FALSE(weak.expired());
+    release.set_value();
+    reporter->flush();
+    EXPECT_TRUE(weak.expired());
+}
