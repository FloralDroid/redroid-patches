diff --git a/prebuilts/api/31.0/private/floral_lxcfs_bind.te b/prebuilts/api/31.0/private/floral_lxcfs_bind.te
index 3291635..0c61b30 100644
--- a/prebuilts/api/31.0/private/floral_lxcfs_bind.te
+++ b/prebuilts/api/31.0/private/floral_lxcfs_bind.te
@@ -1,5 +1,7 @@
 type floral_lxcfs_bind, domain, coredomain;
 type floral_lxcfs_bind_exec, system_file_type, exec_type, file_type;
+type sysfs_floral_dmi, fs_type, sysfs_type;
+type sysfs_floral_node, fs_type, sysfs_type;
 
 # Run the short-lived mount helper in its own init domain.
 init_daemon_domain(floral_lxcfs_bind)
@@ -12,6 +14,11 @@ allow floral_lxcfs_bind self:global_capability_class_set sys_admin;
 allow floral_lxcfs_bind fuse:dir r_dir_perms;
 allow floral_lxcfs_bind fuse:file r_file_perms;
 
+# Resource and identity views are readable like the existing CPU sysfs view.
+# Keep isolated processes within the platform's existing sysfs restrictions.
+r_dir_file({ domain -isolated_app }, sysfs_floral_dmi)
+r_dir_file({ domain -isolated_app }, sysfs_floral_node)
+
 # Avoid stacking duplicate views when init retries the oneshot service.
 allow floral_lxcfs_bind proc_mounts:file r_file_perms;
 
@@ -30,7 +37,12 @@ allow floral_lxcfs_bind {
   proc_uptime
 }:file { getattr mounton };
 allow floral_lxcfs_bind proc:dir { getattr search };
-allow floral_lxcfs_bind sysfs_devices_system_cpu:dir { getattr mounton search };
+allow floral_lxcfs_bind {
+  sysfs_block
+  sysfs_devices_system_cpu
+  sysfs_floral_dmi
+  sysfs_floral_node
+}:dir { getattr mounton search };
 
 # floral_lxcfs_bind uses android::base::KernelLogger during early boot.
 allow floral_lxcfs_bind kmsg_device:chr_file w_file_perms;
diff --git a/prebuilts/api/31.0/private/floral_native_hardware.te b/prebuilts/api/31.0/private/floral_native_hardware.te
new file mode 100644
index 0000000..d46a446
--- /dev/null
+++ b/prebuilts/api/31.0/private/floral_native_hardware.te
@@ -0,0 +1,34 @@
+# Hardware discovery metadata, not hardware control. Native sysfs exports only
+# selected real objects; these rules do not authorize new device nodes or ioctls.
+type sysfs_floral_graphics, fs_type, sysfs_type;
+type sysfs_floral_codec, fs_type, sysfs_type;
+type sysfs_floral_input, fs_type, sysfs_type;
+type sysfs_floral_device_links, fs_type, sysfs_type;
+
+r_dir_file(floral_graphics_probe, sysfs_floral_graphics)
+r_dir_file(floral_graphics_probe, sysfs_floral_device_links)
+
+r_dir_file({ surfaceflinger hal_graphics_allocator hal_graphics_composer hal_codec2_server }, sysfs_floral_graphics)
+# Mesa also performs discovery in application processes. Keep the platform's
+# isolated-process restrictions; this grants metadata reads, not device access.
+r_dir_file({ appdomain -isolated_app -app_zygote }, sysfs_floral_graphics)
+r_dir_file({ appdomain -isolated_app -app_zygote }, sysfs_floral_device_links)
+r_dir_file({ hal_codec2_server hal_camera_server }, sysfs_floral_codec)
+r_dir_file({ system_server inputflinger }, sysfs_floral_input)
+r_dir_file({ surfaceflinger hal_graphics_allocator hal_graphics_composer hal_codec2_server hal_camera_server }, sysfs_floral_device_links)
+
+# init/ueventd must enumerate and label delivered nodes. Only endpoint uevent
+# files are writable in the kernel; hardware parent metadata is read-only.
+r_dir_file({ init ueventd }, sysfs_floral_graphics)
+r_dir_file({ init ueventd }, sysfs_floral_codec)
+r_dir_file({ init ueventd }, sysfs_floral_input)
+r_dir_file({ init ueventd }, sysfs_floral_device_links)
+
+# A private devpts mount has its multiplexor at /dev/pts/ptmx, labelled devpts
+# rather than ptmx_device. Permit only PTY allocation, not arbitrary tty ioctls.
+allow { init adbd } devpts:chr_file ioctl;
+allowxperm { init adbd } devpts:chr_file ioctl { TIOCGPTN TIOCSPTLCK };
+
+# libfuse opens a second FD before FUSE_DEV_IOC_CLONE. Existing platform policy
+# already permits MediaProvider read/write/ioctl on the vold-supplied FUSE FD.
+allow mediaprovider_app fuse_device:chr_file open;
diff --git a/prebuilts/api/31.0/private/genfs_contexts b/prebuilts/api/31.0/private/genfs_contexts
index 13bfb46..2845f26 100644
--- a/prebuilts/api/31.0/private/genfs_contexts
+++ b/prebuilts/api/31.0/private/genfs_contexts
@@ -113,8 +113,23 @@ genfscon cgroup / u:object_r:cgroup:s0
 genfscon cgroup2 / u:object_r:cgroup_v2:s0
 # sysfs labels can be set by userspace.
 genfscon sysfs / u:object_r:sysfs:s0
+# Real SDM845 hardware identity. Do not label the entire SoC as graphics/codec.
+genfscon sysfs /devices/platform/soc@0/ae00000.display-subsystem/ae01000.display-controller u:object_r:sysfs_floral_graphics:s0
+genfscon sysfs /devices/platform/soc@0/aa00000.video-codec u:object_r:sysfs_floral_codec:s0
+genfscon sysfs /devices/platform/soc@0/acb3000.camss u:object_r:sysfs_floral_codec:s0
+genfscon sysfs /class/drm u:object_r:sysfs_floral_graphics:s0
+genfscon sysfs /class/video4linux u:object_r:sysfs_floral_codec:s0
+genfscon sysfs /bus/media u:object_r:sysfs_floral_codec:s0
+genfscon sysfs /dev/char u:object_r:sysfs_floral_device_links:s0
+genfscon sysfs /devices/virtual/lupine/input u:object_r:sysfs_floral_input:s0
+genfscon sysfs /class/input u:object_r:sysfs_floral_input:s0
+genfscon sysfs /devices/virtual/lupine/thermal u:object_r:sysfs_thermal:s0
+genfscon sysfs /devices/virtual/lupine/power_supply u:object_r:sysfs_batteryinfo:s0
+genfscon sysfs /devices/virtual/lupine/dma_heap u:object_r:sysfs_dma_heap:s0
+genfscon sysfs /block                             u:object_r:sysfs_block:s0
 genfscon sysfs /devices/cs_etm                    u:object_r:sysfs_devices_cs_etm:s0
 genfscon sysfs /devices/system/cpu u:object_r:sysfs_devices_system_cpu:s0
+genfscon sysfs /devices/system/node u:object_r:sysfs_floral_node:s0
 genfscon sysfs /class/android_usb                 u:object_r:sysfs_android_usb:s0
 genfscon sysfs /class/extcon                      u:object_r:sysfs_extcon:s0
 genfscon sysfs /class/block                       u:object_r:sysfs_block:s0
@@ -129,6 +144,7 @@ genfscon sysfs /class/switch                      u:object_r:sysfs_switch:s0
 genfscon sysfs /class/wakeup                      u:object_r:sysfs_wakeup:s0
 genfscon sysfs /devices/platform/nfc-power/nfc_power u:object_r:sysfs_nfc_power_writable:s0
 genfscon sysfs /devices/virtual/android_usb     u:object_r:sysfs_android_usb:s0
+genfscon sysfs /devices/virtual/dmi/id          u:object_r:sysfs_floral_dmi:s0
 genfscon sysfs /devices/virtual/block/            u:object_r:sysfs_devices_block:s0
 genfscon sysfs /devices/virtual/block/dm-       u:object_r:sysfs_dm:s0
 genfscon sysfs /devices/virtual/block/loop       u:object_r:sysfs_loop:s0
diff --git a/prebuilts/api/31.0/private/property_contexts b/prebuilts/api/31.0/private/property_contexts
index da02897..16cd8b7 100644
--- a/prebuilts/api/31.0/private/property_contexts
+++ b/prebuilts/api/31.0/private/property_contexts
@@ -1,3 +1,6 @@
+# Existing libc compatibility switch, fixed at boot by the launcher.
+ro.floral.libc.procview u:object_r:exported_default_prop:s0 exact bool
+
 ##########################
 # property service keys
 #
diff --git a/prebuilts/api/31.0/public/floral_native_hardware.te b/prebuilts/api/31.0/public/floral_native_hardware.te
new file mode 100644
index 0000000..6d56016
--- /dev/null
+++ b/prebuilts/api/31.0/public/floral_native_hardware.te
@@ -0,0 +1,4 @@
+# Vendor init probes can read selected DRM identity without acquiring a graphics
+# HAL role or permission to open GPU device nodes.
+attribute floral_graphics_probe;
+expandattribute floral_graphics_probe false;
