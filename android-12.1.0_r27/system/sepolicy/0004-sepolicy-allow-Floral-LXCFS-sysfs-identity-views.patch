 .../31.0/private/floral_native_hardware.te    | 34 +++++++++++++++++++
 prebuilts/api/31.0/private/genfs_contexts     | 16 +++++++++
 prebuilts/api/31.0/private/property_contexts  |  3 ++
 .../api/31.0/public/floral_native_hardware.te |  4 +++
 .../api/32.0/private/floral_lxcfs_bind.te     | 14 +++++++-
 .../32.0/private/floral_native_hardware.te    | 34 +++++++++++++++++++
 prebuilts/api/32.0/private/genfs_contexts     | 16 +++++++++
 prebuilts/api/32.0/private/property_contexts  |  3 ++
 .../api/32.0/public/floral_native_hardware.te |  4 +++
 private/floral_lxcfs_bind.te                  | 14 +++++++-
 private/floral_native_hardware.te             | 34 +++++++++++++++++++
 private/genfs_contexts                        | 16 +++++++++
 private/property_contexts                     |  3 ++
 public/floral_native_hardware.te              |  4 +++
 15 files changed, 210 insertions(+), 3 deletions(-)
 create mode 100644 prebuilts/api/31.0/private/floral_native_hardware.te
 create mode 100644 prebuilts/api/31.0/public/floral_native_hardware.te
 create mode 100644 prebuilts/api/32.0/private/floral_native_hardware.te
