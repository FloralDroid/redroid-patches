diff --git a/prebuilts/api/31.0/public/installd.te b/prebuilts/api/31.0/public/installd.te
index 08060e30d309f2eb33e52fd52abbed6ab7a2932a..fe78e34916ea6b773952120e364ae578625711fe 100644
