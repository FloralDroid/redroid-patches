 tmpfs_domain(zygote)
 
+# Authenticate waiting descendants before creating their process cgroup.
+allow zygote { app_zygote webview_zygote }:dir { getattr search };
+allow zygote { app_zygote webview_zygote }:file { getattr open read };
+allow zygote { app_zygote webview_zygote }:process getattr;
+
 read_runtime_log_tags(zygote)
 
