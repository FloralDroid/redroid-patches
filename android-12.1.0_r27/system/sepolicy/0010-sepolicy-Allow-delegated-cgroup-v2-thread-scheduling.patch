 prebuilts/api/32.0/private/webview_zygote.te  | 7 +++++++
 prebuilts/api/32.0/private/zygote.te          | 5 +++++
 prebuilts/api/32.0/public/file.te             | 2 +-
 prebuilts/api/32.0/public/installd.te         | 3 +++
 private/app.te                                | 4 ++++
 private/app_neverallows.te                    | 3 ++-
 private/app_zygote.te                         | 7 +++++++
