 # a domain macro.
 tmpfs_domain(webview_zygote);
 
+# One-shot gate for system_server to finish the child cgroup.
+allow webview_zygote self:fifo_file create;
+
+# Set child scheduling groups before transitioning to isolated_app.
+allow webview_zygote cgroup_v2:dir { getattr search };
+allow webview_zygote cgroup_v2:file { getattr open read write };
+
 userfaultfd_use(webview_zygote)
 
 # Allow reading/executing installed binaries to enable preloading the
diff --git a/prebuilts/api/31.0/private/zygote.te b/prebuilts/api/31.0/private/zygote.te
index 090e1214221363e2329eab22512e093e58abc141..d8cc44ea4de7f50da1018a11ce7bf223a2a5af3d 100644
--- a/prebuilts/api/31.0/private/zygote.te
+++ b/prebuilts/api/31.0/private/zygote.te
@@ -5,6 +5,11 @@ typeattribute zygote mlstrustedsubject;
