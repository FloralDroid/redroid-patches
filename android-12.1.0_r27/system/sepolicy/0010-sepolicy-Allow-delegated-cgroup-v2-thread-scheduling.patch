+++ b/prebuilts/api/31.0/private/system_server.te
@@ -12,6 +12,10 @@ typeattribute system_server stats_service_server;
 # Define a type for tmpfs-backed ashmem regions.
 tmpfs_domain(system_server)
 
+# Release non-root zygote children only after cgroup delegation.
+allow system_server { webview_zygote app_zygote }:fd use;
+allow system_server { webview_zygote app_zygote }:fifo_file write;
+
 userfaultfd_use(system_server)
 
 # Create a socket for connections from crash_dump.
diff --git a/prebuilts/api/31.0/private/webview_zygote.te b/prebuilts/api/31.0/private/webview_zygote.te
index 3473ecaee77923e5080c2b4e8b176b97fcf4ce31..d04bfb46123a88076ea520eed4e7db59fc7704b8 100644
--- a/prebuilts/api/31.0/private/webview_zygote.te
+++ b/prebuilts/api/31.0/private/webview_zygote.te
