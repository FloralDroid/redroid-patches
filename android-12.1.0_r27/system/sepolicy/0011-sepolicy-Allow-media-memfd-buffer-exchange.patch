 # mediaextractor - multimedia daemon
 type mediaextractor, domain;
 type mediaextractor_exec, system_file_type, exec_type, file_type;
-type mediaextractor_tmpfs, file_type;
+# Shared memfd buffers retain the cross-category ashmem contract.
+type mediaextractor_tmpfs, file_type, mlstrustedobject;
 
 typeattribute mediaextractor mlstrustedsubject;
 
