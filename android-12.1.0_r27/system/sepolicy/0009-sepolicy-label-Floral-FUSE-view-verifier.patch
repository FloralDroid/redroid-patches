@@ -0,0 +1,40 @@
+# Copyright 2026 FloralDroid
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#      http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# Read-only revalidation helper. Data mounts in Lupine are supplied by the host;
+# legacy LXCFS mounts run as an init builtin, not a new privileged service domain.
+type floral_fuse, domain, coredomain;
+type floral_fuse_exec, exec_type, system_file_type, file_type;
+type floral_fuse_staging_file, file_type;
+init_daemon_domain(floral_fuse)
+
+get_prop(floral_fuse, bootloader_prop)
+allow floral_fuse rootfs:dir search;
+allow floral_fuse kmsg_device:chr_file { open write };
+allow { init floral_fuse } floral_fuse_staging_file:dir r_dir_perms;
+allow { init floral_fuse } floral_fuse_staging_file:file r_file_perms;
+allow { init floral_fuse } fuse:filesystem getattr;
+allow { init floral_fuse } sysfs:dir r_dir_perms;
+allow { init floral_fuse } {
+    proc_mounts proc_cpuinfo proc_meminfo proc_stat proc_swaps proc_uptime proc_loadavg
+    proc_slabinfo proc_zoneinfo proc_vmstat proc_buddyinfo proc_version
+    proc_diskstats proc_interrupts proc_pressure_cpu proc_pressure_io proc_pressure_mem
+}:file r_file_perms;
+allow floral_fuse proc:dir r_dir_perms;
+allow floral_fuse selinuxfs:dir search;
+allow floral_fuse selinuxfs:file r_file_perms;
+allow floral_fuse kernel:security read_policy;
+
+# No mount/sys_admin, policy-management or property-setting permission is added
+# to this domain. Existing trusted Android mount domains are unchanged.
