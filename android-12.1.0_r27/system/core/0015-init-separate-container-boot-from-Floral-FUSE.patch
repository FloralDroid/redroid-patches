diff --git a/init/floral_policy.cpp b/init/floral_policy.cpp
new file mode 100644
index 0000000..c0d20fd
--- /dev/null
+++ b/init/floral_policy.cpp
@@ -0,0 +1,196 @@
+/*
+ * Copyright 2026 FloralDroid
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "floral_policy.h"
+
+#include <android-base/unique_fd.h>
+#include <fcntl.h>
+#include <selinux/selinux.h>
+#include <sepol/policydb/policydb.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <memory>
+#include <set>
+#include <string_view>
+
+namespace floral::selinux {
+namespace {
+
+bool Fail(const std::string& reason, std::string* error) {
+    *error = reason;
+    return false;
+}
+
+bool PolicyImage(std::string* image, std::string* error) {
+    android::base::unique_fd fd(open("/sys/fs/selinux/policy", O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+    if (!fd.ok()) return Fail("cannot open instance SELinux policy: " + std::string(strerror(errno)), error);
+    image->clear();
+    char data[16384];
+    for (;;) {
+        const auto size = read(fd.get(), data, sizeof(data));
+        if (size < 0 && errno == EINTR) continue;
+        if (size < 0) return Fail("cannot read instance SELinux policy: " + std::string(strerror(errno)), error);
+        if (size == 0) return !image->empty() || Fail("empty SELinux policy", error);
+        if (image->size() + static_cast<size_t>(size) > 64 * 1024 * 1024) {
+            return Fail("SELinux policy exceeds inspection limit", error);
+        }
+        image->append(data, static_cast<size_t>(size));
+    }
+}
+
+bool HasAttribute(policydb_t& policy, uint32_t type, const char* attribute) {
+    const auto* attr = static_cast<type_datum_t*>(hashtab_search(policy.p_types.table, attribute));
+    return attr && policy.type_attr_map &&
+           ebitmap_get_bit(&policy.type_attr_map[type - 1], attr->s.value - 1);
+}
+
+bool Matches(policydb_t& policy, uint32_t concrete, uint32_t key) {
+    return concrete == key || (policy.type_attr_map &&
+           ebitmap_get_bit(&policy.type_attr_map[concrete - 1], key - 1));
+}
+
+uint32_t Permission(class_datum_t& cls, const char* name) {
+    auto* permission = static_cast<perm_datum_t*>(hashtab_search(cls.permissions.table, name));
+    if (!permission && cls.comdatum) {
+        permission = static_cast<perm_datum_t*>(hashtab_search(cls.comdatum->permissions.table, name));
+    }
+    if (!permission || permission->s.value == 0 || permission->s.value > 32) return 0;
+    return uint32_t{1} << (permission->s.value - 1);
+}
+
+bool ExpandControlledDomains(policydb_t& policy, std::set<uint32_t>* users, std::string* error) {
+    size_t previous;
+    do {
+        previous = users->size();
+        for (const auto* table : {&policy.te_avtab, &policy.te_cond_avtab}) {
+            for (uint32_t bucket = 0; bucket < table->nslot; ++bucket) {
+                for (auto* rule = table->htable[bucket]; rule; rule = rule->next) {
+                    if (!(rule->key.specified & AVTAB_ALLOWED)) continue;
+                    const auto cls_id = rule->key.target_class;
+                    if (!cls_id || cls_id > policy.p_classes.nprim) {
+                        return Fail("invalid SELinux class", error);
+                    }
+                    if (std::string_view(policy.p_class_val_to_name[cls_id - 1]) != "process") continue;
+                    auto& cls = *policy.class_val_to_struct[cls_id - 1];
+                    const auto control = Permission(cls, "ptrace") | Permission(cls, "dyntransition");
+                    if (!(rule->datum.data & control) ||
+                        !std::any_of(users->begin(), users->end(), [&](uint32_t source) {
+                            return Matches(policy, source, rule->key.source_type);
+                        })) continue;
+                    for (uint32_t target = 1; target <= policy.p_types.nprim; ++target) {
+                        const auto* datum = policy.type_val_to_struct[target - 1];
+                        if (datum && datum->flavor == TYPE_TYPE &&
+                            HasAttribute(policy, target, "domain") &&
+                            Matches(policy, target, rule->key.target_type)) users->insert(target);
+                    }
+                }
+            }
+        }
+    } while (users->size() != previous);
+    return true;
+}
+
+bool AuditTable(policydb_t& policy, const avtab_t& table,
+                const std::set<uint32_t>& users, std::string* error) {
+    for (uint32_t bucket = 0; bucket < table.nslot; ++bucket) {
+        for (auto* rule = table.htable[bucket]; rule; rule = rule->next) {
+            if (!(rule->key.specified & AVTAB_ALLOWED)) continue;
+            const auto cls_id = rule->key.target_class;
+            if (!cls_id || cls_id > policy.p_classes.nprim) return Fail("invalid SELinux class", error);
+            auto& cls = *policy.class_val_to_struct[cls_id - 1];
+            const std::string_view cls_name = policy.p_class_val_to_name[cls_id - 1];
+            uint32_t denied = 0;
+            if (cls_name == "filesystem") {
+                for (const auto* perm : {"mount", "remount", "unmount", "relabelfrom", "relabelto"}) {
+                    denied |= Permission(cls, perm);
+                }
+            } else if (cls_name == "file" || cls_name == "dir") {
+                denied = Permission(cls, "mounton");
+            } else if (cls_name == "capability") {
+                denied = Permission(cls, "sys_admin") | Permission(cls, "sys_module");
+            } else if (cls_name == "security") {
+                for (const auto* perm : {"load_policy", "setenforce", "setbool", "setsecparam"}) {
+                    denied |= Permission(cls, perm);
+                }
+            }
+            for (const auto source : users) {
+                if (!Matches(policy, source, rule->key.source_type)) continue;
+                if (rule->datum.data & denied) {
+                    return Fail(std::string("user domain can manage mounts/policy: ") +
+                                policy.p_type_val_to_name[source - 1] + ":" + std::string(cls_name), error);
+                }
+            }
+        }
+    }
+    return true;
+}
+
+bool AuditUserPolicy(policydb_t& policy, std::string* error) {
+    std::set<uint32_t> users;
+    if (!hashtab_search(policy.p_types.table, "appdomain") ||
+        !hashtab_search(policy.p_types.table, "domain")) return Fail("missing Android domain attributes", error);
+    if (ebitmap_get_bit(&policy.permissive_map, 0)) return Fail("global permissive policy exception", error);
+    for (uint32_t type = 1; type <= policy.p_types.nprim; ++type) {
+        const auto* datum = policy.type_val_to_struct[type - 1];
+        if (!datum || datum->flavor != TYPE_TYPE) continue;
+        const std::string_view name = policy.p_type_val_to_name[type - 1];
+        if (HasAttribute(policy, type, "appdomain") || name == "shell" || name == "su" ||
+            name == "runas_app" || name == "app_zygote") {
+            if (ebitmap_get_bit(&policy.permissive_map, type)) {
+                return Fail("permissive user domain: " + std::string(name), error);
+            }
+            users.insert(type);
+        }
+    }
+    if (users.empty()) return Fail("no user domains found in SELinux policy", error);
+    // Ptrace and dynamic transitions give control over another domain. Ordinary
+    // exec transitions retain the target program's entrypoint and Android policy.
+    if (!ExpandControlledDomains(policy, &users, error)) return false;
+    for (const auto type : users) {
+        if (ebitmap_get_bit(&policy.permissive_map, type)) {
+            return Fail("permissive controlled domain: " +
+                        std::string(policy.p_type_val_to_name[type - 1]), error);
+        }
+    }
+    // Also reject dormant conditional grants, rather than treating today's boolean
+    // value as a durable security boundary. No policy is rewritten by this check.
+    return AuditTable(policy, policy.te_avtab, users, error) &&
+           AuditTable(policy, policy.te_cond_avtab, users, error);
+}
+
+}  // namespace
+
+bool VerifyEnforcingPolicy(std::string* error) {
+    if (security_getenforce() != 1) return Fail("requested Enforcing is not active", error);
+    std::string image;
+    if (!PolicyImage(&image, error)) return false;
+    policydb_t policy = {};
+    if (policydb_init(&policy) != 0) return Fail("cannot initialize SELinux policy inspector", error);
+    if (policydb_from_image(nullptr, image.data(), image.size(), &policy) != 0) {
+        return Fail("cannot decode loaded SELinux policy", error);
+    }
+    const auto destroy = [](policydb_t* value) { policydb_destroy(value); };
+    std::unique_ptr<policydb_t, decltype(destroy)> cleanup(&policy, destroy);
+    if (!AuditUserPolicy(policy, error)) return false;
+    std::string after;
+    if (!PolicyImage(&after, error)) return false;
+    return (image == after && security_getenforce() == 1) ||
+           Fail("SELinux policy/enforcement changed during inspection", error);
+}
+
+}  // namespace floral::selinux
