+#include "floral_policy.h"
+
+#include <cstdio>
+
+int main(int argc, char**) {
+    if (argc != 1) return 1;
+    std::string error;
+    if (!floral::selinux::VerifyEnforcingPolicy(&error)) {
+        fprintf(stderr, "%s\n", error.c_str());
+        return 2;
+    }
+    return 0;
