+
+#include "floral_boot.h"
+#include "selinux.h"
+
+#include <android-base/logging.h>
+#include <linux/magic.h>
+#include <selinux/selinux.h>
+#include <sys/mount.h>
+#include <sys/vfs.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace android::init {
+namespace {
+bool initialized = false;
+bool container = false;
+std::string selinux_mode;
+std::vector<std::string> original_arguments;
+::floral::fuse::BootConfig fuse_config;
+}  // namespace
+
+[[noreturn]] void FailFloralBoot(const std::string& error) {
+    LOG(ERROR) << "Floral boot: " << error;
+    dprintf(STDERR_FILENO, "Floral boot: %s\n", error.c_str());
+    _exit(1);
+}
+
+void InitializeFloralBoot(int argc, char** argv) {
+    if (initialized) return;
+    for (int i = 1; i < argc; ++i) {
+        if (i == 1 && (!strcmp(argv[i], "selinux_setup") ||
+                       !strcmp(argv[i], "second_stage"))) continue;
+        original_arguments.emplace_back(argv[i]);
+        const auto& argument = original_arguments.back();
+        const auto equal = argument.find('=');
+        if (equal == std::string::npos) continue;
+        const auto key = argument.substr(0, equal);
+        const auto value = argument.substr(equal + 1);
+        if (key == "androidboot.lupine") {
+            container = value == "1";
+        } else if (key == "androidboot.selinux") {
+            selinux_mode = value;
+        } else if (key == "androidboot.floral_fuse") {
+            fuse_config.mode = value == "lxcfs" ? ::floral::fuse::Mode::Lxcfs
+                                               : ::floral::fuse::Mode::None;
+            fuse_config.explicit_mode = true;
+        }
+    }
+
+    if (!container) {
+        std::string error;
+        if (!::floral::fuse::ResolveBootMode(&fuse_config, &error)) FailFloralBoot(error);
+    }
+    initialized = true;
+}
+
+bool IsLupineContainer() { return container; }
+const std::string& LupineSELinuxMode() { return selinux_mode; }
+const ::floral::fuse::BootConfig& FloralFuseConfig() { return fuse_config; }
+
+std::vector<std::string> FloralBootArguments() {
+    std::vector<std::string> result = {container ? "androidboot.lupine=1" : "androidboot.lupine=0"};
+    if (container) result.push_back("androidboot.selinux=" + selinux_mode);
+    else result.push_back(std::string("androidboot.floral_fuse=") +
+                          ::floral::fuse::ModeName(fuse_config.mode));
+    return result;
+}
+
+std::vector<std::string> FloralStageArguments(const char* stage) {
+    std::vector<std::string> result = {"/system/bin/init", stage};
+    result.insert(result.end(), original_arguments.begin(), original_arguments.end());
+    return result;
+}
+
+void CheckLupineSELinuxStage(bool loading_policy) {
+    if (!container) return;
+    struct statfs fs = {};
+    if (statfs("/sys/fs/selinux", &fs) != 0) {
+        if (selinux_mode == "disabled" && !loading_policy && errno == ENOENT) return;
+        FailFloralBoot("missing SELinux control directory");
+    }
+    if (selinux_mode == "disabled") {
+        if (loading_policy || fs.f_type == SELINUX_MAGIC) FailFloralBoot("disabled instance has selinuxfs");
+        return;
+    }
+    if (fs.f_type != SELINUX_MAGIC || is_selinux_enabled() <= 0) {
+        FailFloralBoot("host did not prepare private selinuxfs");
+    }
+    if (!loading_policy && (getenv(kEnvSelinuxStartedAt) == nullptr ||
+            security_getenforce() != (selinux_mode == "enforcing" ? 1 : 0))) {
+        FailFloralBoot("requested SELinux setup did not complete");
+    }
+}
+
+void PrivatizeLupineControls() {
+    if (!container) return;
+    for (const auto* path : {"/proc", "/sys"}) {
+        if (mount(nullptr, path, nullptr, MS_PRIVATE | MS_REC, nullptr) != 0) {
+            FailFloralBoot(std::string("private control mounts: ") + path + ": " + strerror(errno));
+        }
+    }
+}
+
+}  // namespace android::init
