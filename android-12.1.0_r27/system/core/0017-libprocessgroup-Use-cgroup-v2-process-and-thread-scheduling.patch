diff --git a/libprocessgroup/profiles/test.cpp b/libprocessgroup/profiles/test.cpp
index b37e3e625998faa52ddf135ab5782b1079982713..7695063523ef82f78a2858e193391edb44cd855b 100644
--- a/libprocessgroup/profiles/test.cpp
+++ b/libprocessgroup/profiles/test.cpp
@@ -43,6 +43,40 @@ INSTANTIATE_TEST_SUITE_P(Cgroups, CgroupsTest,
 INSTANTIATE_TEST_SUITE_P(TaskProfiles, TaskProfilesTest,
                          ::testing::Values(MakeTestParam<TaskProfiles>("/task_profiles.json")));
 
+TEST(TaskProfilesConfigTest, TopAppUsesCpuPerformanceProfile) {
+    std::string json;
+    ASSERT_TRUE(android::base::ReadFileToString(GetExecutableDirectory() + "/task_profiles.json",
+                                                &json));
+    auto parsed = jsonpb::JsonStringToMessage<TaskProfiles>(json);
+    ASSERT_TRUE(parsed.ok()) << parsed.error();
+    const TaskProfiles& task_profiles = *parsed;
+
+    const Attribute* cpu_weight = nullptr;
+    const Attribute* uclamp_min = nullptr;
+    for (const auto& attribute : task_profiles.attributes()) {
+        if (attribute.name() == "CpuWeight") cpu_weight = &attribute;
+        if (attribute.name() == "UClampMin") uclamp_min = &attribute;
+    }
+
+    ASSERT_NE(cpu_weight, nullptr);
+    EXPECT_EQ(cpu_weight->controller(), "cpu");
+    EXPECT_EQ(cpu_weight->file(), "cpu.weight");
+    ASSERT_NE(uclamp_min, nullptr);
+    EXPECT_EQ(uclamp_min->controller(), "cpu");
+    EXPECT_EQ(uclamp_min->file(), "cpu.uclamp.min");
+
+    const AggregateProfiles* top_app = nullptr;
+    for (const auto& profile : task_profiles.aggregateprofiles()) {
+        if (profile.name() == "CPUSET_SP_TOP_APP") {
+            top_app = &profile;
+            break;
+        }
+    }
+
+    ASSERT_NE(top_app, nullptr);
