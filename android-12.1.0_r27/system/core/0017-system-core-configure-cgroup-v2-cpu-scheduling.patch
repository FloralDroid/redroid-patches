+bool CgroupController::GetTaskDomain(int tid, std::string* domain) const {
+    std::string group;
+    if (!GetTaskGroup(tid, &group)) return false;
+
+    for (;;) {
+        const std::string current = std::string(path()) + "/" + group;
+        std::string type;
+        if (!android::base::ReadFileToString(current + "/cgroup.type", &type)) return false;
+        type = android::base::Trim(type);
+        if (type == "domain" || type == "domain threaded") {
+            unsigned int uid, pid;
+            int consumed = 0;
+            if (group != "init" &&
+                (sscanf(group.c_str(), "apps/uid_%u/pid_%u%n", &uid, &pid, &consumed) != 2 ||
+                 consumed != static_cast<int>(group.size()) || pid == 0)) {
+                errno = EPERM;
+                return false;
+            }
+            *domain = current;
+            return true;
+        }
+        if (type != "threaded" || group.empty()) {
+            errno = EINVAL;
+            return false;
+        }
+        const auto slash = group.rfind('/');
+        group = slash == std::string::npos ? "" : group.substr(0, slash);
+    }
+}
