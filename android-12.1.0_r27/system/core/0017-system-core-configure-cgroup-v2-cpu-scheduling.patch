+static int RemoveCgroupTree(const std::string& path) {
+    std::string events;
+    if (!android::base::ReadFileToString(path + "/cgroup.events", &events)) {
+        return errno == ENOENT ? 0 : -1;
+    }
+    // Do not dismantle empty scheduling leaves of a live process domain.
+    if (events.find("populated 1\n") != std::string::npos) {
+        errno = EBUSY;
+        return -1;
+    }
+    std::unique_ptr<DIR, decltype(&closedir)> dir(opendir(path.c_str()), closedir);
+    if (!dir) return errno == ENOENT ? 0 : -1;
+    while (auto* entry = readdir(dir.get())) {
+        if (entry->d_type != DT_DIR || !strcmp(entry->d_name, ".") ||
+            !strcmp(entry->d_name, "..")) continue;
+        if (RemoveCgroupTree(path + "/" + entry->d_name) != 0) return -1;
+    }
+    return rmdir(path.c_str());
+}
