diff --git a/init/floral_ipc_mount_test.cpp b/init/floral_ipc_mount_test.cpp
index ace4708..7a6ea28 100644
--- a/init/floral_ipc_mount_test.cpp
+++ b/init/floral_ipc_mount_test.cpp
@@ -22,9 +22,9 @@ namespace android::init::floral {
 
 static bool Check(const std::string& records, bool require_private = false) {
     std::istringstream input(records);
-    unsigned int id = 0;
+    IpcMounts mounts;
     std::string error;
-    return CheckIpcMount(input, require_private, &id, &error);
+    return CheckIpcMount(input, require_private, &mounts, &error);
 }
 
 static std::string Record(const std::string& options = "rw,nosuid,nodev,noexec",
@@ -55,4 +55,34 @@ TEST(FloralIpcMount, RejectsUnsafeOrMissingMounts) {
     EXPECT_FALSE(Check("42 1 0:23 / /ipc/floral_stream rw,nosuid,nodev,noexec shared:1\n"));
 }
 
+static std::string HalRecord(const std::string& name = "device.prop",
+                             const std::string& options = "ro,nosuid,nodev,noexec",
+                             const std::string& optional = "", unsigned int parent = 42) {
+    return "43 " + std::to_string(parent) + " 0:23 /profile /ipc/floral_stream/" + name + " " +
+           options + " " + optional + "- ext4 /dev/loop0 rw\n";
+}
+
+TEST(FloralIpcMount, AcceptsOnlyNamedReadOnlyHalMounts) {
+    for (const auto* name : {"device.prop", "radio.json", "wifi.json"}) {
+        EXPECT_TRUE(Check(Record() + HalRecord(name)));
+        EXPECT_TRUE(Check(HalRecord(name) + Record()));
+        EXPECT_TRUE(Check(Record("rw,nosuid,nodev,noexec", "") + HalRecord(name), true));
+    }
+    EXPECT_FALSE(Check(Record() + HalRecord("other.json")));
+    EXPECT_FALSE(Check(Record() + HalRecord("device.prop/child")));
+    EXPECT_FALSE(Check(Record() + HalRecord() + HalRecord()));
+    EXPECT_FALSE(Check(Record() + HalRecord("device.prop", "ro,nosuid,nodev,noexec", "", 1)));
+    EXPECT_FALSE(Check(Record() + HalRecord("device.prop", "ro,nosuid,nodev,noexec", "", 0)));
+    for (const auto* flags : {"rw,nosuid,nodev,noexec", "ro,nodev,noexec", "ro,nosuid,noexec",
+                              "ro,nosuid,nodev", "rw,ro,nosuid,nodev,noexec"}) {
+        EXPECT_FALSE(Check(Record() + HalRecord("device.prop", flags)));
+    }
+    EXPECT_TRUE(Check(Record() + HalRecord("device.prop", "ro,nosuid,nodev,noexec", "shared:2 ")));
+    EXPECT_FALSE(Check(Record("rw,nosuid,nodev,noexec", "") +
+                               HalRecord("device.prop", "ro,nosuid,nodev,noexec", "shared:2 "), true));
+    for (const auto* optional : {"master:1 ", "shared:1 master:2 ", "unbindable "}) {
+        EXPECT_FALSE(Check(Record() + HalRecord("device.prop", "ro,nosuid,nodev,noexec", optional)));
+    }
+}
+
 }  // namespace android::init::floral
