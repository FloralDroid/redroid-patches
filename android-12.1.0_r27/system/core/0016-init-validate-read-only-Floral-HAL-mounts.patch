+inline bool CheckIpcFdMount(int fd, unsigned int expected, std::string* error) {
+    std::ifstream fdinfo("/proc/self/fdinfo/" + std::to_string(fd));
+    std::string line;
+    unsigned int id = 0;
+    while (std::getline(fdinfo, line)) {
+        std::istringstream fields(line);
+        std::string key;
+        if ((fields >> key) && key == "mnt_id:") {
+            if (!(fields >> id)) return IpcError(error, "invalid Floral IPC fdinfo");
+            break;
+        }
+    }
+    return (id != 0 && id == expected) || IpcError(error, "Floral IPC mount identity changed");
 }
 
