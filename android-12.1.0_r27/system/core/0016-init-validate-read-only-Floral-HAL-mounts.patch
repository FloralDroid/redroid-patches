Date: Mon, 2 Nov 2026 02:53:32 +0800
Subject: [PATCH] init: validate and label read-only Floral HAL submounts

---
 init/builtins.cpp              |  39 ++++++++++
 init/floral_boot.cpp           |   6 ++
 init/floral_hal_labels.h       | 124 +++++++++++++++++++++++++++++
 init/floral_ipc_mount.h        | 138 +++++++++++++++++++++++++--------
 init/floral_ipc_mount_test.cpp |  34 +++++++-
 init/selinux.cpp               |  21 ++++-
 6 files changed, 326 insertions(+), 36 deletions(-)
 create mode 100644 init/floral_hal_labels.h

diff --git a/init/builtins.cpp b/init/builtins.cpp
index e466e28..aa71b91 100644
--- a/init/builtins.cpp
+++ b/init/builtins.cpp
@@ -36,6 +36,7 @@
 #include <sys/resource.h>
 #include <sys/socket.h>
 #include <sys/stat.h>
+#include <sys/statvfs.h>
 #include <sys/syscall.h>
 #include <sys/system_properties.h>
 #include <sys/time.h>
@@ -1024,6 +1025,26 @@ static Result<void> do_copy_per_line(const BuiltinArguments& args) {
     return {};
 }
 
+static bool IsImmutableFloralHALFile(const std::string& path) {
+    return IsLupineContainer() && (path == "/ipc/floral_stream/device.prop" ||
+                                  path == "/ipc/floral_stream/radio.json" ||
+                                  path == "/ipc/floral_stream/wifi.json");
+}
+
+static Result<struct stat> InspectImmutableFloralHAL(const std::string& path) {
+    android::base::unique_fd fd(open(path.c_str(), O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC));
+    if (!fd.ok()) return ErrnoErrorIgnoreEnoent() << "open HAL profile";
+    struct stat status = {};
+    struct statvfs fs = {};
+    if (fstat(fd.get(), &status) != 0 || fstatvfs(fd.get(), &fs) != 0) {
+        return ErrnoError() << "inspect HAL profile";
+    }
+    if (!S_ISREG(status.st_mode) || !(fs.f_flag & ST_RDONLY)) {
+        return Error() << "HAL profile is not an immutable regular file";
+    }
+    return status;
+}
+
 static Result<void> do_chown(const BuiltinArguments& args) {
     auto uid = DecodeUid(args[1]);
     if (!uid.ok()) {
@@ -1041,6 +1062,16 @@ static Result<void> do_chown(const BuiltinArguments& args) {
         }
     }
 
+    if (IsImmutableFloralHALFile(path)) {
+        auto status = InspectImmutableFloralHAL(path);
+        if (!status.ok()) return status.error();
+        if (status->st_uid != *uid ||
+            (*gid != static_cast<gid_t>(-1) && status->st_gid != *gid)) {
+            return Error() << "immutable HAL profile owner mismatch";
+        }
+        return {};
+    }
+
     if (lchown(path.c_str(), *uid, *gid) == -1) {
         return ErrnoErrorIgnoreEnoent() << "lchown() failed";
     }
@@ -1063,6 +1094,14 @@ static mode_t get_mode(const char *s) {
 
 static Result<void> do_chmod(const BuiltinArguments& args) {
     mode_t mode = get_mode(args[1].c_str());
+    if (IsImmutableFloralHALFile(args[2])) {
+        auto status = InspectImmutableFloralHAL(args[2]);
+        if (!status.ok()) return status.error();
+        if ((status->st_mode & 07777) != mode) {
+            return Error() << "immutable HAL profile mode mismatch";
+        }
+        return {};
+    }
     if (fchmodat(AT_FDCWD, args[2].c_str(), mode, AT_SYMLINK_NOFOLLOW) < 0) {
         return ErrnoErrorIgnoreEnoent() << "fchmodat() failed";
     }
diff --git a/init/floral_boot.cpp b/init/floral_boot.cpp
index 64b4096..0d5c7fc 100644
--- a/init/floral_boot.cpp
+++ b/init/floral_boot.cpp
@@ -105,6 +105,12 @@ std::vector<std::string> FloralBootArguments() {
 std::vector<std::string> FloralStageArguments(const char* stage) {
     std::vector<std::string> result = {"/system/bin/init", stage};
     for (const auto& argument : original_arguments) {
+        // Preserve the existing libc switch through selinux_setup -> second_stage.
+        // It is imported as ro.*, not translated through androidboot.*.
+        if (argument == "ro.floral.libc.procview=0" || argument == "ro.floral.libc.procview=1") {
+            result.push_back(argument);
+            continue;
+        }
         if (argument.compare(0, 12, "androidboot.") != 0) continue;
         if (frozen.count(argument.substr(0, argument.find('=')))) continue;
         result.push_back(argument);
diff --git a/init/floral_hal_labels.h b/init/floral_hal_labels.h
new file mode 100644
index 0000000..ded8da2
--- /dev/null
+++ b/init/floral_hal_labels.h
@@ -0,0 +1,124 @@
+/* Copyright 2026 FloralDroid
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <fcntl.h>
+#include <stdlib.h>
+#include <linux/magic.h>
+#include <sys/mount.h>
+#include <sys/vfs.h>
+#include <sys/statvfs.h>
+#include <unistd.h>
+
+#include <selinux/selinux.h>
+
+#include "floral_ipc_mount.h"
+
+namespace android::init::floral {
+
+// Run only after policy load and before enforcement or any HAL is started.
+// tmpfs uses fs_use_trans, not xattr initialization: a host xattr alone cannot
+// initialize the SID interpreted by the Android SELinux namespace.
+inline bool LabelImmutableHalFiles(std::string* error) {
+    if (!KeepIpcMountPrivate(error)) return false;
+    IpcMounts mounts;
+    // Absence of IPC is supported; do not create an implicit transport.
+    int parent = open("/ipc", O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    if (parent < 0) return errno == ENOENT || IpcError(error, "cannot inspect IPC parent");
+    int leaf = openat(parent, "floral_stream", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    int saved = errno;
+    close(parent);
+    if (leaf < 0) return saved == ENOENT || IpcError(error, "cannot inspect IPC leaf");
+    struct Fd {
+        int fd;
+        ~Fd() { if (fd >= 0) close(fd); }
+    } close_leaf{leaf};
+    if (!CheckIpcMountFile(true, &mounts, error) ||
+        !CheckIpcFdMount(leaf, mounts.leaf, error)) return false;
+    struct stat leaf_status{};
+    if (fstat(leaf, &leaf_status) != 0) return IpcError(error, "cannot inspect IPC inode");
+    constexpr const char* context = "u:object_r:floral_stream_file:s0";
+    if (fsetfilecon(leaf, context) != 0) return IpcError(error, "cannot label IPC directory");
+
+    for (size_t i = 0; i < kIpcHalFiles.size(); ++i) {
+        const auto& spec = kIpcHalFiles[i];
+        const char* context = std::string(spec.name) == "device.prop"
+                ? "u:object_r:floral_profile_file:s0" : "u:object_r:floral_stream_file:s0";
+        int fd = openat(leaf, spec.name, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+        if (fd < 0 && errno == ENOENT && mounts.files[i] == 0) continue;
+        Fd source{fd};
+        struct stat before{};
+        struct statvfs flags{};
+        if (fd < 0 || mounts.files[i] == 0 || fstat(fd, &before) != 0 ||
+            !S_ISREG(before.st_mode) || before.st_uid != spec.owner ||
+            before.st_gid != spec.owner || (before.st_mode & 07777) != spec.mode ||
+            before.st_size > 64 * 1024 || fstatvfs(fd, &flags) != 0 ||
+            !(flags.f_flag & ST_RDONLY) || !CheckIpcFdMount(fd, mounts.files[i], error)) {
+            return IpcError(error, std::string("invalid immutable HAL snapshot: ") + spec.name);
+        }
+
+        char* existing = nullptr;
+        int existing_length = fgetfilecon(fd, &existing);
+        bool already_labeled = existing_length >= 0 && existing && std::string(existing) == context;
+        freecon(existing);
+        if (already_labeled) continue;
+        // Only repair the runtime's tmpfs snapshots. Never relabel an image,
+        // arbitrary external filesystem or a file outside the transport FS.
+        struct statfs filesystem{};
+        if (before.st_dev != leaf_status.st_dev || fstatfs(fd, &filesystem) != 0 ||
+            filesystem.f_type != TMPFS_MAGIC) {
+            return IpcError(error, "incorrect HAL label outside runtime tmpfs");
+        }
+
+        // Create a private writable alias of this pinned inode, not its parent
+        // filesystem. The original delivery mount never loses its read-only bit.
+        char alias[] = "/dev/.floral-hal-label-XXXXXX";
+        int target = mkstemp(alias);
+        if (target < 0) return IpcError(error, "cannot create HAL labeling target");
+        close(target);
+        struct Alias {
+            const char* path;
+            bool mounted = false;
+            ~Alias() {
+                if (mounted) umount2(path, MNT_DETACH);
+                unlink(path);
+            }
+        } cleanup{alias};
+        const auto pinned = "/proc/self/fd/" + std::to_string(fd);
+        if (mount(pinned.c_str(), alias, nullptr, MS_BIND, nullptr) != 0) {
+            return IpcError(error, "cannot bind HAL labeling alias");
+        }
+        cleanup.mounted = true;
+        if (mount(nullptr, alias, nullptr, MS_PRIVATE, nullptr) != 0 ||
+            mount(nullptr, alias, nullptr, MS_BIND | MS_REMOUNT | MS_NOSUID | MS_NODEV | MS_NOEXEC,
+                  nullptr) != 0) {
+            return IpcError(error, "cannot prepare private HAL labeling alias");
+        }
+        Fd writable{open(alias, O_RDONLY | O_NOFOLLOW | O_CLOEXEC)};
+        struct stat same{};
+        if (writable.fd < 0 || fstat(writable.fd, &same) != 0 ||
+            before.st_dev != same.st_dev || before.st_ino != same.st_ino ||
+            fsetfilecon(writable.fd, context) != 0) {
+            return IpcError(error, "cannot label pinned HAL snapshot");
+        }
+        // Check the SID visible through the actual read-only consumer FD.
+        char* actual = nullptr;
+        int length = fgetfilecon(fd, &actual);
+        bool correct = length >= 0 && actual && std::string(actual) == context;
+        freecon(actual);
+        if (!correct || fstatvfs(fd, &flags) != 0 || !(flags.f_flag & ST_RDONLY)) {
+            return IpcError(error, "HAL snapshot label or read-only state mismatch");
+        }
+        close(writable.fd);
+        writable.fd = -1;
+        if (umount2(alias, 0) != 0) return IpcError(error, "cannot remove HAL labeling alias");
+        cleanup.mounted = false;
+    }
+    IpcMounts after;
+    if (!CheckIpcMountFile(true, &after, error) || mounts.leaf != after.leaf ||
+        mounts.files != after.files) return IpcError(error, "HAL mounts changed while labeling");
+    return true;
+}
+
+}  // namespace android::init::floral
