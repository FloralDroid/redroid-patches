+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "floral_fuse.h"
+
+#include <android-base/logging.h>
+#include <sys/mount.h>
+#include <sys/stat.h>
+#include <sys/vfs.h>
+#include <linux/magic.h>
+#include <selinux/selinux.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstring>
+#include <cstdio>
+#include <cstdlib>
+#include "selinux.h"
+
+namespace android::init {
+namespace {
+::floral::fuse::BootConfig config;
+bool initialized = false;
+std::vector<std::string> original_arguments;
+std::string selinux_mode;
+}  // namespace
+
+[[noreturn]] void FailFloralFuse(const std::string& error) {
+    // Never invoke init's fatal/reboot handler for a failed external view.
+    LOG(ERROR) << "Floral FUSE: " << error;
+    dprintf(STDERR_FILENO, "Floral FUSE: %s\n", error.c_str());
+    _exit(1);
+}
+
+void InitializeFloralFuse(int argc, char** argv) {
+    if (initialized) return;
+    for (int i = 1; i < argc; ++i) original_arguments.emplace_back(argv[i]);
+    std::string error;
+    if (!::floral::fuse::ParseBootArguments(original_arguments, &config, &error) ||
+        !::floral::fuse::ResolveBootMode(&config, &error)) FailFloralFuse(error);
+    initialized = true;
+    if (!IsLupineFuse()) return;
+    if (argc < 2 || (strcmp(argv[1], "second_stage") != 0 &&
+                     strcmp(argv[1], "selinux_setup") != 0)) {
+        FailFloralFuse("Lupine v1 requires /system/bin/init second_stage, not first stage");
+    }
+    for (const auto& argument : original_arguments) {
+        constexpr char prefix[] = "androidboot.selinux=";
+        if (argument.compare(0, sizeof(prefix) - 1, prefix) != 0) continue;
+        const auto value = argument.substr(sizeof(prefix) - 1);
+        if ((value != "disabled" && value != "permissive" && value != "enforcing") ||
+            (!selinux_mode.empty() && selinux_mode != value)) {
+            FailFloralFuse("invalid/conflicting Lupine SELinux mode");
+        }
+        selinux_mode = value;
+    }
+    if (selinux_mode.empty()) FailFloralFuse("Lupine requires its explicit SELinux mode");
+}
+
+const ::floral::fuse::BootConfig& FloralFuseConfig() { return config; }
+bool IsLupineFuse() { return initialized && config.mode == ::floral::fuse::Mode::Lupine; }
+const std::string& FloralFuseSELinuxMode() { return selinux_mode; }
+
+bool EnterFloralFuseSELinuxNamespace() {
+    if (!IsLupineFuse()) return false;
+    if (getenv(kEnvSelinuxStartedAt) != nullptr) {
+        const int expected = selinux_mode == "enforcing" ? 1 : 0;
+        if (security_getenforce() != expected) FailFloralFuse("SELinux mode changed after setup");
+        return false;
+    }
+    struct statfs fs = {};
+    if (statfs("/sys/fs/selinux", &fs) != 0) {
+        FailFloralFuse("missing projected /sys/fs/selinux control directory");
+    }
+    if (fs.f_type == SELINUX_MAGIC) FailFloralFuse("inherited selinuxfs is not permitted");
+    if (selinux_mode == "disabled") return false;
+    // Use the same lsm_ctx ABI as the preceding SELinux namespace patch.
+    struct LsmContext {
+        uint64_t id;
+        uint64_t flags;
+        uint64_t len;
+        uint64_t ctx_len;
+    };
+    static_assert(sizeof(LsmContext) == 32);
+    LsmContext context = {101, 0, sizeof(LsmContext), 0};
+    if (syscall(460, 106, &context, sizeof(context), 0) != 0) {
+        FailFloralFuse("cannot create requested private SELinux namespace: " +
+                      std::string(strerror(errno)));
+    }
+    if (mount("selinuxfs", "/sys/fs/selinux", "selinuxfs",
+              MS_NOSUID | MS_NODEV | MS_NOEXEC, nullptr) != 0) {
+        FailFloralFuse("cannot mount private selinuxfs: " + std::string(strerror(errno)));
+    }
+    return true;
+}
+
+std::vector<std::string> FloralFuseStageArguments(const char* stage) {
+    std::vector<std::string> arguments = {"/system/bin/init", stage};
+    for (const auto& argument : original_arguments) {
+        if (argument.compare(0, 12, "androidboot.") == 0 &&
+            argument.compare(0, 23, "androidboot.floral_fuse") != 0) {
+            arguments.push_back(argument);
+        }
+    }
+    const auto frozen = ::floral::fuse::BootArguments(config);
+    arguments.insert(arguments.end(), frozen.begin(), frozen.end());
+    return arguments;
+}
+
+bool FloralFusePropertyAllowed(const std::string& name, const std::string& value) {
+    constexpr char prefix[] = "ro.boot.floral_fuse";
+    if (name.compare(0, sizeof(prefix) - 1, prefix) != 0) return true;
+    if (!initialized) return false;
+    for (const auto& argument : ::floral::fuse::BootArguments(config)) {
+        const auto equal = argument.find('=');
+        if (name == "ro.boot." + argument.substr(12, equal - 12) &&
+            value == argument.substr(equal + 1)) return true;
+    }
+    return false;
+}
+
+void CheckFloralFuseProperty(const std::string& name, const std::string& value) {
+    if (!FloralFusePropertyAllowed(name, value)) FailFloralFuse("boot property conflicts with frozen argv: " + name);
+}
+
+void VerifyFloralFuse(bool controls_ready) {
+    if (!IsLupineFuse()) return;
+    std::string error;
+    if (!::floral::fuse::VerifyLupineView(config, controls_ready, &error,
+                                      controls_ready)) FailFloralFuse(error);
+}
+
+void PrepareFloralFuseControls() {
+    if (!IsLupineFuse()) return;
+    // The canonical second-stage entry did not execute first-stage mkdirs.
+    // Only ordinary mount-staging directories are created, never device nodes
+    // or replacements for the host-delivered /dev/proc/sys mounts.
+    for (const char* path : {"/mnt/vendor", "/mnt/product"}) {
+        if (mkdir(path, 0755) != 0 && errno != EEXIST) {
+            FailFloralFuse(std::string("mount staging directory ") + path + ": " + strerror(errno));
+        }
+        struct stat status = {};
+        if (lstat(path, &status) != 0 || !S_ISDIR(status.st_mode)) {
+            FailFloralFuse(std::string("invalid mount staging directory: ") + path);
+        }
+    }
+    if (mount("bpf", "/sys/fs/bpf", "bpf", MS_NOSUID | MS_NODEV | MS_NOEXEC, nullptr) != 0) {
+        FailFloralFuse("private bpffs: " + std::string(strerror(errno)));
+    }
+    VerifyFloralFuse(true);
+}
+
+void PrivatizeFloralFuse() {
+    if (!IsLupineFuse()) return;
+    std::string error;
+    if (!::floral::fuse::MakeLupineViewPrivate(&error)) FailFloralFuse(error);
+    // The preceding IPC patch independently validates and privatizes its leaf.
+    VerifyFloralFuse(true);
+}
+
+}  // namespace android::init
