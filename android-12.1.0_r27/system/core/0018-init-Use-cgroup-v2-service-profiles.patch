@@ -877,6 +877,11 @@ int SecondStageMain(int argc, char** argv) {
         PLOG(FATAL) << "SetupMountNamespaces failed";
     }
 
+    // The delegated v2 root must be empty before enabling its controllers.
+    if (auto result = SetupCgroupsAction(BuiltinArguments(kInitContext)); !result.ok()) {
+        LOG(FATAL) << "Failed to setup cgroups before starting subcontexts: " << result.error();
+    }
+
     InitializeSubcontext();
 
