 Result<void> ServiceParser::ParseWritepid(std::vector<std::string>&& args) {
     args.erase(args.begin());
+    for (const auto& path : args) {
+        if (android::base::EndsWith(path, "/tasks") || StartsWith(path, "/acct/") ||
+            StartsWith(path, "/dev/cpuset/") || StartsWith(path, "/dev/cpuctl/") ||
+            StartsWith(path, "/dev/stune/") || StartsWith(path, "/dev/memcg/") ||
+            StartsWith(path, "/dev/blkio/")) {
+            return Error() << "cgroup v1 writepid is unsupported; use task_profiles";
+        }
+    }
     service_->writepid_files_ = std::move(args);
     return {};
 }
@@ -550,9 +544,6 @@ const KeywordMap<ServiceParser::OptionParser>& ServiceParser::GetParserMap() con
         {"memcg.limit_in_bytes",    {1,     1,    &ServiceParser::ParseMemcgLimitInBytes}},
