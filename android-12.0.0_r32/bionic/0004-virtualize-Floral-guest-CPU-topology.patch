From 5eef81c018d5b7ef6b9986810c52ca037a466a0a Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Fri, 28 Aug 2026 11:56:53 +0800
Subject: [PATCH] bionic: virtualize Floral guest CPU topology

Read CPU counts from the NativeBridge-mounted guest cpuinfo for translated processes.

diff --git a/libc/bionic/sysinfo.cpp b/libc/bionic/sysinfo.cpp
index 3f4bf96..2aaf829 100644
--- a/libc/bionic/sysinfo.cpp
+++ b/libc/bionic/sysinfo.cpp
@@ -400,6 +400,33 @@ void ApplyFloralProcView(struct sysinfo* info) {
   }
 }
 
+int ReadFloralGuestCpuCount() {
+  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE ||
+      !__floral_nativebridge_procview_enabled()) {
+    return 0;
+  }
+
+  FILE* file = fopen("/proc/cpuinfo", "re");
+  if (file == nullptr) return 0;
+
+  int count = 0;
+  constexpr size_t kProcessorPrefixLength = sizeof("processor") - 1;
+  char* line = nullptr;
+  size_t capacity = 0;
+  while (getline(&line, &capacity, file) != -1) {
+    const size_t line_length = strlen(line);
+    if (line_length > kProcessorPrefixLength &&
+        strncmp(line, "processor", kProcessorPrefixLength) == 0 &&
+        (line[kProcessorPrefixLength] == ':' || line[kProcessorPrefixLength] == ' ' ||
+         line[kProcessorPrefixLength] == '\t')) {
+      ++count;
+    }
+  }
+  free(line);
+  fclose(file);
+  return count;
+}
+
 }  // namespace
 
 extern "C" int sysinfo(struct sysinfo* info) {
@@ -421,6 +448,9 @@ static bool __matches_cpuN(const char* s) {
 }
 
 int get_nprocs_conf() {
+  const int guest_cpu_count = ReadFloralGuestCpuCount();
+  if (guest_cpu_count > 0) return guest_cpu_count;
+
   // On x86 kernels you can use /proc/cpuinfo for this, but on ARM kernels offline CPUs disappear
   // from there. This method works on both.
   ScopedReaddir reader("/sys/devices/system/cpu");
@@ -439,6 +469,9 @@ int get_nprocs_conf() {
 }
 
 int get_nprocs() {
+  const int guest_cpu_count = ReadFloralGuestCpuCount();
+  if (guest_cpu_count > 0) return guest_cpu_count;
+
   int cpu_count = 1;
   FILE* fp = fopen("/sys/devices/system/cpu/online", "re");
   if (fp != nullptr) {
