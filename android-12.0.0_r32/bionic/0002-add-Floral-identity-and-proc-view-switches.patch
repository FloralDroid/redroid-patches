From 64eabee84000e186d71d38841d4cac1333d05bb4 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Thu, 20 Aug 2026 01:32:45 +0800
Subject: [PATCH] bionic: add Floral identity and proc view switches

Change-Id: Idc0339edd1a40df9820a403c625225cf071157e2
---
 libc/bionic/floral_nativebridge.cpp | 46 ++++++++++++++++++++++++++---
 libc/bionic/getauxval.cpp           |  5 +++-
 libc/bionic/sysinfo.cpp             |  3 +-
 libc/bionic/uname.cpp               |  4 +++
 libc/private/floral_nativebridge.h  |  2 ++
 5 files changed, 54 insertions(+), 6 deletions(-)

diff --git a/libc/bionic/floral_nativebridge.cpp b/libc/bionic/floral_nativebridge.cpp
index 5e31a8c..c54b672 100644
--- a/libc/bionic/floral_nativebridge.cpp
+++ b/libc/bionic/floral_nativebridge.cpp
@@ -19,8 +19,26 @@ int g_floral_nativebridge_guest_arch = FLORAL_NATIVEBRIDGE_GUEST_NONE;
 constexpr size_t kUtsnameFieldLength = 64;
 constexpr char kDefaultGuestKernelRelease[] = "5.10.66-android12-9";
 constexpr char kDefaultGuestKernelVersion[] = "#1 SMP PREEMPT";
+constexpr char kCompatAospProperty[] = "ro.floral.bridge.compat_aosp";
+constexpr char kGuestIdentityProperty[] = "ro.floral.bridge.guest_identity";
+constexpr char kProcViewProperty[] = "ro.floral.libc.procview";
 char g_floral_nativebridge_kernel_release[kUtsnameFieldLength + 1] = {};
 char g_floral_nativebridge_kernel_version[kUtsnameFieldLength + 1] = {};
+static __thread bool g_reading_floral_feature_property;
+
+bool FloralPropertyEnabled(const char* name, bool default_value) {
+  if (g_reading_floral_feature_property) {
+    return default_value;
+  }
+  g_reading_floral_feature_property = true;
+  char value[PROP_VALUE_MAX] = {};
+  const int length = __system_property_get(name, value);
+  g_reading_floral_feature_property = false;
+  if (length <= 0) return default_value;
+  return strcmp(value, "1") == 0 || strcmp(value, "true") == 0 ||
+         strcmp(value, "TRUE") == 0 || strcmp(value, "y") == 0 ||
+         strcmp(value, "yes") == 0;
+}
 
 void LoadKernelIdentity() {
   char value[PROP_VALUE_MAX] = {};
@@ -71,7 +89,8 @@ extern "C" void __floral_nativebridge_set_guest_arch(int arch) {
   if (arch < FLORAL_NATIVEBRIDGE_GUEST_NONE || arch > FLORAL_NATIVEBRIDGE_GUEST_ARM64) {
     arch = FLORAL_NATIVEBRIDGE_GUEST_NONE;
   }
-  if (arch == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+  if (arch == FLORAL_NATIVEBRIDGE_GUEST_NONE ||
+      !__floral_nativebridge_guest_identity_enabled()) {
     ClearKernelIdentity();
   } else {
     LoadKernelIdentity();
@@ -83,7 +102,22 @@ extern "C" __LIBC_HIDDEN__ int __floral_nativebridge_guest_arch() {
   return __atomic_load_n(&g_floral_nativebridge_guest_arch, __ATOMIC_ACQUIRE);
 }
 
+extern "C" __LIBC_HIDDEN__ bool __floral_nativebridge_guest_identity_enabled() {
+  return !FloralPropertyEnabled(kCompatAospProperty, false) &&
+         FloralPropertyEnabled(kGuestIdentityProperty, true);
+}
+
+extern "C" __LIBC_HIDDEN__ bool __floral_nativebridge_procview_enabled() {
+  return !FloralPropertyEnabled(kCompatAospProperty, false) &&
+         FloralPropertyEnabled(kProcViewProperty, true);
+}
+
 extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_machine() {
+  // The dynamic linker can query libc identity before NativeBridge selects a guest.
+  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE ||
+      !__floral_nativebridge_guest_identity_enabled()) {
+    return nullptr;
+  }
   switch (__floral_nativebridge_guest_arch()) {
     case FLORAL_NATIVEBRIDGE_GUEST_ARM:
       return "armv7l";
@@ -95,7 +129,8 @@ extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_machine() {
 }
 
 extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_kernel_release() {
-  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE ||
+      !__floral_nativebridge_guest_identity_enabled()) {
     return nullptr;
   }
   return g_floral_nativebridge_kernel_release[0] == '\0' ? kDefaultGuestKernelRelease
@@ -103,7 +138,8 @@ extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_kernel_releas
 }
 
 extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_kernel_version() {
-  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE ||
+      !__floral_nativebridge_guest_identity_enabled()) {
     return nullptr;
   }
   return g_floral_nativebridge_kernel_version[0] == '\0' ? kDefaultGuestKernelVersion
@@ -115,7 +151,9 @@ extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_property_override(c
     return nullptr;
   }
   const int arch = __floral_nativebridge_guest_arch();
-  if (arch == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+  // Property reads happen during linker startup, before TLS is available.
+  if (arch == FLORAL_NATIVEBRIDGE_GUEST_NONE ||
+      !__floral_nativebridge_guest_identity_enabled()) {
     return nullptr;
   }
   for (const PropertyOverride& property : kPropertyOverrides) {
diff --git a/libc/bionic/getauxval.cpp b/libc/bionic/getauxval.cpp
index 312f782..9bf3224 100644
--- a/libc/bionic/getauxval.cpp
+++ b/libc/bionic/getauxval.cpp
@@ -87,7 +87,10 @@ extern "C" unsigned long getauxval(unsigned long type) {
   bool exists;
   unsigned long result = 0;
   const int guest_arch = __floral_nativebridge_guest_arch();
-  if (guest_arch != FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+  // The linker calls getauxval before TLS is ready; keep the host path until
+  // NativeBridge has selected a guest architecture.
+  if (guest_arch != FLORAL_NATIVEBRIDGE_GUEST_NONE &&
+      __floral_nativebridge_guest_identity_enabled()) {
     result = FloralGuestAuxValue(type, guest_arch, &exists);
   } else {
     exists = false;
diff --git a/libc/bionic/sysinfo.cpp b/libc/bionic/sysinfo.cpp
index 515554b..3f4bf96 100644
--- a/libc/bionic/sysinfo.cpp
+++ b/libc/bionic/sysinfo.cpp
@@ -39,6 +39,7 @@
 #include <unistd.h>
 
 #include "private/ScopedReaddir.h"
+#include "private/floral_nativebridge.h"
 #include "private/get_cpu_count_from_string.h"
 
 extern "C" int __sysinfo(struct sysinfo*);
@@ -403,7 +404,7 @@ void ApplyFloralProcView(struct sysinfo* info) {
 
 extern "C" int sysinfo(struct sysinfo* info) {
   const int result = __sysinfo(info);
-  if (result == 0 && info != nullptr) {
+  if (result == 0 && info != nullptr && __floral_nativebridge_procview_enabled()) {
     // Prefer the current memory cgroup so direct libc queries stay container-scoped.
     // Fall back to procfs for kernels without readable cgroup memory limits.
     ApplyFloralProcView(info);
diff --git a/libc/bionic/uname.cpp b/libc/bionic/uname.cpp
index a989278..8aa100b 100644
--- a/libc/bionic/uname.cpp
+++ b/libc/bionic/uname.cpp
@@ -15,6 +15,10 @@ extern "C" int __uname(utsname*);
 
 extern "C" int uname(utsname* buffer) {
   const int result = __uname(buffer);
+  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE ||
+      !__floral_nativebridge_guest_identity_enabled()) {
+    return result;
+  }
   const char* machine = __floral_nativebridge_guest_machine();
   if (result == 0 && machine != nullptr) {
     strlcpy(buffer->machine, machine, sizeof(buffer->machine));
diff --git a/libc/private/floral_nativebridge.h b/libc/private/floral_nativebridge.h
index 4015596..4019ab0 100644
--- a/libc/private/floral_nativebridge.h
+++ b/libc/private/floral_nativebridge.h
@@ -22,6 +22,8 @@ void __floral_nativebridge_set_guest_arch(int arch);
 
 // Internal libc accessors used by architecture-reporting APIs.
 int __floral_nativebridge_guest_arch();
+bool __floral_nativebridge_guest_identity_enabled();
+bool __floral_nativebridge_procview_enabled();
 const char* __floral_nativebridge_guest_machine();
 const char* __floral_nativebridge_guest_kernel_release();
 const char* __floral_nativebridge_guest_kernel_version();
-- 
2.47.3

