From 9031a5d1e795688a5966e75624af8bbf7a9321b9 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Sat, 29 Aug 2026 14:24:18 +0800
Subject: [PATCH] bionic: keep host libc out of NativeBridge guest install

Keep the bionic NativeBridge libc variant available for linking, but mark it non-installable so native_bridge_support can own the guest libc.so output without a duplicate install rule.

Change-Id: I4d2f18f8c95b44e3a9cb9c58f9af9d9e7a7e0f11
---
 libc/Android.bp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/libc/Android.bp b/libc/Android.bp
index 93db50590..6b0767c6e 100644
--- a/libc/Android.bp
+++ b/libc/Android.bp
@@ -1779,6 +1779,14 @@ cc_library {
         "com.android.runtime",
     ],
 
+    // The guest libc from native_bridge_support owns the guest libc.so path.
+    // Keep this variant for linking, but do not install a duplicate libc.so.
+    target: {
+        native_bridge: {
+            installable: false,
+        },
+    },
+
     // Sorting bss symbols by size usually results in less dirty pages at run
     // time, because small symbols are grouped together.
     sort_bss_symbols_by_size: true,
-- 
2.47.3

