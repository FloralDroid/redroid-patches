diff --git a/libc/bionic/floral_nativebridge.cpp b/libc/bionic/floral_nativebridge.cpp
new file mode 100644
index 0000000..5e31a8c
--- /dev/null
+++ b/libc/bionic/floral_nativebridge.cpp
@@ -0,0 +1,127 @@
+/*
+ * Copyright 2026 FloralDroid
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+#include "private/floral_nativebridge.h"
+
+#include <sys/system_properties.h>
+
+#include <string.h>
+
+#include "private/bionic_defs.h"
+
+namespace {
+
+int g_floral_nativebridge_guest_arch = FLORAL_NATIVEBRIDGE_GUEST_NONE;
+constexpr size_t kUtsnameFieldLength = 64;
+constexpr char kDefaultGuestKernelRelease[] = "5.10.66-android12-9";
+constexpr char kDefaultGuestKernelVersion[] = "#1 SMP PREEMPT";
+char g_floral_nativebridge_kernel_release[kUtsnameFieldLength + 1] = {};
+char g_floral_nativebridge_kernel_version[kUtsnameFieldLength + 1] = {};
+
+void LoadKernelIdentity() {
+  char value[PROP_VALUE_MAX] = {};
+  if (__system_property_get("ro.boot.floral_kernel_release", value) > 0 &&
+      strlen(value) <= kUtsnameFieldLength) {
+    strlcpy(g_floral_nativebridge_kernel_release, value,
+            sizeof(g_floral_nativebridge_kernel_release));
+  }
+
+  memset(value, 0, sizeof(value));
+  if (__system_property_get("ro.boot.floral_kernel_version", value) > 0 &&
+      strlen(value) <= kUtsnameFieldLength) {
+    strlcpy(g_floral_nativebridge_kernel_version, value,
+            sizeof(g_floral_nativebridge_kernel_version));
+  }
+}
+
+void ClearKernelIdentity() {
+  g_floral_nativebridge_kernel_release[0] = '\0';
+  g_floral_nativebridge_kernel_version[0] = '\0';
+}
+
+struct PropertyOverride {
+  const char* name;
+  const char* arm;
+  const char* arm64;
+};
+
+constexpr PropertyOverride kPropertyOverrides[] = {
+    {"ro.product.cpu.abi", "armeabi-v7a", "arm64-v8a"},
+    {"ro.product.cpu.abi2", "armeabi", ""},
+    {"ro.product.cpu.abilist", "armeabi-v7a,armeabi", "arm64-v8a,armeabi-v7a,armeabi"},
+    {"ro.product.cpu.abilist32", "armeabi-v7a,armeabi", "armeabi-v7a,armeabi"},
+    {"ro.product.cpu.abilist64", "", "arm64-v8a"},
+    {"ro.dalvik.vm.isa.arm", "arm", "arm"},
+    {"ro.dalvik.vm.isa.arm64", "arm64", "arm64"},
+    {"ro.floral.nb.pubabi", "armeabi-v7a,armeabi", "arm64-v8a,armeabi-v7a,armeabi"},
+    {"ro.floral.nb.pubabi32", "armeabi-v7a,armeabi", "armeabi-v7a,armeabi"},
+    {"ro.floral.nb.pubabi64", "", "arm64-v8a"},
+    {"ro.floral.nb.loadabi", "armeabi-v7a,armeabi", "arm64-v8a,armeabi-v7a,armeabi"},
+    {"ro.floral.nb.loadabi32", "armeabi-v7a,armeabi", "armeabi-v7a,armeabi"},
+    {"ro.floral.nb.loadabi64", "", "arm64-v8a"},
+};
+
+}  // namespace
+
+extern "C" void __floral_nativebridge_set_guest_arch(int arch) {
+  if (arch < FLORAL_NATIVEBRIDGE_GUEST_NONE || arch > FLORAL_NATIVEBRIDGE_GUEST_ARM64) {
+    arch = FLORAL_NATIVEBRIDGE_GUEST_NONE;
+  }
+  if (arch == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+    ClearKernelIdentity();
+  } else {
+    LoadKernelIdentity();
+  }
+  __atomic_store_n(&g_floral_nativebridge_guest_arch, arch, __ATOMIC_RELEASE);
+}
+
+extern "C" __LIBC_HIDDEN__ int __floral_nativebridge_guest_arch() {
+  return __atomic_load_n(&g_floral_nativebridge_guest_arch, __ATOMIC_ACQUIRE);
+}
+
+extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_machine() {
+  switch (__floral_nativebridge_guest_arch()) {
+    case FLORAL_NATIVEBRIDGE_GUEST_ARM:
+      return "armv7l";
+    case FLORAL_NATIVEBRIDGE_GUEST_ARM64:
+      return "aarch64";
+    default:
+      return nullptr;
+  }
+}
+
+extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_kernel_release() {
+  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+    return nullptr;
+  }
+  return g_floral_nativebridge_kernel_release[0] == '\0' ? kDefaultGuestKernelRelease
+                                                         : g_floral_nativebridge_kernel_release;
+}
+
+extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_kernel_version() {
+  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+    return nullptr;
+  }
+  return g_floral_nativebridge_kernel_version[0] == '\0' ? kDefaultGuestKernelVersion
+                                                         : g_floral_nativebridge_kernel_version;
+}
+
+extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_property_override(const char* name) {
+  if (name == nullptr) {
+    return nullptr;
+  }
+  const int arch = __floral_nativebridge_guest_arch();
+  if (arch == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+    return nullptr;
+  }
+  for (const PropertyOverride& property : kPropertyOverrides) {
+    if (strcmp(name, property.name) == 0) {
+      return arch == FLORAL_NATIVEBRIDGE_GUEST_ARM64 ? property.arm64 : property.arm;
+    }
+  }
+  return nullptr;
+}
diff --git a/libc/bionic/getauxval.cpp b/libc/bionic/getauxval.cpp
index a3c6b19..312f782 100644
--- a/libc/bionic/getauxval.cpp
+++ b/libc/bionic/getauxval.cpp
@@ -35,6 +35,41 @@
 #include <elf.h>
 #include <errno.h>
 
+#include "private/floral_nativebridge.h"
+
+namespace {
+
+constexpr unsigned long kArm64BaselineHwcap = (1UL << 0) | (1UL << 1);  // FP, ASIMD.
+constexpr unsigned long kArmBaselineHwcap =
+    (1UL << 0) | (1UL << 1) | (1UL << 2) | (1UL << 4) | (1UL << 6) |
+    (1UL << 7) | (1UL << 12) | (1UL << 13) | (1UL << 15) | (1UL << 16) |
+    (1UL << 17) | (1UL << 18);  // ARMv7 with VFPv4, NEON and integer divide.
+
+unsigned long FloralGuestAuxValue(unsigned long type, int arch, bool* exists) {
+  static const char kArmPlatform[] = "v7l";
+  static const char kArm64Platform[] = "aarch64";
+
+  *exists = false;
+  switch (type) {
+    case AT_PLATFORM:
+    case AT_BASE_PLATFORM:
+      *exists = true;
+      return reinterpret_cast<unsigned long>(
+          arch == FLORAL_NATIVEBRIDGE_GUEST_ARM64 ? kArm64Platform : kArmPlatform);
+    case AT_HWCAP:
+      *exists = true;
+      return arch == FLORAL_NATIVEBRIDGE_GUEST_ARM64 ? kArm64BaselineHwcap
+                                                      : kArmBaselineHwcap;
+    case AT_HWCAP2:
+      *exists = true;
+      return 0;
+    default:
+      return 0;
+  }
+}
+
+}  // namespace
+
 // This function needs to be safe to call before TLS is set up, so it can't
 // access errno or the stack protector.
 __LIBC_HIDDEN__ unsigned long __bionic_getauxval(unsigned long type, bool* exists) {
@@ -50,7 +85,16 @@ __LIBC_HIDDEN__ unsigned long __bionic_getauxval(unsigned long type, bool* exist
 
 extern "C" unsigned long getauxval(unsigned long type) {
   bool exists;
-  unsigned long result = __bionic_getauxval(type, &exists);
+  unsigned long result = 0;
+  const int guest_arch = __floral_nativebridge_guest_arch();
+  if (guest_arch != FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+    result = FloralGuestAuxValue(type, guest_arch, &exists);
+  } else {
+    exists = false;
+  }
+  if (!exists) {
+    result = __bionic_getauxval(type, &exists);
+  }
   if (!exists) errno = ENOENT;
   return result;
 }
diff --git a/libc/bionic/sysinfo.cpp b/libc/bionic/sysinfo.cpp
index 7ab8e9e..515554b 100644
--- a/libc/bionic/sysinfo.cpp
+++ b/libc/bionic/sysinfo.cpp
@@ -29,12 +29,387 @@
 #include <sys/sysinfo.h>
 
 #include <dirent.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <stdint.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
 #include <unistd.h>
 
-#include "private/get_cpu_count_from_string.h"
 #include "private/ScopedReaddir.h"
+#include "private/get_cpu_count_from_string.h"
+
+extern "C" int __sysinfo(struct sysinfo*);
+
+namespace {
+
+struct FloralMeminfo {
+  uint64_t total_kb = 0;
+  uint64_t free_kb = 0;
+  uint64_t buffers_kb = 0;
+  uint64_t shared_kb = 0;
+  uint64_t swap_total_kb = 0;
+  uint64_t swap_free_kb = 0;
+  bool valid = false;
+};
+
+struct FloralCgroupMemory {
+  uint64_t total_bytes = 0;
+  uint64_t current_bytes = 0;
+  uint64_t swap_total_bytes = 0;
+  uint64_t swap_current_bytes = 0;
+  bool valid = false;
+};
+
+// Cgroup paths can approach PATH_MAX; keep their buffers off libc's small stack.
+class FloralPathBuffer {
+ public:
+  FloralPathBuffer() : data_(static_cast<char*>(malloc(PATH_MAX))) {
+    if (data_ != nullptr) data_[0] = '\0';
+  }
+
+  ~FloralPathBuffer() {
+    free(data_);
+  }
+
+  FloralPathBuffer(const FloralPathBuffer&) = delete;
+  FloralPathBuffer& operator=(const FloralPathBuffer&) = delete;
+
+  bool valid() const {
+    return data_ != nullptr;
+  }
+
+  char* get() {
+    return data_;
+  }
+
+ private:
+  char* data_;
+};
+
+unsigned long ToSysinfoUnits(uint64_t kibibytes, unsigned int unit) {
+  if (unit == 0) unit = 1;
+  if (kibibytes > UINT64_MAX / 1024) return ULONG_MAX;
+  const uint64_t value = kibibytes * 1024 / unit;
+  return value > ULONG_MAX ? ULONG_MAX : static_cast<unsigned long>(value);
+}
+
+unsigned long BytesToSysinfoUnits(uint64_t bytes, unsigned int unit) {
+  if (unit == 0) unit = 1;
+  const uint64_t value = bytes / unit;
+  return value > ULONG_MAX ? ULONG_MAX : static_cast<unsigned long>(value);
+}
+
+bool IsSafeCgroupPath(const char* path) {
+  if (path == nullptr || path[0] != '/') return false;
+
+  const char* component = path + 1;
+  while (*component != '\0') {
+    const char* slash = strchr(component, '/');
+    const size_t length = slash == nullptr ? strlen(component) : slash - component;
+    if ((length == 1 && component[0] == '.') ||
+        (length == 2 && component[0] == '.' && component[1] == '.')) {
+      return false;
+    }
+    if (slash == nullptr) break;
+    component = slash + 1;
+  }
+  return true;
+}
+
+bool ControllerListContains(const char* controllers, const char* expected) {
+  const size_t expected_length = strlen(expected);
+  const char* cursor = controllers;
+  while (*cursor != '\0') {
+    const char* comma = strchr(cursor, ',');
+    const size_t length = comma == nullptr ? strlen(cursor) : comma - cursor;
+    if (length == expected_length && strncmp(cursor, expected, length) == 0) return true;
+    if (comma == nullptr) break;
+    cursor = comma + 1;
+  }
+  return false;
+}
+
+bool ReadSelfCgroupPaths(char* unified, size_t unified_size, char* memory, size_t memory_size) {
+  FILE* file = fopen("/proc/self/cgroup", "re");
+  if (file == nullptr) return false;
+
+  char* line = nullptr;
+  size_t capacity = 0;
+  while (getline(&line, &capacity, file) != -1) {
+    char* first_colon = strchr(line, ':');
+    if (first_colon == nullptr) continue;
+    char* second_colon = strchr(first_colon + 1, ':');
+    if (second_colon == nullptr) continue;
+
+    *first_colon = '\0';
+    *second_colon = '\0';
+    char* path = second_colon + 1;
+    path[strcspn(path, "\r\n")] = '\0';
+    if (!IsSafeCgroupPath(path)) continue;
+
+    if (strcmp(line, "0") == 0 && first_colon[1] == '\0') {
+      if (strlcpy(unified, path, unified_size) >= unified_size) unified[0] = '\0';
+    } else if (ControllerListContains(first_colon + 1, "memory")) {
+      if (strlcpy(memory, path, memory_size) >= memory_size) memory[0] = '\0';
+    }
+  }
+  free(line);
+  fclose(file);
+  return unified[0] != '\0' || memory[0] != '\0';
+}
+
+bool ReadCgroupValue(const char* path, uint64_t* value, bool* unlimited) {
+  FILE* file = fopen(path, "re");
+  if (file == nullptr) return false;
+
+  char text[64];
+  const bool read = fgets(text, sizeof(text), file) != nullptr;
+  fclose(file);
+  if (!read) return false;
+
+  text[strcspn(text, "\r\n")] = '\0';
+  if (strcmp(text, "max") == 0) {
+    *unlimited = true;
+    *value = 0;
+    return true;
+  }
+
+  char* end = nullptr;
+  errno = 0;
+  const uint64_t parsed = strtoull(text, &end, 10);
+  if (errno != 0 || end == text || *end != '\0') return false;
+  *unlimited = false;
+  *value = parsed;
+  return true;
+}
+
+bool BuildCgroupFilePath(char* output, size_t output_size, const char* root, const char* cgroup,
+                         const char* file) {
+  const char* separator = strcmp(cgroup, "/") == 0 ? "" : cgroup;
+  const int length = snprintf(output, output_size, "%s%s/%s", root, separator, file);
+  return length >= 0 && static_cast<size_t>(length) < output_size;
+}
+
+bool ParentCgroupPath(char* path) {
+  if (strcmp(path, "/") == 0) return false;
+  char* slash = strrchr(path, '/');
+  if (slash == path) {
+    path[1] = '\0';
+  } else if (slash != nullptr) {
+    *slash = '\0';
+  }
+  return true;
+}
+
+bool ReadCgroupLimit(const char* root, const char* cgroup, const char* file, uint64_t* limit) {
+  FloralPathBuffer current;
+  FloralPathBuffer path;
+  if (!current.valid() || !path.valid() || strlcpy(current.get(), cgroup, PATH_MAX) >= PATH_MAX) {
+    return false;
+  }
+
+  bool found = false;
+  uint64_t minimum = UINT64_MAX;
+  do {
+    uint64_t value = 0;
+    bool unlimited = false;
+    if (BuildCgroupFilePath(path.get(), PATH_MAX, root, current.get(), file) &&
+        ReadCgroupValue(path.get(), &value, &unlimited) && !unlimited && value != 0) {
+      if (value < minimum) minimum = value;
+      found = true;
+    }
+  } while (ParentCgroupPath(current.get()));
+
+  if (!found) return false;
+  *limit = minimum;
+  return true;
+}
+
+bool ReadCgroupV2Memory(const char* cgroup, FloralCgroupMemory* memory) {
+  FloralPathBuffer path;
+  if (!path.valid()) return false;
+  bool swap_unlimited = false;
+
+  if (!ReadCgroupLimit("/sys/fs/cgroup", cgroup, "memory.max", &memory->total_bytes)) {
+    return false;
+  }
+  bool current_unlimited = false;
+  if (!BuildCgroupFilePath(path.get(), PATH_MAX, "/sys/fs/cgroup", cgroup, "memory.current") ||
+      !ReadCgroupValue(path.get(), &memory->current_bytes, &current_unlimited) ||
+      current_unlimited) {
+    return false;
+  }
+
+  if (BuildCgroupFilePath(path.get(), PATH_MAX, "/sys/fs/cgroup", cgroup, "memory.swap.max") &&
+      ReadCgroupValue(path.get(), &memory->swap_total_bytes, &swap_unlimited) &&
+      !swap_unlimited &&
+      BuildCgroupFilePath(path.get(), PATH_MAX, "/sys/fs/cgroup", cgroup,
+                          "memory.swap.current")) {
+    bool current_unlimited = false;
+    if (!ReadCgroupValue(path.get(), &memory->swap_current_bytes, &current_unlimited) ||
+        current_unlimited) {
+      memory->swap_total_bytes = 0;
+      memory->swap_current_bytes = 0;
+    }
+  } else {
+    memory->swap_total_bytes = 0;
+    memory->swap_current_bytes = 0;
+  }
+  memory->valid = true;
+  return true;
+}
+
+bool ReadCgroupV1Memory(const char* cgroup, FloralCgroupMemory* memory) {
+  constexpr char kRoot[] = "/sys/fs/cgroup/memory";
+  FloralPathBuffer path;
+  if (!path.valid()) return false;
+  bool unlimited = false;
+
+  if (!ReadCgroupLimit(kRoot, cgroup, "memory.limit_in_bytes", &memory->total_bytes)) {
+    return false;
+  }
+  if (!BuildCgroupFilePath(path.get(), PATH_MAX, kRoot, cgroup, "memory.usage_in_bytes") ||
+      !ReadCgroupValue(path.get(), &memory->current_bytes, &unlimited) || unlimited) {
+    return false;
+  }
+
+  uint64_t memory_and_swap_limit = 0;
+  uint64_t memory_and_swap_usage = 0;
+  if (BuildCgroupFilePath(path.get(), PATH_MAX, kRoot, cgroup, "memory.memsw.limit_in_bytes") &&
+      ReadCgroupValue(path.get(), &memory_and_swap_limit, &unlimited) && !unlimited &&
+      BuildCgroupFilePath(path.get(), PATH_MAX, kRoot, cgroup,
+                          "memory.memsw.usage_in_bytes") &&
+      ReadCgroupValue(path.get(), &memory_and_swap_usage, &unlimited) && !unlimited) {
+    memory->swap_total_bytes = memory_and_swap_limit > memory->total_bytes
+                                   ? memory_and_swap_limit - memory->total_bytes
+                                   : 0;
+    memory->swap_current_bytes = memory_and_swap_usage > memory->current_bytes
+                                     ? memory_and_swap_usage - memory->current_bytes
+                                     : 0;
+  }
+  memory->valid = true;
+  return true;
+}
+
+FloralCgroupMemory ReadFloralCgroupMemory() {
+  FloralCgroupMemory memory;
+  FloralPathBuffer unified_path;
+  FloralPathBuffer memory_path;
+  if (!unified_path.valid() || !memory_path.valid() ||
+      !ReadSelfCgroupPaths(unified_path.get(), PATH_MAX, memory_path.get(), PATH_MAX)) {
+    return memory;
+  }
+
+  if (unified_path.get()[0] != '\0' && ReadCgroupV2Memory(unified_path.get(), &memory)) {
+    return memory;
+  }
+  if (memory_path.get()[0] != '\0') ReadCgroupV1Memory(memory_path.get(), &memory);
+  return memory;
+}
+
+bool ApplyFloralCgroupMemory(struct sysinfo* info) {
+  FloralCgroupMemory memory = ReadFloralCgroupMemory();
+  if (!memory.valid) return false;
+
+  const unsigned int unit = info->mem_unit == 0 ? 1 : info->mem_unit;
+  const uint64_t host_total = static_cast<uint64_t>(info->totalram) * unit;
+  if (host_total != 0 && memory.total_bytes > host_total) memory.total_bytes = host_total;
+  if (memory.current_bytes > memory.total_bytes) memory.current_bytes = memory.total_bytes;
+  if (memory.swap_current_bytes > memory.swap_total_bytes) {
+    memory.swap_current_bytes = memory.swap_total_bytes;
+  }
+
+  info->totalram = BytesToSysinfoUnits(memory.total_bytes, unit);
+  info->freeram = BytesToSysinfoUnits(memory.total_bytes - memory.current_bytes, unit);
+  info->sharedram = 0;
+  info->bufferram = 0;
+  info->totalswap = BytesToSysinfoUnits(memory.swap_total_bytes, unit);
+  info->freeswap = BytesToSysinfoUnits(memory.swap_total_bytes - memory.swap_current_bytes, unit);
+  info->totalhigh = 0;
+  info->freehigh = 0;
+  return true;
+}
+
+FloralMeminfo ReadFloralMeminfo() {
+  FloralMeminfo memory;
+  FILE* file = fopen("/proc/meminfo", "re");
+  if (file == nullptr) return memory;
+
+  char* line = nullptr;
+  size_t capacity = 0;
+  while (getline(&line, &capacity, file) != -1) {
+    uint64_t value = 0;
+    if (sscanf(line, "MemTotal: %" SCNu64 " kB", &value) == 1) {
+      memory.total_kb = value;
+      memory.valid = true;
+    } else if (sscanf(line, "MemFree: %" SCNu64 " kB", &value) == 1) {
+      memory.free_kb = value;
+    } else if (sscanf(line, "Buffers: %" SCNu64 " kB", &value) == 1) {
+      memory.buffers_kb = value;
+    } else if (sscanf(line, "Shmem: %" SCNu64 " kB", &value) == 1) {
+      memory.shared_kb = value;
+    } else if (sscanf(line, "SwapTotal: %" SCNu64 " kB", &value) == 1) {
+      memory.swap_total_kb = value;
+    } else if (sscanf(line, "SwapFree: %" SCNu64 " kB", &value) == 1) {
+      memory.swap_free_kb = value;
+    }
+  }
+  free(line);
+  fclose(file);
+  return memory;
+}
+
+void ApplyFloralProcView(struct sysinfo* info) {
+  if (!ApplyFloralCgroupMemory(info)) {
+    const FloralMeminfo memory = ReadFloralMeminfo();
+    if (memory.valid) {
+      const unsigned int unit = info->mem_unit == 0 ? 1 : info->mem_unit;
+      info->totalram = ToSysinfoUnits(memory.total_kb, unit);
+      info->freeram = ToSysinfoUnits(memory.free_kb, unit);
+      info->bufferram = ToSysinfoUnits(memory.buffers_kb, unit);
+      info->sharedram = ToSysinfoUnits(memory.shared_kb, unit);
+      info->totalswap = ToSysinfoUnits(memory.swap_total_kb, unit);
+      info->freeswap = ToSysinfoUnits(memory.swap_free_kb, unit);
+      info->totalhigh = 0;
+      info->freehigh = 0;
+    }
+  }
+
+  FILE* file = fopen("/proc/uptime", "re");
+  if (file != nullptr) {
+    double uptime = 0;
+    if (fscanf(file, "%lf", &uptime) == 1 && uptime >= 0) {
+      info->uptime = static_cast<long>(uptime);
+    }
+    fclose(file);
+  }
+
+  file = fopen("/proc/loadavg", "re");
+  if (file != nullptr) {
+    double load[3] = {};
+    if (fscanf(file, "%lf %lf %lf", &load[0], &load[1], &load[2]) == 3) {
+      for (size_t i = 0; i < 3; ++i) {
+        info->loads[i] = static_cast<unsigned long>(load[i] * (1 << SI_LOAD_SHIFT));
+      }
+    }
+    fclose(file);
+  }
+}
+
+}  // namespace
+
+extern "C" int sysinfo(struct sysinfo* info) {
+  const int result = __sysinfo(info);
+  if (result == 0 && info != nullptr) {
+    // Prefer the current memory cgroup so direct libc queries stay container-scoped.
+    // Fall back to procfs for kernels without readable cgroup memory limits.
+    ApplyFloralProcView(info);
+  }
+  return result;
+}
 
