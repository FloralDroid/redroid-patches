diff --git a/libc/bionic/floral_nativebridge.cpp b/libc/bionic/floral_nativebridge.cpp
new file mode 100644
index 0000000..5e31a8c
--- /dev/null
+++ b/libc/bionic/floral_nativebridge.cpp
@@ -0,0 +1,127 @@
+/*
+ * Copyright 2026 FloralDroid
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+#include "private/floral_nativebridge.h"
+
+#include <sys/system_properties.h>
+
+#include <string.h>
+
+#include "private/bionic_defs.h"
+
+namespace {
+
+int g_floral_nativebridge_guest_arch = FLORAL_NATIVEBRIDGE_GUEST_NONE;
+constexpr size_t kUtsnameFieldLength = 64;
+constexpr char kDefaultGuestKernelRelease[] = "5.10.66-android12-9";
+constexpr char kDefaultGuestKernelVersion[] = "#1 SMP PREEMPT";
+char g_floral_nativebridge_kernel_release[kUtsnameFieldLength + 1] = {};
+char g_floral_nativebridge_kernel_version[kUtsnameFieldLength + 1] = {};
+
+void LoadKernelIdentity() {
+  char value[PROP_VALUE_MAX] = {};
+  if (__system_property_get("ro.boot.floral_kernel_release", value) > 0 &&
+      strlen(value) <= kUtsnameFieldLength) {
+    strlcpy(g_floral_nativebridge_kernel_release, value,
+            sizeof(g_floral_nativebridge_kernel_release));
+  }
+
+  memset(value, 0, sizeof(value));
+  if (__system_property_get("ro.boot.floral_kernel_version", value) > 0 &&
+      strlen(value) <= kUtsnameFieldLength) {
+    strlcpy(g_floral_nativebridge_kernel_version, value,
+            sizeof(g_floral_nativebridge_kernel_version));
+  }
+}
+
+void ClearKernelIdentity() {
+  g_floral_nativebridge_kernel_release[0] = '\0';
+  g_floral_nativebridge_kernel_version[0] = '\0';
+}
+
+struct PropertyOverride {
+  const char* name;
+  const char* arm;
+  const char* arm64;
+};
+
+constexpr PropertyOverride kPropertyOverrides[] = {
+    {"ro.product.cpu.abi", "armeabi-v7a", "arm64-v8a"},
+    {"ro.product.cpu.abi2", "armeabi", ""},
+    {"ro.product.cpu.abilist", "armeabi-v7a,armeabi", "arm64-v8a,armeabi-v7a,armeabi"},
+    {"ro.product.cpu.abilist32", "armeabi-v7a,armeabi", "armeabi-v7a,armeabi"},
+    {"ro.product.cpu.abilist64", "", "arm64-v8a"},
+    {"ro.dalvik.vm.isa.arm", "arm", "arm"},
+    {"ro.dalvik.vm.isa.arm64", "arm64", "arm64"},
+    {"ro.floral.nb.pubabi", "armeabi-v7a,armeabi", "arm64-v8a,armeabi-v7a,armeabi"},
+    {"ro.floral.nb.pubabi32", "armeabi-v7a,armeabi", "armeabi-v7a,armeabi"},
+    {"ro.floral.nb.pubabi64", "", "arm64-v8a"},
+    {"ro.floral.nb.loadabi", "armeabi-v7a,armeabi", "arm64-v8a,armeabi-v7a,armeabi"},
+    {"ro.floral.nb.loadabi32", "armeabi-v7a,armeabi", "armeabi-v7a,armeabi"},
+    {"ro.floral.nb.loadabi64", "", "arm64-v8a"},
+};
+
+}  // namespace
+
+extern "C" void __floral_nativebridge_set_guest_arch(int arch) {
+  if (arch < FLORAL_NATIVEBRIDGE_GUEST_NONE || arch > FLORAL_NATIVEBRIDGE_GUEST_ARM64) {
+    arch = FLORAL_NATIVEBRIDGE_GUEST_NONE;
+  }
+  if (arch == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+    ClearKernelIdentity();
+  } else {
+    LoadKernelIdentity();
+  }
+  __atomic_store_n(&g_floral_nativebridge_guest_arch, arch, __ATOMIC_RELEASE);
+}
+
+extern "C" __LIBC_HIDDEN__ int __floral_nativebridge_guest_arch() {
+  return __atomic_load_n(&g_floral_nativebridge_guest_arch, __ATOMIC_ACQUIRE);
+}
+
+extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_machine() {
+  switch (__floral_nativebridge_guest_arch()) {
+    case FLORAL_NATIVEBRIDGE_GUEST_ARM:
+      return "armv7l";
+    case FLORAL_NATIVEBRIDGE_GUEST_ARM64:
+      return "aarch64";
+    default:
+      return nullptr;
+  }
+}
+
+extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_kernel_release() {
+  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+    return nullptr;
+  }
+  return g_floral_nativebridge_kernel_release[0] == '\0' ? kDefaultGuestKernelRelease
+                                                         : g_floral_nativebridge_kernel_release;
+}
+
+extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_guest_kernel_version() {
+  if (__floral_nativebridge_guest_arch() == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+    return nullptr;
+  }
+  return g_floral_nativebridge_kernel_version[0] == '\0' ? kDefaultGuestKernelVersion
+                                                         : g_floral_nativebridge_kernel_version;
+}
+
+extern "C" __LIBC_HIDDEN__ const char* __floral_nativebridge_property_override(const char* name) {
+  if (name == nullptr) {
+    return nullptr;
+  }
+  const int arch = __floral_nativebridge_guest_arch();
+  if (arch == FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+    return nullptr;
+  }
+  for (const PropertyOverride& property : kPropertyOverrides) {
+    if (strcmp(name, property.name) == 0) {
+      return arch == FLORAL_NATIVEBRIDGE_GUEST_ARM64 ? property.arm64 : property.arm;
+    }
+  }
+  return nullptr;
+}
diff --git a/libc/bionic/getauxval.cpp b/libc/bionic/getauxval.cpp
index a3c6b19..312f782 100644
--- a/libc/bionic/getauxval.cpp
+++ b/libc/bionic/getauxval.cpp
@@ -35,6 +35,41 @@
 #include <elf.h>
 #include <errno.h>
 
+#include "private/floral_nativebridge.h"
+
+namespace {
+
+constexpr unsigned long kArm64BaselineHwcap = (1UL << 0) | (1UL << 1);  // FP, ASIMD.
+constexpr unsigned long kArmBaselineHwcap =
+    (1UL << 0) | (1UL << 1) | (1UL << 2) | (1UL << 4) | (1UL << 6) |
+    (1UL << 7) | (1UL << 12) | (1UL << 13) | (1UL << 15) | (1UL << 16) |
+    (1UL << 17) | (1UL << 18);  // ARMv7 with VFPv4, NEON and integer divide.
+
+unsigned long FloralGuestAuxValue(unsigned long type, int arch, bool* exists) {
+  static const char kArmPlatform[] = "v7l";
+  static const char kArm64Platform[] = "aarch64";
+
+  *exists = false;
+  switch (type) {
+    case AT_PLATFORM:
+    case AT_BASE_PLATFORM:
+      *exists = true;
+      return reinterpret_cast<unsigned long>(
+          arch == FLORAL_NATIVEBRIDGE_GUEST_ARM64 ? kArm64Platform : kArmPlatform);
+    case AT_HWCAP:
+      *exists = true;
+      return arch == FLORAL_NATIVEBRIDGE_GUEST_ARM64 ? kArm64BaselineHwcap
+                                                      : kArmBaselineHwcap;
+    case AT_HWCAP2:
+      *exists = true;
+      return 0;
+    default:
+      return 0;
+  }
+}
+
+}  // namespace
+
 // This function needs to be safe to call before TLS is set up, so it can't
 // access errno or the stack protector.
 __LIBC_HIDDEN__ unsigned long __bionic_getauxval(unsigned long type, bool* exists) {
@@ -50,7 +85,16 @@ __LIBC_HIDDEN__ unsigned long __bionic_getauxval(unsigned long type, bool* exist
 
 extern "C" unsigned long getauxval(unsigned long type) {
   bool exists;
-  unsigned long result = __bionic_getauxval(type, &exists);
+  unsigned long result = 0;
+  const int guest_arch = __floral_nativebridge_guest_arch();
+  if (guest_arch != FLORAL_NATIVEBRIDGE_GUEST_NONE) {
+    result = FloralGuestAuxValue(type, guest_arch, &exists);
+  } else {
+    exists = false;
+  }
+  if (!exists) {
+    result = __bionic_getauxval(type, &exists);
+  }
   if (!exists) errno = ENOENT;
   return result;
 }
diff --git a/libc/bionic/sysinfo.cpp b/libc/bionic/sysinfo.cpp
index 7ab8e9e..d5ad347 100644
--- a/libc/bionic/sysinfo.cpp
+++ b/libc/bionic/sysinfo.cpp
@@ -29,12 +29,113 @@
 #include <sys/sysinfo.h>
 
 #include <dirent.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <stdint.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
 #include <unistd.h>
 
-#include "private/get_cpu_count_from_string.h"
 #include "private/ScopedReaddir.h"
+#include "private/get_cpu_count_from_string.h"
+
+extern "C" int __sysinfo(struct sysinfo*);
+
+namespace {
+
+struct FloralMeminfo {
+  uint64_t total_kb = 0;
+  uint64_t free_kb = 0;
+  uint64_t buffers_kb = 0;
+  uint64_t shared_kb = 0;
+  uint64_t swap_total_kb = 0;
+  uint64_t swap_free_kb = 0;
+  bool valid = false;
+};
+
+unsigned long ToSysinfoUnits(uint64_t kibibytes, unsigned int unit) {
+  if (unit == 0) unit = 1;
+  if (kibibytes > UINT64_MAX / 1024) return ULONG_MAX;
+  const uint64_t value = kibibytes * 1024 / unit;
+  return value > ULONG_MAX ? ULONG_MAX : static_cast<unsigned long>(value);
+}
+
+FloralMeminfo ReadFloralMeminfo() {
+  FloralMeminfo memory;
+  FILE* file = fopen("/proc/meminfo", "re");
+  if (file == nullptr) return memory;
+
+  char* line = nullptr;
+  size_t capacity = 0;
+  while (getline(&line, &capacity, file) != -1) {
+    uint64_t value = 0;
+    if (sscanf(line, "MemTotal: %" SCNu64 " kB", &value) == 1) {
+      memory.total_kb = value;
+      memory.valid = true;
+    } else if (sscanf(line, "MemFree: %" SCNu64 " kB", &value) == 1) {
+      memory.free_kb = value;
+    } else if (sscanf(line, "Buffers: %" SCNu64 " kB", &value) == 1) {
+      memory.buffers_kb = value;
+    } else if (sscanf(line, "Shmem: %" SCNu64 " kB", &value) == 1) {
+      memory.shared_kb = value;
+    } else if (sscanf(line, "SwapTotal: %" SCNu64 " kB", &value) == 1) {
+      memory.swap_total_kb = value;
+    } else if (sscanf(line, "SwapFree: %" SCNu64 " kB", &value) == 1) {
+      memory.swap_free_kb = value;
+    }
+  }
+  free(line);
+  fclose(file);
+  return memory;
+}
+
+void ApplyFloralProcView(struct sysinfo* info) {
+  const FloralMeminfo memory = ReadFloralMeminfo();
+  if (memory.valid) {
+    const unsigned int unit = info->mem_unit == 0 ? 1 : info->mem_unit;
+    info->totalram = ToSysinfoUnits(memory.total_kb, unit);
+    info->freeram = ToSysinfoUnits(memory.free_kb, unit);
+    info->bufferram = ToSysinfoUnits(memory.buffers_kb, unit);
+    info->sharedram = ToSysinfoUnits(memory.shared_kb, unit);
+    info->totalswap = ToSysinfoUnits(memory.swap_total_kb, unit);
+    info->freeswap = ToSysinfoUnits(memory.swap_free_kb, unit);
+    info->totalhigh = 0;
+    info->freehigh = 0;
+  }
+
+  FILE* file = fopen("/proc/uptime", "re");
+  if (file != nullptr) {
+    double uptime = 0;
+    if (fscanf(file, "%lf", &uptime) == 1 && uptime >= 0) {
+      info->uptime = static_cast<long>(uptime);
+    }
+    fclose(file);
+  }
+
+  file = fopen("/proc/loadavg", "re");
+  if (file != nullptr) {
+    double load[3] = {};
+    if (fscanf(file, "%lf %lf %lf", &load[0], &load[1], &load[2]) == 3) {
+      for (size_t i = 0; i < 3; ++i) {
+        info->loads[i] = static_cast<unsigned long>(load[i] * (1 << SI_LOAD_SHIFT));
+      }
+    }
+    fclose(file);
+  }
+}
+
+}  // namespace
+
+extern "C" int sysinfo(struct sysinfo* info) {
+  const int result = __sysinfo(info);
+  if (result == 0 && info != nullptr) {
+    // Keep direct libc queries consistent with the current procfs namespace.
+    // Without Floral LXCFS these files contain the same host values as the syscall.
+    ApplyFloralProcView(info);
+  }
+  return result;
+}
 
 static bool __matches_cpuN(const char* s) {
   // The %c trick is to ensure that we have the anchored match "^cpu[0-9]+$".
diff --git a/libc/bionic/system_property_api.cpp b/libc/bionic/system_property_api.cpp
index a641f12..0bbd875 100644
--- a/libc/bionic/system_property_api.cpp
+++ b/libc/bionic/system_property_api.cpp
@@ -29,10 +29,13 @@
 #define _REALLY_INCLUDE_SYS__SYSTEM_PROPERTIES_H_
 #include <sys/_system_properties.h>
 
+#include <string.h>
+
 #include <system_properties/prop_area.h>
 #include <system_properties/system_properties.h>
 
 #include "private/bionic_defs.h"
+#include "private/floral_nativebridge.h"
 
 static SystemProperties system_properties;
 static_assert(__is_trivially_constructible(SystemProperties),
@@ -71,7 +74,17 @@ const prop_info* __system_property_find(const char* name) {
 
 __BIONIC_WEAK_FOR_NATIVE_BRIDGE
 int __system_property_read(const prop_info* pi, char* name, char* value) {
-  return system_properties.Read(pi, name, value);
+  char local_name[PROP_NAME_MAX];
+  char* property_name = name == nullptr ? local_name : name;
+  const int result = system_properties.Read(pi, property_name, value);
+  if (result < 0) {
+    return result;
+  }
+  const char* override = __floral_nativebridge_property_override(property_name);
+  if (override == nullptr) {
+    return result;
+  }
+  return static_cast<int>(strlcpy(value, override, PROP_VALUE_MAX));
 }
 
 __BIONIC_WEAK_FOR_NATIVE_BRIDGE
@@ -79,11 +92,26 @@ void __system_property_read_callback(const prop_info* pi,
                                      void (*callback)(void* cookie, const char* name,
                                                       const char* value, uint32_t serial),
                                      void* cookie) {
-  return system_properties.ReadCallback(pi, callback, cookie);
+  char name[PROP_NAME_MAX];
+  char value[PROP_VALUE_MAX];
+  if (system_properties.Read(pi, name, value) < 0) {
+    system_properties.ReadCallback(pi, callback, cookie);
+    return;
+  }
+  const char* override = __floral_nativebridge_property_override(name);
+  if (override == nullptr) {
+    system_properties.ReadCallback(pi, callback, cookie);
+    return;
+  }
+  callback(cookie, name, override, atomic_load_explicit(&pi->serial, memory_order_acquire));
 }
 
 __BIONIC_WEAK_FOR_NATIVE_BRIDGE
 int __system_property_get(const char* name, char* value) {
+  const char* override = __floral_nativebridge_property_override(name);
+  if (override != nullptr) {
+    return static_cast<int>(strlcpy(value, override, PROP_VALUE_MAX));
+  }
   return system_properties.Get(name, value);
 }
 
diff --git a/libc/bionic/uname.cpp b/libc/bionic/uname.cpp
new file mode 100644
index 0000000..a989278
--- /dev/null
+++ b/libc/bionic/uname.cpp
@@ -0,0 +1,31 @@
+/*
+ * Copyright 2026 FloralDroid
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+#include <sys/utsname.h>
+
+#include <string.h>
+
+#include "private/floral_nativebridge.h"
+
+extern "C" int __uname(utsname*);
+
+extern "C" int uname(utsname* buffer) {
+  const int result = __uname(buffer);
+  const char* machine = __floral_nativebridge_guest_machine();
+  if (result == 0 && machine != nullptr) {
+    strlcpy(buffer->machine, machine, sizeof(buffer->machine));
+    const char* release = __floral_nativebridge_guest_kernel_release();
+    if (release != nullptr) {
+      strlcpy(buffer->release, release, sizeof(buffer->release));
+    }
+    const char* version = __floral_nativebridge_guest_kernel_version();
+    if (version != nullptr) {
+      strlcpy(buffer->version, version, sizeof(buffer->version));
+    }
+  }
+  return result;
+}
