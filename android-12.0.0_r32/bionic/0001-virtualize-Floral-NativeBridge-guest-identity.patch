diff --git a/libc/private/floral_nativebridge.h b/libc/private/floral_nativebridge.h
new file mode 100644
index 0000000..8406f96
--- /dev/null
+++ b/libc/private/floral_nativebridge.h
@@ -0,0 +1,30 @@
+/*
+ * Copyright 2026 FloralDroid
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+#pragma once
+
+#include <sys/cdefs.h>
+
+enum FloralNativeBridgeGuestArch {
+  FLORAL_NATIVEBRIDGE_GUEST_NONE = 0,
+  FLORAL_NATIVEBRIDGE_GUEST_ARM = 1,
+  FLORAL_NATIVEBRIDGE_GUEST_ARM64 = 2,
+};
+
+__BEGIN_DECLS
+
+// Called by Floral's NativeBridge router in the forked application process.
+void __floral_nativebridge_set_guest_arch(int arch);
+
+// Internal libc accessors used by architecture-reporting APIs.
+int __floral_nativebridge_guest_arch();
+const char* __floral_nativebridge_guest_machine();
+const char* __floral_nativebridge_guest_kernel_release();
+const char* __floral_nativebridge_guest_kernel_version();
+const char* __floral_nativebridge_property_override(const char* name);
+
+__END_DECLS
