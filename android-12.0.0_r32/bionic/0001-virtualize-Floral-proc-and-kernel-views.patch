+ * you may not use this file except in compliance with the License.
+ */
+
+#include <sys/utsname.h>
+#include <sys/system_properties.h>
+
+#include <string.h>
+
+extern "C" int __uname(utsname*);
+
+namespace {
+
+constexpr char kDefaultKernelRelease[] = "5.10.66-android12-9";
+constexpr char kDefaultKernelVersion[] = "#1 SMP PREEMPT";
+
+void CopyProperty(const char* name, const char* fallback, char* destination) {
+  char value[PROP_VALUE_MAX] = {};
+  const char* source = __system_property_get(name, value) > 0 ? value : fallback;
+  strlcpy(destination, source, SYS_NMLN);
+}
+
+}  // namespace
+
+extern "C" int uname(utsname* buffer) {
+  const int result = __uname(buffer);
+  if (result != 0 || buffer == nullptr) {
+    return result;
+  }
+
+  // Keep direct libc uname() aligned with the container profile.
+  CopyProperty("ro.boot.floral_kernel_release", kDefaultKernelRelease, buffer->release);
+  CopyProperty("ro.boot.floral_kernel_version", kDefaultKernelVersion, buffer->version);
+  return result;
+}
