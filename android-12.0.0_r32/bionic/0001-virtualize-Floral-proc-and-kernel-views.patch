+extern "C" __LIBC_HIDDEN__ bool __floral_procview_enabled() {
+  char value[PROP_VALUE_MAX] = {};
+  const int length = __system_property_get(kProcViewProperty, value);
+  if (length <= 0) return true;
+  return strcmp(value, "1") == 0 || strcmp(value, "true") == 0 ||
+         strcmp(value, "TRUE") == 0 || strcmp(value, "y") == 0 ||
+         strcmp(value, "yes") == 0;
+}
diff --git a/libc/bionic/sysinfo.cpp b/libc/bionic/sysinfo.cpp
index 7ab8e9eda..3f386cf8f 100644
--- a/libc/bionic/sysinfo.cpp
+++ b/libc/bionic/sysinfo.cpp
@@ -29,12 +29,412 @@
 #include <sys/sysinfo.h>
 
 #include <dirent.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <limits.h>
