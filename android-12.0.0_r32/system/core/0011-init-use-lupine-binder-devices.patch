From 17f177445a658bd77372087f5c41db87997c6040 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Fri, 2 Oct 2026 12:44:26 +0800
Subject: [PATCH] init: use Binder devices provided by Lupine

Lupine creates a private binderfs for each Android space and allows only
its assigned Binder device numbers through the OCI device policy.

Mounting another binderfs during Android init hides those devices and
makes Binder access fail with EPERM. Use the runtime-provided devices
while retaining the existing symlinks and permissions.

This patch belongs to the Lupine patch branch. The legacy Redroid patch
series keeps its existing Binder initialization behavior.

Change-Id: I0d98f31e38d8b688ce8d34ef1476b4f02247e03c
---
 rootdir/init.rc | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index 5dbc6c0..50a1cbd 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -227,11 +227,9 @@ on init
     chmod 0770 /config/sdcardfs
     chown system package_info /config/sdcardfs
 
-    # Mount binderfs
+    # Binder devices are provided by the Lupine runtime.
     mkdir /dev/binderfs
-    mount binder binder /dev/binderfs stats=global
     chmod 0755 /dev/binderfs
-    exec -- /vendor/bin/binder_alloc /dev/binderfs/binder-control binder hwbinder vndbinder
 
     # Mount fusectl
 
-- 
