From 6fe5639b9793d697391d9ea07ea41dd162f5db2b Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Thu, 20 Aug 2026 01:32:45 +0800
Subject: [PATCH] init: add Floral ABI virtualization switch

Change-Id: Iac68d6d0a3d99eda8cff0cb976d7b66ff9e9d6fa
---
 init/floral_nativebridge_config.cpp      | 12 +++++++++++-
 init/floral_nativebridge_config_test.cpp | 10 ++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/init/floral_nativebridge_config.cpp b/init/floral_nativebridge_config.cpp
index f78c416b0..5b45e6a86 100644
--- a/init/floral_nativebridge_config.cpp
+++ b/init/floral_nativebridge_config.cpp
@@ -90,6 +90,13 @@ std::string PropertyOrDefault(const std::map<std::string, std::string>& properti
     return std::string(fallback);
 }
 
+bool PropertyEnabled(const std::map<std::string, std::string>& properties,
+                     std::string_view name, bool default_value) {
+    const std::string value = PropertyOrDefault(
+            properties, name, default_value ? "1" : "0");
+    return value != "0" && value != "false" && value != "FALSE" && value != "no";
+}
+
 }  // namespace
 
 FloralNativeBridgeConfig DefaultFloralNativeBridgeConfig() {
@@ -182,7 +189,10 @@ std::map<std::string, std::string> FloralNativeBridgeConfigProperties(
             build_properties, "ro.product.cpu.abilist32", "x86,armeabi-v7a,armeabi");
     const std::string loader_abilist64 = PropertyOrDefault(
             build_properties, "ro.product.cpu.abilist64", "x86_64,arm64-v8a");
-    const bool virtualize_public_abis =
+    const bool abi_virtualization_enabled =
+            !PropertyEnabled(build_properties, "ro.floral.bridge.compat_aosp", false) &&
+            PropertyEnabled(build_properties, "ro.floral.bridge.abi_virtualization", true);
+    const bool virtualize_public_abis = abi_virtualization_enabled &&
             PropertyOrDefault(build_properties, "ro.dalvik.vm.native.bridge", "") ==
             "libmixbridge.so";
     const std::string public_abilist = virtualize_public_abis
diff --git a/init/floral_nativebridge_config_test.cpp b/init/floral_nativebridge_config_test.cpp
index 4ba25cc65..d88c9d81e 100644
--- a/init/floral_nativebridge_config_test.cpp
+++ b/init/floral_nativebridge_config_test.cpp
@@ -69,6 +69,16 @@ TEST(FloralNativeBridgeConfig, KeepsLoaderViewSeparate) {
     build.erase("ro.dalvik.vm.native.bridge");
     const auto native_properties = FloralNativeBridgeConfigProperties(config, build);
     EXPECT_EQ(native_properties.at("ro.floral.nb.pubabi"), "x86_64,arm64-v8a");
+
+    build["ro.dalvik.vm.native.bridge"] = "libmixbridge.so";
+    build["ro.floral.bridge.abi_virtualization"] = "0";
+    const auto disabled_properties = FloralNativeBridgeConfigProperties(config, build);
+    EXPECT_EQ(disabled_properties.at("ro.floral.nb.pubabi"), "x86_64,arm64-v8a");
+
+    build.erase("ro.floral.bridge.abi_virtualization");
+    build["ro.floral.bridge.compat_aosp"] = "1";
+    const auto compat_properties = FloralNativeBridgeConfigProperties(config, build);
+    EXPECT_EQ(compat_properties.at("ro.floral.nb.pubabi"), "x86_64,arm64-v8a");
 }
 
 }  // namespace init
-- 
2.47.3

