+
+#include "floral_nativebridge_config.h"
+
+#include <gtest/gtest.h>
+
+namespace android {
+namespace init {
+
+TEST(FloralNativeBridgeConfig, ParsesPreferredBackendAndPublicAbis) {
+    const auto config = ParseFloralNativeBridgeConfig(R"({
+        "version": 1,
+        "preferred_backend": "houdini",
+        "abi": {"public": {"64": ["arm64-v8a"], "32": ["armeabi-v7a", "armeabi"]}},
+        "packages": {}
+    })");
+    ASSERT_TRUE(config.ok()) << config.error();
+    EXPECT_EQ(config->public_abis64, std::vector<std::string>({"arm64-v8a"}));
+    EXPECT_EQ(config->public_abis32,
+              std::vector<std::string>({"armeabi-v7a", "armeabi"}));
+    EXPECT_NE(config->policy_json.find("preferred_backend"), std::string::npos);
+}
+
+TEST(FloralNativeBridgeConfig, RejectsInvalidAbi) {
+    const auto config = ParseFloralNativeBridgeConfig(R"({
+        "version": 1,
+        "default_backend": "ndk",
+        "abi": {"public": {"64": ["mips64"]}}
+    })");
+    EXPECT_FALSE(config.ok());
+}
+
+TEST(FloralNativeBridgeConfig, RejectsNonSpecificPreferredBackend) {
+    const auto config = ParseFloralNativeBridgeConfig(R"({
+        "version": 1,
+        "preferred_backend": "auto"
+    })");
+    EXPECT_FALSE(config.ok());
+}
+
+TEST(FloralNativeBridgeConfig, KeepsLoaderViewSeparate) {
+    const auto config = DefaultFloralNativeBridgeConfig();
+    std::map<std::string, std::string> build = {
+            {"ro.product.cpu.abilist", "x86_64,arm64-v8a"},
+            {"ro.product.cpu.abilist32", "x86,armeabi-v7a"},
+            {"ro.product.cpu.abilist64", "x86_64,arm64-v8a"},
+            {"ro.dalvik.vm.native.bridge", "libmixbridge.so"},
+    };
+    const auto properties = FloralNativeBridgeConfigProperties(config, build);
+    EXPECT_EQ(properties.at("ro.floral.nb.loadabi"),
+              "x86_64,arm64-v8a");
+    EXPECT_EQ(properties.at("ro.floral.nb.pubabi"),
+              "arm64-v8a,armeabi-v7a,armeabi");
+
+    build.erase("ro.dalvik.vm.native.bridge");
+    const auto native_properties = FloralNativeBridgeConfigProperties(config, build);
+    EXPECT_EQ(native_properties.at("ro.floral.nb.pubabi"), "x86_64,arm64-v8a");
+}
+
+}  // namespace init
+}  // namespace android
