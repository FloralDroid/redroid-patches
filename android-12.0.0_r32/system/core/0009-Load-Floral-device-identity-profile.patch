+namespace android {
+namespace init {
+
+struct FloralDeviceProfile {
+    std::string brand;
+    std::string manufacturer;
+    std::string model;
+    std::string device;
+    std::string product;
+    std::string soc_manufacturer;
+    std::string soc_model;
