+#include "floral_device_profile.h"
+
+#include <sys/stat.h>
+
+#include <array>
+#include <cctype>
+#include <cerrno>
+#include <map>
+#include <string>
+
+#include <android-base/file.h>
+#include <android-base/result.h>
+#include <android-base/strings.h>
+
+#include "util.h"
+
+namespace android {
+namespace init {
+namespace {
+
+constexpr size_t kMaximumProfileSize = 4096;
+constexpr size_t kMaximumIdentityLength = 64;
+constexpr size_t kMaximumIdentifierLength = 32;
+constexpr size_t kMaximumKernelFieldLength = 64;
+constexpr size_t kMaximumHardwareFieldLength = 64;
+
+constexpr std::array<std::string_view, 15> kRequiredFields = {
+        "version",   "brand",    "manufacturer",     "model",           "device",
+        "product",   "board",    "soc_manufacturer", "soc_model",       "gpu_vendor",
+        "gpu_model", "build_id", "build_display",    "version_release", "security_patch",
+};
+
+bool IsRequiredField(std::string_view key) {
+    for (std::string_view required : kRequiredFields) {
+        if (key == required) return true;
+    }
+    return false;
+}
+
+bool IsKnownField(std::string_view key) {
+    return IsRequiredField(key) || key == "build_description" || key == "build_flavor" ||
+           key == "kernel_release" || key == "kernel_version" || key == "memory_type" ||
+           key == "memory_frequency" || key == "memory_channel" || key == "serial" ||
+           key == "hardware_revision";
+}
+
+bool IsPropertyTextValid(const std::string& property, const std::string& value) {
+    if (value.empty() || !IsLegalPropertyValue(property, value).ok()) {
+        return false;
+    }
+    for (unsigned char character : value) {
+        if (std::iscntrl(character)) return false;
+    }
+    return true;
+}
+
+bool IsDisplayValueValid(const std::string& value) {
+    return value.size() <= kMaximumIdentityLength && IsPropertyTextValid("ro.product.model", value);
+}
+
+bool IsVersionReleaseValid(const std::string& value) {
+    return value.size() <= kMaximumIdentityLength &&
+           IsPropertyTextValid("ro.build.version.release", value);
+}
+
+bool IsIdentifierValid(const std::string& value) {
+    if (value.empty() || value.size() > kMaximumIdentifierLength ||
+        !std::isalnum(static_cast<unsigned char>(value.front()))) {
+        return false;
+    }
+    for (unsigned char character : value) {
+        if (!std::isalnum(character) && character != '_' && character != '-' && character != '.') {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool IsSecurityPatchValid(std::string_view value) {
+    if (value.size() != 10 || value[4] != '-' || value[7] != '-') return false;
+    for (size_t index = 0; index < value.size(); ++index) {
+        if (index == 4 || index == 7) continue;
+        if (!std::isdigit(static_cast<unsigned char>(value[index]))) return false;
+    }
+
+    const int year = (value[0] - '0') * 1000 + (value[1] - '0') * 100 + (value[2] - '0') * 10 +
+                     value[3] - '0';
+    const int month = (value[5] - '0') * 10 + value[6] - '0';
+    const int day = (value[8] - '0') * 10 + value[9] - '0';
+    if (year < 1970 || month < 1 || month > 12) return false;
+
+    constexpr std::array<int, 12> kDaysPerMonth = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+    int maximum_day = kDaysPerMonth[month - 1];
+    const bool leap_year = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+    if (month == 2 && leap_year) ++maximum_day;
+    return day >= 1 && day <= maximum_day;
+}
+
+bool IsKernelFieldValid(const std::string& value) {
+    if (value.empty() || value.size() > kMaximumKernelFieldLength) return false;
+    for (unsigned char character : value) {
+        if (std::iscntrl(character)) return false;
+    }
+    return true;
+}
+
+bool IsHardwareFieldValid(const std::string& value) {
+    return value.size() <= kMaximumHardwareFieldLength &&
+           IsPropertyTextValid("ro.boot.floral_hardware_identity", value);
+}
+
+android::base::Result<std::map<std::string, std::string>> ParseFields(std::string_view content) {
+    std::map<std::string, std::string> fields;
+    size_t line_number = 0;
+    for (const std::string& raw_line : android::base::Split(std::string(content), "\n")) {
+        ++line_number;
+        std::string line = android::base::Trim(raw_line);
+        if (line.empty() || line.front() == '#') continue;
+
+        size_t separator = line.find('=');
+        if (separator == std::string::npos) {
+            return android::base::Error() << "line " << line_number << " has no '=' separator";
+        }
+
+        std::string key = android::base::Trim(line.substr(0, separator));
+        std::string value = android::base::Trim(line.substr(separator + 1));
+        // Other consumers share this versioned file and own their fields independently.
+        if (!IsKnownField(key)) continue;
+        if (value.empty()) {
+            return android::base::Error() << "line " << line_number << " has an empty value";
+        }
+        if (!fields.emplace(key, value).second) {
+            return android::base::Error()
+                   << "line " << line_number << " repeats field '" << key << "'";
+        }
+    }
+
+    for (std::string_view required : kRequiredFields) {
+        if (fields.find(std::string(required)) == fields.end()) {
+            return android::base::Error() << "profile must contain all required fields";
+        }
+    }
+    return fields;
+}
+
+std::string OptionalField(const std::map<std::string, std::string>& fields, std::string_view key) {
+    const auto found = fields.find(std::string(key));
+    return found == fields.end() ? "" : found->second;
+}
+
+}  // namespace
+
+FloralDeviceProfile DefaultFloralDeviceProfile() {
+    FloralDeviceProfile profile;
+    profile.brand = "Floral";
+    profile.manufacturer = "FloralDroid";
+    profile.model = "Floral F12";
+    profile.device = "floral_f12";
+    profile.product = "floral_f12";
+    profile.soc_manufacturer = "FloralDroid";
+    profile.soc_model = "Floral S12";
+    profile.gpu_vendor = "FloralDroid";
+    profile.gpu_model = "Floral GPU";
+    profile.build_flavor = "floral_f12-userdebug";
+    return profile;
+}
+
+android::base::Result<FloralDeviceProfile> ParseFloralDeviceProfile(std::string_view content) {
+    auto parsed_fields = ParseFields(content);
+    if (!parsed_fields.ok()) return parsed_fields.error();
+    const auto& fields = *parsed_fields;
+
+    if (fields.at("version") != "1") {
+        return android::base::Error() << "unsupported profile version";
+    }
+
+    FloralDeviceProfile profile = {
+            fields.at("brand"),
+            fields.at("manufacturer"),
+            fields.at("model"),
+            fields.at("device"),
+            fields.at("product"),
+            fields.at("board"),
+            fields.at("soc_manufacturer"),
+            fields.at("soc_model"),
+            fields.at("gpu_vendor"),
+            fields.at("gpu_model"),
+            fields.at("build_id"),
+            fields.at("build_display"),
+            OptionalField(fields, "build_description"),
+            OptionalField(fields, "build_flavor"),
+            fields.at("version_release"),
+            fields.at("security_patch"),
+            OptionalField(fields, "kernel_release"),
+            OptionalField(fields, "kernel_version"),
+            OptionalField(fields, "memory_type"),
+            OptionalField(fields, "memory_frequency"),
+            OptionalField(fields, "memory_channel"),
+            OptionalField(fields, "serial"),
+            OptionalField(fields, "hardware_revision"),
+    };
+
+    if (!IsDisplayValueValid(profile.brand) || !IsDisplayValueValid(profile.manufacturer) ||
+        !IsDisplayValueValid(profile.model) || !IsIdentifierValid(profile.device) ||
+        !IsIdentifierValid(profile.product) || !IsIdentifierValid(profile.board) ||
+        !IsDisplayValueValid(profile.soc_manufacturer) || !IsDisplayValueValid(profile.soc_model) ||
+        !IsDisplayValueValid(profile.gpu_vendor) || !IsDisplayValueValid(profile.gpu_model) ||
+        !IsIdentifierValid(profile.build_id) ||
+        !IsPropertyTextValid("ro.build.display.id", profile.build_display) ||
+        (!profile.build_description.empty() &&
+         !IsPropertyTextValid("ro.build.description", profile.build_description)) ||
+        !IsVersionReleaseValid(profile.version_release) ||
+        !IsSecurityPatchValid(profile.security_patch) ||
+        (!profile.kernel_release.empty() && !IsKernelFieldValid(profile.kernel_release)) ||
+        (!profile.kernel_version.empty() && !IsKernelFieldValid(profile.kernel_version)) ||
+        (!profile.build_flavor.empty() &&
+         !IsPropertyTextValid("ro.build.flavor", profile.build_flavor)) ||
+        (!profile.memory_type.empty() && !IsHardwareFieldValid(profile.memory_type)) ||
+        (!profile.memory_frequency.empty() && !IsHardwareFieldValid(profile.memory_frequency)) ||
+        (!profile.memory_channel.empty() && !IsHardwareFieldValid(profile.memory_channel)) ||
+        (!profile.serial.empty() && !IsHardwareFieldValid(profile.serial)) ||
+        (!profile.hardware_revision.empty() &&
+         !IsHardwareFieldValid(profile.hardware_revision))) {
+        return android::base::Error() << "profile contains an invalid identity value";
+    }
+    return profile;
+}
+
+android::base::Result<FloralDeviceProfile> ReadFloralDeviceProfile(const std::string& path) {
+    struct stat status = {};
+    if (stat(path.c_str(), &status) != 0) {
+        return android::base::ErrnoError() << "cannot stat profile";
+    }
+    if (!S_ISREG(status.st_mode) || status.st_size < 0 ||
+        static_cast<size_t>(status.st_size) > kMaximumProfileSize) {
+        return android::base::Error() << "profile must be a regular file no larger than "
+                                      << kMaximumProfileSize << " bytes";
+    }
+
+    std::string content;
+    if (!android::base::ReadFileToString(path, &content)) {
+        return android::base::ErrnoError() << "cannot read profile";
+    }
+    return ParseFloralDeviceProfile(content);
+}
+
+std::map<std::string, std::string> FloralDeviceProfileProperties(
+        const FloralDeviceProfile& profile) {
+    std::map<std::string, std::string> properties = {
+            {"ro.product.brand", profile.brand},
+            {"ro.product.manufacturer", profile.manufacturer},
+            {"ro.product.model", profile.model},
+            {"ro.product.device", profile.device},
+            {"ro.product.name", profile.product},
+            {"ro.soc.manufacturer", profile.soc_manufacturer},
+            {"ro.soc.model", profile.soc_model},
+            {"ro.boot.floral_gpu_vendor", profile.gpu_vendor},
+            {"ro.boot.floral_gpu_model", profile.gpu_model},
+    };
+    if (!profile.board.empty()) properties.emplace("ro.product.board", profile.board);
+    if (!profile.build_id.empty()) properties.emplace("ro.build.id", profile.build_id);
+    if (!profile.build_display.empty()) {
+        properties.emplace("ro.build.display.id", profile.build_display);
+    }
+    if (!profile.build_description.empty()) {
+        properties.emplace("ro.build.description", profile.build_description);
+    }
+    if (!profile.build_flavor.empty()) {
+        properties.emplace("ro.build.flavor", profile.build_flavor);
+    }
+    if (!profile.product.empty()) {
+        properties.emplace("ro.build.product", profile.product);
+    }
+    if (!profile.version_release.empty()) {
+        properties.emplace("ro.build.version.release", profile.version_release);
+        properties.emplace("ro.build.version.release_or_codename", profile.version_release);
+    }
+    if (!profile.security_patch.empty()) {
+        properties.emplace("ro.build.version.security_patch", profile.security_patch);
+    }
+    if (!profile.kernel_release.empty()) {
+        properties.emplace("ro.boot.floral_kernel_release", profile.kernel_release);
+    }
+    if (!profile.kernel_version.empty()) {
+        properties.emplace("ro.boot.floral_kernel_version", profile.kernel_version);
+    }
+    if (!profile.memory_type.empty()) {
+        properties.emplace("ro.boot.floral_memory_type", profile.memory_type);
+    }
+    if (!profile.memory_frequency.empty()) {
+        properties.emplace("ro.boot.floral_memory_frequency", profile.memory_frequency);
+    }
+    if (!profile.memory_channel.empty()) {
+        properties.emplace("ro.boot.floral_memory_channel", profile.memory_channel);
+    }
+    if (!profile.serial.empty()) {
+        properties.emplace("ro.serialno", profile.serial);
+        properties.emplace("ro.boot.serialno", profile.serial);
+    }
+    if (!profile.hardware_revision.empty()) {
+        properties.emplace("ro.hardware.revision", profile.hardware_revision);
+        properties.emplace("ro.boot.hardware.revision", profile.hardware_revision);
+    }
+    return properties;
+}
+
+}  // namespace init
+}  // namespace android
