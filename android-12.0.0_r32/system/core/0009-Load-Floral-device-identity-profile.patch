+#include "floral_device_profile.h"
+
+#include <gtest/gtest.h>
+
+namespace android {
+namespace init {
+namespace {
+
+constexpr std::string_view kValidProfile = R"(
+version=1
+brand=OPPO
+manufacturer=OPPO
+model=PGEM10
+device=OP528BL1
+product=PGEM10
+board=taro
+soc_manufacturer=Qualcomm
+soc_model=SM8450
+gpu_vendor=Qualcomm
+gpu_model=Adreno 730
+build_id=SKQ1.211006.001
+build_display=PGEM10_11_A.12
+build_description=PGEM10-user 12 SKQ1.211006.001 164808 release-keys
+build_flavor=PGEM10-user
+build_incremental=164808
+build_type=user
+build_tags=release-keys
+build_user=build
+build_host=buildhost
+build_date=Fri Sep  4 08:08:35 UTC 2026
+build_date_utc=1788509315
+version_release=12
+security_patch=2022-01-05
+kernel_release=5.10.66-android12-9-g123456789abc
+kernel_version=#1 SMP PREEMPT Mon Feb 7 12:00:00 UTC 2022
+memory_type=LPDDR5X
+memory_frequency=3200MHz
+memory_channel=4 x 16-bit
+serial=PGEM10FLORAL0001
+hardware_revision=11
+)";
+
+TEST(floral_device_profile, UsesSharedStrictParser) {
+    auto parsed = ParseFloralDeviceProfile(kValidProfile);
+    ASSERT_TRUE(parsed.ok()) << parsed.error();
+    ASSERT_NE(parsed->Find("model"), nullptr);
+    EXPECT_EQ(*parsed->Find("model"), "PGEM10");
+
+    std::string duplicate(kValidProfile);
+    duplicate.append("unknown_key=first\nunknown_key=second\n");
+    EXPECT_FALSE(ParseFloralDeviceProfile(duplicate).ok());
+}
+
+TEST(floral_device_profile, MapsEveryPartitionIdentityAndFingerprint) {
+    auto parsed = ParseFloralDeviceProfile(kValidProfile);
+    ASSERT_TRUE(parsed.ok()) << parsed.error();
+    auto mapped = FloralDeviceProfileProperties(*parsed);
+    ASSERT_TRUE(mapped.ok()) << mapped.error();
+    const auto& properties = *mapped;
+    const std::string fingerprint =
+            "OPPO/PGEM10/OP528BL1:12/SKQ1.211006.001/164808:user/release-keys";
+
+    EXPECT_EQ(properties.at("ro.product.model"), "PGEM10");
+    EXPECT_EQ(properties.at("ro.hardware"), "SM8450");
+    EXPECT_EQ(properties.at("ro.build.fingerprint"), fingerprint);
+    for (std::string_view partition :
+         {"odm", "product", "system", "system_ext", "vendor", "vendor_dlkm"}) {
+        const std::string product_prefix = "ro.product." + std::string(partition) + ".";
+        EXPECT_EQ(properties.at(product_prefix + "brand"), "OPPO");
+        EXPECT_EQ(properties.at(product_prefix + "model"), "PGEM10");
+        EXPECT_EQ(properties.at("ro." + std::string(partition) + ".build.fingerprint"),
+                  fingerprint);
+        const std::string build_prefix = "ro." + std::string(partition) + ".build.";
+        EXPECT_EQ(properties.at(build_prefix + "id"), "SKQ1.211006.001");
+        EXPECT_EQ(properties.at(build_prefix + "version.incremental"), "164808");
+        EXPECT_EQ(properties.at(build_prefix + "date.utc"), "1788509315");
+    }
+    EXPECT_EQ(properties.find("ro.bootimage.build.fingerprint"), properties.end());
+    EXPECT_EQ(properties.find("ro.odm_dlkm.build.fingerprint"), properties.end());
+}
+
+TEST(floral_device_profile, DoesNotOverrideRuntimeArchitectureOrHalClassSelection) {
+    auto parsed = ParseFloralDeviceProfile(kValidProfile);
+    ASSERT_TRUE(parsed.ok()) << parsed.error();
+    auto mapped = FloralDeviceProfileProperties(*parsed);
+    ASSERT_TRUE(mapped.ok()) << mapped.error();
+
+    EXPECT_EQ(mapped->find("ro.product.cpu.abi"), mapped->end());
+    EXPECT_EQ(mapped->find("ro.product.cpu.abilist"), mapped->end());
+    EXPECT_EQ(mapped->find("ro.build.version.sdk"), mapped->end());
+    EXPECT_EQ(mapped->find("ro.hardware.hwcomposer"), mapped->end());
+}
+
+}  // namespace
+}  // namespace init
+}  // namespace android
