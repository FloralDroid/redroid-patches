+#include "floral_device_profile.h"
+
+#include <gtest/gtest.h>
+
+namespace android {
+namespace init {
+namespace {
+
+constexpr std::string_view kValidProfile = R"(
+version=1
+brand=OPPO
+manufacturer=OPPO
+model=Find X6 Pro
+device=PGEM10
+product=PGEM10
+soc_manufacturer=Qualcomm
+soc_model=SM8550
+gpu_vendor=Qualcomm
+gpu_model=Adreno (TM) 740
+)";
+
+TEST(floral_device_profile, ParsesCompleteProfile) {
+    auto result = ParseFloralDeviceProfile(kValidProfile);
+
+    ASSERT_TRUE(result.ok()) << result.error();
+    EXPECT_EQ(result->brand, "OPPO");
+    EXPECT_EQ(result->model, "Find X6 Pro");
+    EXPECT_EQ(result->device, "PGEM10");
+    EXPECT_EQ(result->soc_model, "SM8550");
+    EXPECT_EQ(result->gpu_model, "Adreno (TM) 740");
+}
+
+TEST(floral_device_profile, RejectsPartialProfile) {
+    EXPECT_FALSE(ParseFloralDeviceProfile("version=1\nbrand=Floral\n").ok());
+}
+
+TEST(floral_device_profile, RejectsUnknownAndDuplicateFields) {
+    std::string unknown(kValidProfile);
+    unknown.append("unexpected=value\n");
+    EXPECT_FALSE(ParseFloralDeviceProfile(unknown).ok());
+
+    std::string duplicate(kValidProfile);
+    duplicate.append("model=Other\n");
+    EXPECT_FALSE(ParseFloralDeviceProfile(duplicate).ok());
+}
+
+TEST(floral_device_profile, RejectsInvalidProductIdentifiers) {
+    std::string invalid(kValidProfile);
+    size_t position = invalid.find("device=PGEM10");
+    ASSERT_NE(position, std::string::npos);
+    invalid.replace(position, std::string("device=PGEM10").size(), "device=Find X6 Pro");
+
+    EXPECT_FALSE(ParseFloralDeviceProfile(invalid).ok());
+}
+
+TEST(floral_device_profile, MapsDefaultIdentityToAndroidProperties) {
+    auto properties = FloralDeviceProfileProperties(DefaultFloralDeviceProfile());
+
+    EXPECT_EQ(properties.at("ro.product.brand"), "Floral");
+    EXPECT_EQ(properties.at("ro.product.model"), "Floral F12");
+    EXPECT_EQ(properties.at("ro.soc.model"), "Floral S12");
+    EXPECT_EQ(properties.at("ro.boot.floral_gpu_model"), "Floral GPU");
+}
+
+}  // namespace
+}  // namespace init
+}  // namespace android
