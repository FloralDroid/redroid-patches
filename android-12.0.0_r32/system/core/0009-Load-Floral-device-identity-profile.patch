+namespace {
+
+constexpr size_t kMaximumConfigSize = 256 * 1024;
+constexpr std::string_view kDefaultPolicy =
+        R"({"version":1,"default_backend":"auto","packages":{}})";
+
+constexpr std::array<std::string_view, 5> kKnownAbis = {
+        "arm64-v8a", "armeabi-v7a", "armeabi", "x86_64", "x86",
+};
+
+bool IsKnownAbi(std::string_view abi) {
+    return std::find(kKnownAbis.begin(), kKnownAbis.end(), abi) != kKnownAbis.end();
+}
+
+bool IsKnownBackend(std::string_view backend) {
+    return backend == "auto" || backend == "ndk" || backend == "houdini";
+}
+
+android::base::Result<std::vector<std::string>> ParseAbiList(const Json::Value& value,
+                                                               std::string_view field) {
+    if (!value.isArray() || value.empty()) {
+        return android::base::Error() << "abi.public." << field << " must be a non-empty array";
+    }
+
+    std::vector<std::string> result;
+    std::set<std::string> seen;
+    for (const Json::Value& item : value) {
+        if (!item.isString()) {
+            return android::base::Error() << "abi.public." << field
+                                          << " contains a non-string ABI";
+        }
+        const std::string abi = item.asString();
+        if (!IsKnownAbi(abi) || !seen.insert(abi).second) {
+            return android::base::Error() << "abi.public." << field
+                                          << " contains an unknown or duplicate ABI '" << abi
+                                          << "'";
+        }
+        result.push_back(abi);
+    }
+    return result;
+}
+
+std::string JoinAbis(const std::vector<std::string>& first,
+                     const std::vector<std::string>& second) {
+    std::vector<std::string> all = first;
+    all.insert(all.end(), second.begin(), second.end());
+    return android::base::Join(all, ",");
+}
+
+std::string PropertyOrDefault(const std::map<std::string, std::string>& properties,
+                              std::string_view name, std::string_view fallback) {
+    const auto it = properties.find(std::string(name));
+    if (it != properties.end() && !it->second.empty()) {
+        return it->second;
+    }
+    return std::string(fallback);
+}
+
+}  // namespace
+
+FloralNativeBridgeConfig DefaultFloralNativeBridgeConfig() {
+    return {
+            std::string(kDefaultPolicy),
+            {"arm64-v8a"},
+            {"armeabi-v7a", "armeabi"},
+    };
+}
+
+android::base::Result<FloralNativeBridgeConfig> ParseFloralNativeBridgeConfig(
+        std::string_view content) {
+    Json::Value root;
+    Json::CharReaderBuilder builder;
+    std::string errors;
+    std::unique_ptr<Json::CharReader> reader(builder.newCharReader());
+    const std::string input(content);
+    if (!reader->parse(input.data(), input.data() + input.size(), &root, &errors) ||
+        !root.isObject()) {
+        return android::base::Error() << "cannot parse nativebridge.json: " << errors;
+    }
+    if (root["version"].isInt() && root["version"].asInt() != 1) {
+        return android::base::Error() << "unsupported nativebridge.json version";
+    }
+
+    if (root.isMember("default_backend")) {
+        const Json::Value backend = root["default_backend"];
+        if ((!backend.isString() && !backend.isObject()) ||
+            (backend.isString() && !IsKnownBackend(backend.asString()))) {
+            return android::base::Error()
+                    << "default_backend must be auto, ndk, houdini, or a rule object";
+        }
+    } else if (root.isMember("preferred_backend")) {
+        const Json::Value preferred = root["preferred_backend"];
+        if (!preferred.isString() ||
+            (preferred.asString() != "ndk" && preferred.asString() != "houdini")) {
+            return android::base::Error() << "preferred_backend must be ndk or houdini";
+        }
+    }
+
+    FloralNativeBridgeConfig config = DefaultFloralNativeBridgeConfig();
+    Json::StreamWriterBuilder writer;
+    writer["indentation"] = "";
+    config.policy_json = Json::writeString(writer, root);
+
+    const Json::Value public_abi = root["abi"]["public"];
+    if (!public_abi.isNull()) {
+        if (!public_abi.isObject()) {
+            return android::base::Error() << "abi.public must be an object";
+        }
+        if (public_abi.isMember("64")) {
+            auto parsed = ParseAbiList(public_abi["64"], "64");
+            if (!parsed.ok()) return parsed.error();
+            config.public_abis64 = std::move(*parsed);
+        }
+        if (public_abi.isMember("32")) {
+            auto parsed = ParseAbiList(public_abi["32"], "32");
+            if (!parsed.ok()) return parsed.error();
+            config.public_abis32 = std::move(*parsed);
+        }
+    }
+    return config;
+}
+
+android::base::Result<FloralNativeBridgeConfig> ReadFloralNativeBridgeConfig(
+        const std::string& path) {
+    struct stat status = {};
+    if (stat(path.c_str(), &status) != 0) {
+        return android::base::ErrnoError() << "cannot stat nativebridge.json";
+    }
+    if (!S_ISREG(status.st_mode) || status.st_size < 0 ||
+        static_cast<size_t>(status.st_size) > kMaximumConfigSize) {
+        return android::base::Error() << "nativebridge.json must be a regular file no larger than "
+                                      << kMaximumConfigSize << " bytes";
+    }
+
+    std::string content;
+    if (!android::base::ReadFileToString(path, &content)) {
+        return android::base::ErrnoError() << "cannot read nativebridge.json";
+    }
+    return ParseFloralNativeBridgeConfig(content);
+}
+
+std::map<std::string, std::string> FloralNativeBridgeConfigProperties(
+        const FloralNativeBridgeConfig& config,
+        const std::map<std::string, std::string>& build_properties) {
+    const std::string loader_abilist = PropertyOrDefault(
+            build_properties, "ro.product.cpu.abilist", "x86_64,arm64-v8a,x86,armeabi-v7a,armeabi");
+    const std::string loader_abilist32 = PropertyOrDefault(
+            build_properties, "ro.product.cpu.abilist32", "x86,armeabi-v7a,armeabi");
+    const std::string loader_abilist64 = PropertyOrDefault(
+            build_properties, "ro.product.cpu.abilist64", "x86_64,arm64-v8a");
+    const bool virtualize_public_abis =
+            PropertyOrDefault(build_properties, "ro.dalvik.vm.native.bridge", "") ==
+            "libmixbridge.so";
+    const std::string public_abilist = virtualize_public_abis
+            ? JoinAbis(config.public_abis64, config.public_abis32) : loader_abilist;
+    const std::string public_abilist32 = virtualize_public_abis
+            ? android::base::Join(config.public_abis32, ",") : loader_abilist32;
+    const std::string public_abilist64 = virtualize_public_abis
+            ? android::base::Join(config.public_abis64, ",") : loader_abilist64;
+
+    return {
+            {"ro.floral.nb.loadabi", loader_abilist},
+            {"ro.floral.nb.loadabi32", loader_abilist32},
+            {"ro.floral.nb.loadabi64", loader_abilist64},
+            {"ro.floral.nb.pubabi", public_abilist},
+            {"ro.floral.nb.pubabi32", public_abilist32},
+            {"ro.floral.nb.pubabi64", public_abilist64},
+    };
+}
+
+}  // namespace init
+}  // namespace android
