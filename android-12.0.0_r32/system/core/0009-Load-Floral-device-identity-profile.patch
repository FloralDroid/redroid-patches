+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "floral_device_profile.h"
+
+#include <sys/stat.h>
+
+#include <array>
+#include <cctype>
+#include <cerrno>
+#include <map>
+#include <string>
+
+#include <android-base/file.h>
+#include <android-base/result.h>
+#include <android-base/strings.h>
+
+#include "util.h"
+
+namespace android {
+namespace init {
+namespace {
+
+constexpr size_t kMaximumProfileSize = 4096;
+constexpr size_t kMaximumIdentityLength = 64;
+constexpr size_t kMaximumIdentifierLength = 32;
+
+constexpr std::array<std::string_view, 10> kRequiredFields = {
+        "version",          "brand",     "manufacturer", "model",     "device", "product",
+        "soc_manufacturer", "soc_model", "gpu_vendor",   "gpu_model",
+};
+
+bool IsRequiredField(std::string_view key) {
+    for (std::string_view required : kRequiredFields) {
+        if (key == required) return true;
+    }
+    return false;
+}
+
+bool IsDisplayValueValid(const std::string& value) {
+    if (value.empty() || value.size() > kMaximumIdentityLength ||
+        !IsLegalPropertyValue("ro.product.model", value).ok()) {
+        return false;
+    }
+    for (unsigned char character : value) {
+        if (std::iscntrl(character)) return false;
+    }
+    return true;
+}
+
+bool IsIdentifierValid(const std::string& value) {
+    if (value.empty() || value.size() > kMaximumIdentifierLength ||
+        !std::isalnum(static_cast<unsigned char>(value.front()))) {
+        return false;
+    }
+    for (unsigned char character : value) {
+        if (!std::isalnum(character) && character != '_' && character != '-' && character != '.') {
+            return false;
+        }
+    }
+    return true;
+}
+
+android::base::Result<std::map<std::string, std::string>> ParseFields(std::string_view content) {
+    std::map<std::string, std::string> fields;
+    size_t line_number = 0;
+    for (const std::string& raw_line : android::base::Split(std::string(content), "\n")) {
+        ++line_number;
+        std::string line = android::base::Trim(raw_line);
+        if (line.empty() || line.front() == '#') continue;
+
+        size_t separator = line.find('=');
+        if (separator == std::string::npos) {
+            return android::base::Error() << "line " << line_number << " has no '=' separator";
+        }
+
+        std::string key = android::base::Trim(line.substr(0, separator));
+        std::string value = android::base::Trim(line.substr(separator + 1));
+        if (!IsRequiredField(key)) {
+            return android::base::Error()
+                   << "line " << line_number << " contains unknown field '" << key << "'";
+        }
+        if (value.empty()) {
+            return android::base::Error() << "line " << line_number << " has an empty value";
+        }
+        if (!fields.emplace(key, value).second) {
+            return android::base::Error()
+                   << "line " << line_number << " repeats field '" << key << "'";
+        }
+    }
+
+    if (fields.size() != kRequiredFields.size()) {
+        return android::base::Error() << "profile must contain all required fields";
+    }
+    return fields;
+}
+
+}  // namespace
+
+FloralDeviceProfile DefaultFloralDeviceProfile() {
+    return {"Floral",      "FloralDroid", "Floral F12",  "floral_f12", "floral_f12",
+            "FloralDroid", "Floral S12",  "FloralDroid", "Floral GPU"};
+}
+
+android::base::Result<FloralDeviceProfile> ParseFloralDeviceProfile(std::string_view content) {
+    auto parsed_fields = ParseFields(content);
+    if (!parsed_fields.ok()) return parsed_fields.error();
+    const auto& fields = *parsed_fields;
+
+    if (fields.at("version") != "1") {
+        return android::base::Error() << "unsupported profile version";
+    }
+
+    FloralDeviceProfile profile = {
+            fields.at("brand"),     fields.at("manufacturer"), fields.at("model"),
+            fields.at("device"),    fields.at("product"),      fields.at("soc_manufacturer"),
+            fields.at("soc_model"), fields.at("gpu_vendor"),   fields.at("gpu_model"),
+    };
+
+    if (!IsDisplayValueValid(profile.brand) || !IsDisplayValueValid(profile.manufacturer) ||
+        !IsDisplayValueValid(profile.model) || !IsIdentifierValid(profile.device) ||
+        !IsIdentifierValid(profile.product) || !IsDisplayValueValid(profile.soc_manufacturer) ||
+        !IsDisplayValueValid(profile.soc_model) || !IsDisplayValueValid(profile.gpu_vendor) ||
+        !IsDisplayValueValid(profile.gpu_model)) {
+        return android::base::Error() << "profile contains an invalid identity value";
+    }
+    return profile;
+}
+
+android::base::Result<FloralDeviceProfile> ReadFloralDeviceProfile(const std::string& path) {
+    struct stat status = {};
+    if (stat(path.c_str(), &status) != 0) {
+        return android::base::ErrnoError() << "cannot stat profile";
+    }
+    if (!S_ISREG(status.st_mode) || status.st_size < 0 ||
+        static_cast<size_t>(status.st_size) > kMaximumProfileSize) {
+        return android::base::Error() << "profile must be a regular file no larger than "
+                                      << kMaximumProfileSize << " bytes";
+    }
+
+    std::string content;
+    if (!android::base::ReadFileToString(path, &content)) {
+        return android::base::ErrnoError() << "cannot read profile";
+    }
+    return ParseFloralDeviceProfile(content);
+}
+
+std::map<std::string, std::string> FloralDeviceProfileProperties(
+        const FloralDeviceProfile& profile) {
+    return {
+            {"ro.product.brand", profile.brand},
+            {"ro.product.manufacturer", profile.manufacturer},
+            {"ro.product.model", profile.model},
+            {"ro.product.device", profile.device},
+            {"ro.product.name", profile.product},
+            {"ro.soc.manufacturer", profile.soc_manufacturer},
+            {"ro.soc.model", profile.soc_model},
+            {"ro.boot.floral_gpu_vendor", profile.gpu_vendor},
+            {"ro.boot.floral_gpu_model", profile.gpu_model},
+    };
+}
+
+}  // namespace init
+}  // namespace android
