 static int property_set_fd = -1;
@@ -172,7 +174,8 @@ static bool CheckMacPerms(const std::string& name, const char* target_context,
     return has_access;
 }
 
-static uint32_t PropertySet(const std::string& name, const std::string& value, std::string* error) {
+static uint32_t PropertySet(const std::string& name, const std::string& value, std::string* error,
+                            bool allow_read_only_override = false) {
     size_t valuelen = value.size();
 
     if (!IsLegalPropertyName(name)) {
@@ -188,7 +191,7 @@ static uint32_t PropertySet(const std::string& name, const std::string& value, s
     prop_info* pi = (prop_info*) __system_property_find(name.c_str());
     if (pi != nullptr) {
         // ro.* properties are actually "write-once".
-        if (StartsWith(name, "ro.")) {
+        if (StartsWith(name, "ro.") && !allow_read_only_override) {
             *error = "Read-only property was already set";
             return PROP_ERROR_READ_ONLY_PROPERTY;
         }
@@ -1089,9 +1092,38 @@ void PropertyLoadBootDefaults() {
         load_properties_from_file(kDebugRamdiskProp, nullptr, &properties);
     }
 
+    std::map<std::string, std::string> floral_properties;
+    if (access(floral::device::profile::kDefaultPath, F_OK) == 0) {
+        auto mounted_profile = ReadFloralDeviceProfile(floral::device::profile::kDefaultPath);
+        if (mounted_profile.ok()) {
+            auto mapped_properties = FloralDeviceProfileProperties(*mounted_profile);
+            if (mapped_properties.ok()) {
+                floral_properties = std::move(*mapped_properties);
+                LOG(INFO) << "Using mounted Floral device profile '"
+                          << *mounted_profile->Find("model") << "'";
+            } else {
+                LOG(WARNING) << "Ignoring invalid Floral property mapping: "
+                             << mapped_properties.error();
+            }
+        } else {
+            LOG(WARNING) << "Ignoring invalid Floral device profile: "
+                         << mounted_profile.error();
+        }
+    } else if (errno == ENOENT) {
+        LOG(INFO) << "Floral device profile is not mounted";
+    } else {
+        PLOG(WARNING) << "Cannot inspect Floral device profile";
+    }
+    for (const auto& [name, value] : floral_properties) {
+        properties.insert_or_assign(name, value);
+    }
+
     for (const auto& [name, value] : properties) {
         std::string error;
-        if (PropertySet(name, value, &error) != PROP_SUCCESS) {
+        // The trusted, validated profile must supersede inherited kernel identity.
+        const bool allow_read_only_override =
+                floral_properties.find(name) != floral_properties.end();
+        if (PropertySet(name, value, &error, allow_read_only_override) != PROP_SUCCESS) {
             LOG(ERROR) << "Could not set '" << name << "' to '" << value
                        << "' while loading .prop files" << error;
         }
