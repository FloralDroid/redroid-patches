+#pragma once
+
+#include <map>
+#include <string>
+#include <string_view>
+
+#include <android-base/result.h>
+
+namespace android {
+namespace init {
+
+struct FloralDeviceProfile {
+    std::string brand;
+    std::string manufacturer;
+    std::string model;
+    std::string device;
+    std::string product;
+    std::string board;
+    std::string soc_manufacturer;
+    std::string soc_model;
+    std::string gpu_vendor;
+    std::string gpu_model;
+    std::string build_id;
+    std::string build_display;
+    std::string build_description;
+    std::string build_flavor;
+    std::string version_release;
+    std::string security_patch;
+    std::string kernel_release;
+    std::string kernel_version;
+    std::string memory_type;
+    std::string memory_frequency;
+    std::string memory_channel;
+    std::string serial;
+    std::string hardware_revision;
+};
+
+FloralDeviceProfile DefaultFloralDeviceProfile();
+android::base::Result<FloralDeviceProfile> ParseFloralDeviceProfile(std::string_view content);
+android::base::Result<FloralDeviceProfile> ReadFloralDeviceProfile(const std::string& path);
+std::map<std::string, std::string> FloralDeviceProfileProperties(
+        const FloralDeviceProfile& profile);
+
+}  // namespace init
+}  // namespace android
