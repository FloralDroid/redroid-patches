+
+#include "floral_device_profile.h"
+
+#include <gtest/gtest.h>
+
+namespace android {
+namespace init {
+namespace {
+
+constexpr std::string_view kValidProfile = R"(
+version=1
+brand=OPPO
+manufacturer=OPPO
+model=Find X6 Pro
+device=PGEM10
+product=PGEM10
+board=kalama
+soc_manufacturer=Qualcomm
+soc_model=SM8550
+gpu_vendor=Qualcomm
+gpu_model=Adreno (TM) 740
+build_id=SQ1D.220205.004
+build_display=PGEM10-userdebug 12 SQ1D.220205.004 test-keys
+build_description=PGEM10-user 12 SQ1D.220205.004 103837 test-keys
+version_release=12
+security_patch=2022-02-05
+kernel_release=5.10.66-android12-9-g123456789abc
+kernel_version=#1 SMP PREEMPT Mon Feb 7 12:00:00 UTC 2022
+build_flavor=PGEM10-userdebug
+memory_type=LPDDR5X
+memory_frequency=4200MHz
+memory_channel=16-bit Quad channel
+serial=FLORALF120001
+hardware_revision=EVT1
+)";
+
+TEST(floral_device_profile, ParsesCompleteProfile) {
+    auto result = ParseFloralDeviceProfile(kValidProfile);
+
+    ASSERT_TRUE(result.ok()) << result.error();
+    EXPECT_EQ(result->brand, "OPPO");
+    EXPECT_EQ(result->model, "Find X6 Pro");
+    EXPECT_EQ(result->device, "PGEM10");
+    EXPECT_EQ(result->board, "kalama");
+    EXPECT_EQ(result->soc_model, "SM8550");
+    EXPECT_EQ(result->gpu_model, "Adreno (TM) 740");
+    EXPECT_EQ(result->build_id, "SQ1D.220205.004");
+    EXPECT_EQ(result->build_description, "PGEM10-user 12 SQ1D.220205.004 103837 test-keys");
+    EXPECT_EQ(result->version_release, "12");
+    EXPECT_EQ(result->security_patch, "2022-02-05");
+    EXPECT_EQ(result->kernel_release, "5.10.66-android12-9-g123456789abc");
+    EXPECT_EQ(result->kernel_version, "#1 SMP PREEMPT Mon Feb 7 12:00:00 UTC 2022");
+    EXPECT_EQ(result->build_flavor, "PGEM10-userdebug");
+    EXPECT_EQ(result->memory_type, "LPDDR5X");
+    EXPECT_EQ(result->memory_frequency, "4200MHz");
+    EXPECT_EQ(result->memory_channel, "16-bit Quad channel");
+    EXPECT_EQ(result->serial, "FLORALF120001");
+    EXPECT_EQ(result->hardware_revision, "EVT1");
+}
+
+TEST(floral_device_profile, RejectsPartialProfile) {
+    EXPECT_FALSE(ParseFloralDeviceProfile("version=1\nbrand=Floral\n").ok());
+}
+
+TEST(floral_device_profile, IgnoresUnknownFieldsAndRejectsKnownDuplicates) {
+    std::string extended(kValidProfile);
+    extended.append("cpu_feature_view=sm8550\n");
+    extended.append("cpu_cores=auto\n");
+    EXPECT_TRUE(ParseFloralDeviceProfile(extended).ok());
+
+    std::string duplicate(kValidProfile);
+    duplicate.append("model=Other\n");
+    EXPECT_FALSE(ParseFloralDeviceProfile(duplicate).ok());
+}
+
+TEST(floral_device_profile, RejectsInvalidProductIdentifiers) {
+    std::string invalid(kValidProfile);
+    size_t position = invalid.find("device=PGEM10");
+    ASSERT_NE(position, std::string::npos);
+    invalid.replace(position, std::string("device=PGEM10").size(), "device=Find X6 Pro");
+
+    EXPECT_FALSE(ParseFloralDeviceProfile(invalid).ok());
+}
+
+TEST(floral_device_profile, RejectsInvalidBuildMetadata) {
+    std::string invalid_board(kValidProfile);
+    size_t board_position = invalid_board.find("board=kalama");
+    ASSERT_NE(board_position, std::string::npos);
+    invalid_board.replace(board_position, std::string("board=kalama").size(),
+                          "board=invalid board");
+    EXPECT_FALSE(ParseFloralDeviceProfile(invalid_board).ok());
+
+    std::string invalid_patch(kValidProfile);
+    size_t patch_position = invalid_patch.find("security_patch=2022-02-05");
+    ASSERT_NE(patch_position, std::string::npos);
+    invalid_patch.replace(patch_position, std::string("security_patch=2022-02-05").size(),
+                          "security_patch=2023-02-29");
+    EXPECT_FALSE(ParseFloralDeviceProfile(invalid_patch).ok());
+}
+
+TEST(floral_device_profile, AcceptsMissingKernelIdentityForCompatibility) {
+    std::string legacy(kValidProfile);
+    size_t release_position = legacy.find("kernel_release=");
+    ASSERT_NE(release_position, std::string::npos);
+    legacy.erase(release_position, legacy.find('\n', release_position) - release_position + 1);
+    size_t version_position = legacy.find("kernel_version=");
+    ASSERT_NE(version_position, std::string::npos);
+    legacy.erase(version_position, legacy.find('\n', version_position) - version_position + 1);
+
+    auto profile = ParseFloralDeviceProfile(legacy);
+    ASSERT_TRUE(profile.ok()) << profile.error();
+    EXPECT_TRUE(profile->kernel_release.empty());
+    EXPECT_TRUE(profile->kernel_version.empty());
+}
+
+TEST(floral_device_profile, RejectsOversizedKernelIdentity) {
+    std::string invalid(kValidProfile);
+    size_t position = invalid.find("kernel_release=5.10.66-android12-9-g123456789abc");
+    ASSERT_NE(position, std::string::npos);
+    invalid.replace(position,
+                    std::string("kernel_release=5.10.66-android12-9-g123456789abc").size(),
+                    "kernel_release=" + std::string(65, 'a'));
+
+    EXPECT_FALSE(ParseFloralDeviceProfile(invalid).ok());
+}
+
+TEST(floral_device_profile, MapsConfiguredBuildIdentityToAndroidProperties) {
+    auto profile = ParseFloralDeviceProfile(kValidProfile);
+    ASSERT_TRUE(profile.ok()) << profile.error();
+
+    auto properties = FloralDeviceProfileProperties(*profile);
+    EXPECT_EQ(properties.at("ro.product.board"), "kalama");
+    EXPECT_EQ(properties.at("ro.build.id"), "SQ1D.220205.004");
+    EXPECT_EQ(properties.at("ro.build.display.id"),
+              "PGEM10-userdebug 12 SQ1D.220205.004 test-keys");
+    EXPECT_EQ(properties.at("ro.build.description"),
+              "PGEM10-user 12 SQ1D.220205.004 103837 test-keys");
+    EXPECT_EQ(properties.at("ro.build.version.release"), "12");
+    EXPECT_EQ(properties.at("ro.build.version.release_or_codename"), "12");
+    EXPECT_EQ(properties.at("ro.build.version.security_patch"), "2022-02-05");
+    EXPECT_EQ(properties.at("ro.boot.floral_kernel_release"), "5.10.66-android12-9-g123456789abc");
