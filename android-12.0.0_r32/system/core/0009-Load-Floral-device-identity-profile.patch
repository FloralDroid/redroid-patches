+#include "floral_device_profile.h"
+
+#include <array>
+#include <map>
+#include <string>
+#include <utility>
+
+#include <android-base/result.h>
+
+#include "util.h"
+
+namespace android {
+namespace init {
+namespace {
+
+const std::string& Required(const FloralDeviceProfile& profile, std::string_view key) {
+    return *profile.Find(key);
+}
+
+std::string Optional(const FloralDeviceProfile& profile, std::string_view key,
+                     std::string fallback = {}) {
+    const std::string* value = profile.Find(key);
+    return value == nullptr ? std::move(fallback) : *value;
+}
+
+std::string BuildFingerprint(const FloralDeviceProfile& profile) {
+    const std::string& brand = Required(profile, "brand");
+    const std::string& product = Required(profile, "product");
+    const std::string& device = Required(profile, "device");
+    const std::string& release = Required(profile, "version_release");
+    const std::string& build_id = Required(profile, "build_id");
+    const std::string incremental = Optional(profile, "build_incremental", build_id);
+    const std::string build_type = Optional(profile, "build_type", "user");
+    const std::string build_tags = Optional(profile, "build_tags", "release-keys");
+    return brand + "/" + product + "/" + device + ":" + release + "/" + build_id + "/" +
+           incremental + ":" + build_type + "/" + build_tags;
+}
+
+void AddOptionalProperty(const FloralDeviceProfile& profile, std::string_view field,
+                         const char* property, std::map<std::string, std::string>* properties) {
+    const std::string* value = profile.Find(field);
+    if (value != nullptr) {
+        properties->emplace(property, *value);
+    }
+}
+
+}  // namespace
+
+android::base::Result<FloralDeviceProfile> ParseFloralDeviceProfile(std::string_view content) {
+    FloralDeviceProfile profile;
+    std::string error;
+    if (!floral::device::profile::ParseDeviceProfile(content, &profile, &error)) {
+        return android::base::Error() << error;
+    }
+    return profile;
+}
+
+android::base::Result<FloralDeviceProfile> ReadFloralDeviceProfile(const std::string& path) {
+    FloralDeviceProfile profile;
+    std::string error;
+    if (!floral::device::profile::ReadDeviceProfile(path, &profile, &error)) {
+        return android::base::Error() << error;
+    }
+    return profile;
+}
+
+android::base::Result<std::map<std::string, std::string>> FloralDeviceProfileProperties(
+        const FloralDeviceProfile& profile) {
+    const std::string& brand = Required(profile, "brand");
+    const std::string& manufacturer = Required(profile, "manufacturer");
+    const std::string& model = Required(profile, "model");
+    const std::string& device = Required(profile, "device");
+    const std::string& product = Required(profile, "product");
+    const std::string& build_id = Required(profile, "build_id");
+    const std::string& release = Required(profile, "version_release");
+    const std::string incremental = Optional(profile, "build_incremental", build_id);
+    const std::string build_type = Optional(profile, "build_type", "user");
+    const std::string build_tags = Optional(profile, "build_tags", "release-keys");
+    const std::string build_date = Optional(profile, "build_date");
+    const std::string build_date_utc = Optional(profile, "build_date_utc");
+    const std::string fingerprint = BuildFingerprint(profile);
+    const std::string description =
+            Optional(profile, "build_description",
+                     product + "-" + build_type + " " + release + " " + build_id + " " +
+                             incremental + " " + build_tags);
+
+    std::map<std::string, std::string> properties = {
+            {"ro.product.brand", brand},
+            {"ro.product.manufacturer", manufacturer},
+            {"ro.product.model", model},
+            {"ro.product.device", device},
+            {"ro.product.name", product},
+            {"ro.product.board", Required(profile, "board")},
+            {"ro.soc.manufacturer", Required(profile, "soc_manufacturer")},
+            {"ro.soc.model", Required(profile, "soc_model")},
+            {"ro.hardware", Required(profile, "soc_model")},
+            {"ro.boot.floral_gpu_vendor", Required(profile, "gpu_vendor")},
+            {"ro.boot.floral_gpu_model", Required(profile, "gpu_model")},
+            {"ro.build.id", build_id},
+            {"ro.build.display.id", Required(profile, "build_display")},
+            {"ro.build.description", description},
+            {"ro.build.flavor", Optional(profile, "build_flavor", product + "-" + build_type)},
+            {"ro.build.product", product},
+            {"ro.build.version.release", release},
+            {"ro.build.version.release_or_codename", release},
+            {"ro.build.version.security_patch", Required(profile, "security_patch")},
+            {"ro.build.version.incremental", incremental},
+            {"ro.build.type", build_type},
+            {"ro.build.tags", build_tags},
+            {"ro.build.fingerprint", fingerprint},
+    };
+
+    constexpr std::array<std::string_view, 6> partitions = {"odm",        "product", "system",
+                                                            "system_ext", "vendor",  "vendor_dlkm"};
+    for (const std::string_view partition : partitions) {
+        const std::string prefix = "ro.product." + std::string(partition) + ".";
+        properties.emplace(prefix + "brand", brand);
+        properties.emplace(prefix + "manufacturer", manufacturer);
+        properties.emplace(prefix + "model", model);
+        properties.emplace(prefix + "device", device);
+        properties.emplace(prefix + "name", product);
+        const std::string build_prefix = "ro." + std::string(partition) + ".build.";
+        properties.emplace(build_prefix + "fingerprint", fingerprint);
+        properties.emplace(build_prefix + "id", build_id);
+        properties.emplace(build_prefix + "version.incremental", incremental);
+        properties.emplace(build_prefix + "type", build_type);
+        properties.emplace(build_prefix + "tags", build_tags);
+        properties.emplace(build_prefix + "version.release", release);
+        properties.emplace(build_prefix + "version.release_or_codename", release);
+        if (!build_date.empty()) {
+            properties.emplace(build_prefix + "date", build_date);
+            properties.emplace(build_prefix + "date.utc", build_date_utc);
+        }
+    }
+
+    AddOptionalProperty(profile, "build_user", "ro.build.user", &properties);
+    AddOptionalProperty(profile, "build_host", "ro.build.host", &properties);
+    AddOptionalProperty(profile, "build_date", "ro.build.date", &properties);
+    AddOptionalProperty(profile, "build_date_utc", "ro.build.date.utc", &properties);
+    AddOptionalProperty(profile, "kernel_release", "ro.boot.floral_kernel_release", &properties);
+    AddOptionalProperty(profile, "kernel_version", "ro.boot.floral_kernel_version", &properties);
+    AddOptionalProperty(profile, "memory_type", "ro.boot.floral_memory_type", &properties);
+    AddOptionalProperty(profile, "memory_frequency", "ro.boot.floral_memory_frequency",
+                        &properties);
+    AddOptionalProperty(profile, "memory_channel", "ro.boot.floral_memory_channel", &properties);
+    const std::string* serial = profile.Find("serial");
+    if (serial != nullptr) {
+        properties.emplace("ro.serialno", *serial);
+        properties.emplace("ro.boot.serialno", *serial);
+    }
+    const std::string* revision = profile.Find("hardware_revision");
+    if (revision != nullptr) {
+        properties.emplace("ro.hardware.revision", *revision);
+        properties.emplace("ro.boot.hardware.revision", *revision);
+    }
+
+    for (const auto& [name, value] : properties) {
+        if (value.empty() || !IsLegalPropertyValue(name, value).ok()) {
+            return android::base::Error()
+                   << "profile value is invalid for property '" << name << "'";
+        }
+    }
+    return properties;
+}
+
+}  // namespace init
+}  // namespace android
