+
+#pragma once
+
+#include <fcntl.h>
+#include <sys/mount.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+namespace android::init::floral {
+
+constexpr const char* kIpcMount = "/ipc/floral_stream";
+
+inline bool IpcError(std::string* error, const std::string& message) {
+    *error = message;
+    return false;
+}
+
+inline bool HasMountOption(const std::string& options, const std::string& expected) {
+    std::istringstream input(options);
+    std::string option;
+    while (std::getline(input, option, ',')) {
+        if (option == expected) return true;
+    }
+    return false;
+}
+
+// Check the actual single leaf mount, not merely a directory or a parent bind.
+// Mountinfo paths are escaped by the kernel; this fixed path needs no decoding.
+inline bool CheckIpcMount(std::istream& input, bool require_private, unsigned int* mount_id,
+                          std::string* error) {
+    bool found = false;
+    std::string line;
+    while (std::getline(input, line)) {
+        std::istringstream fields(line);
+        unsigned int id, parent;
+        std::string device, root, path, options, field;
+        if (!(fields >> id >> parent >> device >> root >> path >> options) || id == 0) {
+            return IpcError(error, "invalid mountinfo record");
+        }
+        std::string propagation;
+        bool separator = false;
+        while (fields >> field) {
+            if (field == "-") {
+                separator = true;
+                break;
+            }
+            if (!propagation.empty()) propagation += ' ';
+            propagation += field;
+        }
+        std::string fs, source, super_options;
+        if (!separator || !(fields >> fs >> source >> super_options)) {
+            return IpcError(error, "incomplete mountinfo record");
+        }
+        if (path.compare(0, std::strlen(kIpcMount) + 1, std::string(kIpcMount) + "/") == 0) {
+            return IpcError(error, "unexpected mount below Floral IPC");
+        }
+        if (path != kIpcMount) continue;
+        if (found) return IpcError(error, "stacked Floral IPC mounts");
+        found = true;
+        *mount_id = id;
+        for (const char* option : {"rw", "nosuid", "nodev", "noexec"}) {
+            if (!HasMountOption(options, option)) {
+                return IpcError(error, "unsafe Floral IPC mount flags");
+            }
+        }
+        if (HasMountOption(options, "ro")) return IpcError(error, "read-only Floral IPC mount");
+        if (!propagation.empty()) {
+            // Only the shared group created by SetupMountNamespaces is expected.
+            if (require_private || propagation.compare(0, 7, "shared:") != 0) {
+                return IpcError(error, "unexpected Floral IPC propagation");
+            }
+            const auto group = propagation.substr(7);
+            if (group.empty() ||
+                group.find_first_not_of("0123456789") != std::string::npos ||
+                group.find_first_not_of('0') == std::string::npos) {
+                return IpcError(error, "unexpected Floral IPC propagation");
+            }
+        }
+    }
+    if (input.bad()) return IpcError(error, "cannot read mountinfo");
+    return found || IpcError(error, "Floral IPC directory is not a separate mount");
+}
+
+inline bool CheckIpcMountFile(bool require_private, unsigned int* mount_id, std::string* error) {
+    std::ifstream input("/proc/self/mountinfo");
+    if (!input.is_open()) return IpcError(error, "cannot open mountinfo");
+    return CheckIpcMount(input, require_private, mount_id, error);
+}
+
+inline bool KeepIpcMountPrivate(std::string* error) {
+    // No IPC directory is the native/non-container case. Never create a fallback.
+    const int parent = open("/ipc", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    if (parent < 0) {
+        if (errno == ENOENT) return true;
+        return IpcError(error, "cannot open /ipc without following symlinks");
+    }
+    const int leaf = openat(parent, "floral_stream", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    const int open_error = errno;
+    close(parent);
+    if (leaf < 0) {
+        if (open_error == ENOENT) return true;
+        return IpcError(error, "cannot open Floral IPC without following symlinks");
+    }
+    // Own the FD across all validation and mount calls, including error exits.
+    struct CloseFd {
+        int fd;
+        ~CloseFd() { close(fd); }
+    } close_leaf{leaf};
+    struct stat before {};
+    if (fstat(leaf, &before) != 0 || !S_ISDIR(before.st_mode) || before.st_uid != 0 ||
+        before.st_gid != 0 || (before.st_mode & 07777) != 0773) {
+        return IpcError(error, "unsafe Floral IPC directory owner/mode");
+    }
+    unsigned int before_id = 0;
+    if (!CheckIpcMountFile(false, &before_id, error)) return false;
+    std::ifstream fdinfo("/proc/self/fdinfo/" + std::to_string(leaf));
+    std::string line;
+    unsigned int fd_mount_id = 0;
+    while (std::getline(fdinfo, line)) {
+        std::istringstream fields(line);
+        std::string key;
+        if ((fields >> key) && key == "mnt_id:") {
+            if (!(fields >> fd_mount_id)) return IpcError(error, "invalid Floral IPC fdinfo");
+            break;
+        }
+    }
+    if (fd_mount_id != before_id) return IpcError(error, "Floral IPC mount identity changed");
+    // Address the pinned directory, not a pathname which could be substituted.
+    const auto pinned = "/proc/self/fd/" + std::to_string(leaf);
+    if (mount(nullptr, pinned.c_str(), nullptr, MS_PRIVATE, nullptr) != 0) {
+        return IpcError(error, "cannot make Floral IPC private: " + std::string(strerror(errno)));
+    }
+    unsigned int after_id = 0;
+    if (!CheckIpcMountFile(true, &after_id, error) || before_id != after_id) {
+        return IpcError(error, "Floral IPC mount changed during initialization: " + *error);
+    }
+    struct stat after {};
+    if (lstat(kIpcMount, &after) != 0 || before.st_dev != after.st_dev || before.st_ino != after.st_ino) {
+        return IpcError(error, "Floral IPC source changed during initialization");
+    }
+    return true;
+}
+
+}  // namespace android::init::floral
