+#include "floral_ipc_mount.h"
+
+#include <gtest/gtest.h>
+
+namespace android::init::floral {
+
+static bool Check(const std::string& records, bool require_private = false) {
+    std::istringstream input(records);
+    unsigned int id = 0;
+    std::string error;
+    return CheckIpcMount(input, require_private, &id, &error);
+}
+
+static std::string Record(const std::string& options = "rw,nosuid,nodev,noexec",
+                          const std::string& optional = "shared:123 ",
+                          const std::string& path = kIpcMount) {
+    return "42 1 0:23 / " + path + " " + options + " " + optional + "- tmpfs tmpfs rw\n";
+}
+
+TEST(FloralIpcMount, AcceptsOnlyPrivateOrLocalSharedBeforeInitialization) {
+    EXPECT_TRUE(Check(Record()));
+    EXPECT_TRUE(Check(Record("rw,nosuid,nodev,noexec", ""), true));
+    for (const auto* optional : {"shared:1 ", "master:1 ", "shared:1 master:2 ",
+                                 "shared:0 ", "shared: ", "shared:abc ", "unbindable "}) {
+        EXPECT_FALSE(Check(Record("rw,nosuid,nodev,noexec", optional), true));
+    }
+    EXPECT_FALSE(Check(Record("rw,nosuid,nodev,noexec", "master:1 ")));
+}
+
+TEST(FloralIpcMount, RejectsUnsafeOrMissingMounts) {
+    EXPECT_FALSE(Check(""));
+    EXPECT_FALSE(Check(Record() + Record()));
+    EXPECT_FALSE(Check(Record() + Record("rw,nosuid,nodev,noexec", "", "/ipc/floral_stream/child")));
+    for (const auto* flags : {"rw,nodev,noexec", "rw,nosuid,noexec", "rw,nosuid,nodev",
+                              "ro,nosuid,nodev,noexec", "rw,ro,nosuid,nodev,noexec"}) {
+        EXPECT_FALSE(Check(Record(flags)));
+    }
+    EXPECT_FALSE(Check("not a mountinfo record\n"));
+    EXPECT_FALSE(Check("42 1 0:23 / /ipc/floral_stream rw,nosuid,nodev,noexec shared:1\n"));
+}
+
+}  // namespace android::init::floral
diff --git a/init/mount_namespace.cpp b/init/mount_namespace.cpp
index 2a57808..785001d 100644
--- a/init/mount_namespace.cpp
+++ b/init/mount_namespace.cpp
@@ -28,6 +28,7 @@
 #include <android-base/result.h>
 #include <android-base/unique_fd.h>
 
+#include "floral_ipc_mount.h"
 #include "util.h"
 
 #ifndef RECOVERY
@@ -202,6 +203,14 @@ bool SetupMountNamespaces() {
     // point to private.
     if (!ChangeMount("/", MS_SHARED | MS_REC)) return false;
 
+    // Lupine supplies one private per-generation IPC bind. Restore its propagation
+    // before cloning bootstrap/default namespaces; early-init would be too late.
+    std::string ipc_error;
+    if (!floral::KeepIpcMountPrivate(&ipc_error)) {
+        LOG(ERROR) << "Floral IPC initialization failed: " << ipc_error;
+        return false;
+    }
+
     // /apex is a private mountpoint to give different sets of APEXes for
     // the bootstrap and default mount namespaces. The processes running with
     // the bootstrap namespace get APEXes from the read-only partition.
