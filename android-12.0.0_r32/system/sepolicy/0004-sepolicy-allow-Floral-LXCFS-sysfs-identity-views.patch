From 9d9dea0bd60c0f550ea18e9b47d82a5dfe0565a0 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Mon, 17 Aug 2026 11:11:29 +0800
Subject: [PATCH] sepolicy: allow Floral LXCFS sysfs identity views

Label the synthetic NUMA and DMI targets with private sysfs types, grant read access outside isolated domains, and permit the mount helper to bind CPU, NUMA, block, and DMI directories.

Change-Id: I7fc9354b56ef375f6f681cc64218b2e73d415923
---
 prebuilts/api/31.0/private/floral_lxcfs_bind.te | 14 +++++++++++++-
 prebuilts/api/31.0/private/genfs_contexts       |  3 +++
 private/floral_lxcfs_bind.te                    | 14 +++++++++++++-
 private/genfs_contexts                          |  3 +++
 4 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/prebuilts/api/31.0/private/floral_lxcfs_bind.te b/prebuilts/api/31.0/private/floral_lxcfs_bind.te
index 3291635..0c61b30 100644
--- a/prebuilts/api/31.0/private/floral_lxcfs_bind.te
+++ b/prebuilts/api/31.0/private/floral_lxcfs_bind.te
@@ -1,5 +1,7 @@
 type floral_lxcfs_bind, domain, coredomain;
 type floral_lxcfs_bind_exec, system_file_type, exec_type, file_type;
+type sysfs_floral_dmi, fs_type, sysfs_type;
+type sysfs_floral_node, fs_type, sysfs_type;
 
 # Run the short-lived mount helper in its own init domain.
 init_daemon_domain(floral_lxcfs_bind)
@@ -12,6 +14,11 @@ allow floral_lxcfs_bind self:global_capability_class_set sys_admin;
 allow floral_lxcfs_bind fuse:dir r_dir_perms;
 allow floral_lxcfs_bind fuse:file r_file_perms;
 
+# Resource and identity views are readable like the existing CPU sysfs view.
+# Keep isolated processes within the platform's existing sysfs restrictions.
+r_dir_file({ domain -isolated_app }, sysfs_floral_dmi)
+r_dir_file({ domain -isolated_app }, sysfs_floral_node)
+
 # Avoid stacking duplicate views when init retries the oneshot service.
 allow floral_lxcfs_bind proc_mounts:file r_file_perms;
 
@@ -30,7 +37,12 @@ allow floral_lxcfs_bind {
   proc_uptime
 }:file { getattr mounton };
 allow floral_lxcfs_bind proc:dir { getattr search };
-allow floral_lxcfs_bind sysfs_devices_system_cpu:dir { getattr mounton search };
+allow floral_lxcfs_bind {
+  sysfs_block
+  sysfs_devices_system_cpu
+  sysfs_floral_dmi
+  sysfs_floral_node
+}:dir { getattr mounton search };
 
 # floral_lxcfs_bind uses android::base::KernelLogger during early boot.
 allow floral_lxcfs_bind kmsg_device:chr_file w_file_perms;
diff --git a/prebuilts/api/31.0/private/genfs_contexts b/prebuilts/api/31.0/private/genfs_contexts
index 13bfb46..322bd43 100644
--- a/prebuilts/api/31.0/private/genfs_contexts
+++ b/prebuilts/api/31.0/private/genfs_contexts
@@ -113,8 +113,10 @@ genfscon cgroup / u:object_r:cgroup:s0
 genfscon cgroup2 / u:object_r:cgroup_v2:s0
 # sysfs labels can be set by userspace.
 genfscon sysfs / u:object_r:sysfs:s0
+genfscon sysfs /block                             u:object_r:sysfs_block:s0
 genfscon sysfs /devices/cs_etm                    u:object_r:sysfs_devices_cs_etm:s0
 genfscon sysfs /devices/system/cpu u:object_r:sysfs_devices_system_cpu:s0
+genfscon sysfs /devices/system/node u:object_r:sysfs_floral_node:s0
 genfscon sysfs /class/android_usb                 u:object_r:sysfs_android_usb:s0
 genfscon sysfs /class/extcon                      u:object_r:sysfs_extcon:s0
 genfscon sysfs /class/block                       u:object_r:sysfs_block:s0
@@ -129,6 +131,7 @@ genfscon sysfs /class/switch                      u:object_r:sysfs_switch:s0
 genfscon sysfs /class/wakeup                      u:object_r:sysfs_wakeup:s0
 genfscon sysfs /devices/platform/nfc-power/nfc_power u:object_r:sysfs_nfc_power_writable:s0
 genfscon sysfs /devices/virtual/android_usb     u:object_r:sysfs_android_usb:s0
+genfscon sysfs /devices/virtual/dmi/id          u:object_r:sysfs_floral_dmi:s0
 genfscon sysfs /devices/virtual/block/            u:object_r:sysfs_devices_block:s0
 genfscon sysfs /devices/virtual/block/dm-       u:object_r:sysfs_dm:s0
 genfscon sysfs /devices/virtual/block/loop       u:object_r:sysfs_loop:s0
diff --git a/private/floral_lxcfs_bind.te b/private/floral_lxcfs_bind.te
index 3291635..0c61b30 100644
--- a/private/floral_lxcfs_bind.te
+++ b/private/floral_lxcfs_bind.te
@@ -1,5 +1,7 @@
 type floral_lxcfs_bind, domain, coredomain;
 type floral_lxcfs_bind_exec, system_file_type, exec_type, file_type;
+type sysfs_floral_dmi, fs_type, sysfs_type;
+type sysfs_floral_node, fs_type, sysfs_type;
 
 # Run the short-lived mount helper in its own init domain.
 init_daemon_domain(floral_lxcfs_bind)
@@ -12,6 +14,11 @@ allow floral_lxcfs_bind self:global_capability_class_set sys_admin;
 allow floral_lxcfs_bind fuse:dir r_dir_perms;
 allow floral_lxcfs_bind fuse:file r_file_perms;
 
+# Resource and identity views are readable like the existing CPU sysfs view.
+# Keep isolated processes within the platform's existing sysfs restrictions.
+r_dir_file({ domain -isolated_app }, sysfs_floral_dmi)
+r_dir_file({ domain -isolated_app }, sysfs_floral_node)
+
 # Avoid stacking duplicate views when init retries the oneshot service.
 allow floral_lxcfs_bind proc_mounts:file r_file_perms;
 
@@ -30,7 +37,12 @@ allow floral_lxcfs_bind {
   proc_uptime
 }:file { getattr mounton };
 allow floral_lxcfs_bind proc:dir { getattr search };
-allow floral_lxcfs_bind sysfs_devices_system_cpu:dir { getattr mounton search };
+allow floral_lxcfs_bind {
+  sysfs_block
+  sysfs_devices_system_cpu
+  sysfs_floral_dmi
+  sysfs_floral_node
+}:dir { getattr mounton search };
 
 # floral_lxcfs_bind uses android::base::KernelLogger during early boot.
 allow floral_lxcfs_bind kmsg_device:chr_file w_file_perms;
diff --git a/private/genfs_contexts b/private/genfs_contexts
index 13bfb46..322bd43 100644
--- a/private/genfs_contexts
+++ b/private/genfs_contexts
@@ -113,8 +113,10 @@ genfscon cgroup / u:object_r:cgroup:s0
 genfscon cgroup2 / u:object_r:cgroup_v2:s0
 # sysfs labels can be set by userspace.
 genfscon sysfs / u:object_r:sysfs:s0
+genfscon sysfs /block                             u:object_r:sysfs_block:s0
 genfscon sysfs /devices/cs_etm                    u:object_r:sysfs_devices_cs_etm:s0
 genfscon sysfs /devices/system/cpu u:object_r:sysfs_devices_system_cpu:s0
+genfscon sysfs /devices/system/node u:object_r:sysfs_floral_node:s0
 genfscon sysfs /class/android_usb                 u:object_r:sysfs_android_usb:s0
 genfscon sysfs /class/extcon                      u:object_r:sysfs_extcon:s0
 genfscon sysfs /class/block                       u:object_r:sysfs_block:s0
@@ -129,6 +131,7 @@ genfscon sysfs /class/switch                      u:object_r:sysfs_switch:s0
 genfscon sysfs /class/wakeup                      u:object_r:sysfs_wakeup:s0
 genfscon sysfs /devices/platform/nfc-power/nfc_power u:object_r:sysfs_nfc_power_writable:s0
 genfscon sysfs /devices/virtual/android_usb     u:object_r:sysfs_android_usb:s0
+genfscon sysfs /devices/virtual/dmi/id          u:object_r:sysfs_floral_dmi:s0
 genfscon sysfs /devices/virtual/block/            u:object_r:sysfs_devices_block:s0
 genfscon sysfs /devices/virtual/block/dm-       u:object_r:sysfs_dm:s0
 genfscon sysfs /devices/virtual/block/loop       u:object_r:sysfs_loop:s0
