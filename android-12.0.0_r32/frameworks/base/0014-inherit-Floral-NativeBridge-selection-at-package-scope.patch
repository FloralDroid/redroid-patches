From 563e6c2c3c63656ddd983caac1e3c05879ff316c Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Thu, 20 Aug 2026 17:30:49 +0800
Subject: [PATCH] frameworks: inherit NativeBridge selection at package scope

Change-Id: If620e3d4a19a5cf0e76e6b5c951e3b2e31b15162
---
 .../server/am/FloralNativeBridgeManager.java  | 33 +++++++++++--------
 1 file changed, 20 insertions(+), 13 deletions(-)

diff --git a/services/core/java/com/android/server/am/FloralNativeBridgeManager.java b/services/core/java/com/android/server/am/FloralNativeBridgeManager.java
index 913993fc55fd..d2fb685d7e6a 100644
--- a/services/core/java/com/android/server/am/FloralNativeBridgeManager.java
+++ b/services/core/java/com/android/server/am/FloralNativeBridgeManager.java
@@ -54,7 +54,9 @@ final class FloralNativeBridgeManager {
     // Translated games commonly initialize optional native SDKs well after their first frame.
     private static final long EARLY_CRASH_WINDOW_MS = 60_000L;
     private static final int MAX_JSON_BYTES = 256 * 1024;
-    private static final int STATE_VERSION = 3;
+    // Version 4 changes recovery ownership from process name to package name.
+    // Earlier state must not pin helper processes to a different backend.
+    private static final int STATE_VERSION = 4;
 
     private static final String BACKEND_AUTO = "auto";
     private static final String BACKEND_NDK = "ndk";
@@ -82,8 +84,7 @@ final class FloralNativeBridgeManager {
         // AMS lock so starting a translated process stays deterministic and cheap.
         mPolicy = mEnabled ? readJsonFile(new File(POLICY_PATH)) : null;
         mState = mEnabled ? readJsonFile(mStateFile.getBaseFile()) : emptyState();
-        if (mState == null || (mState.optInt("version", 0) != 2
-                && mState.optInt("version", 0) != STATE_VERSION)
+        if (mState == null || mState.optInt("version", 0) != STATE_VERSION
                 || !Build.FINGERPRINT.equals(mState.optString("build_fingerprint"))) {
             mState = emptyState();
         }
@@ -105,9 +106,12 @@ final class FloralNativeBridgeManager {
         }
 
         final String processName = app.processName;
+        // Persist one selection for the package. Helper processes must inherit
+        // the same backend and loader mode as the package's main process.
+        final String stateKey = app.info.packageName;
         final long versionCode = app.info.longVersionCode;
         final JSONObject packages = packagesState();
-        JSONObject state = packages.optJSONObject(processName);
+        JSONObject state = packages.optJSONObject(stateKey);
         boolean changed = false;
         if (state == null || state.optLong("version_code", Long.MIN_VALUE) != versionCode
                 || !app.info.packageName.equals(state.optString("package_name"))
@@ -122,7 +126,7 @@ final class FloralNativeBridgeManager {
             put(state, "stable", false);
             put(state, "exhausted", false);
             put(state, "failure_count", 0);
-            put(packages, processName, state);
+            put(packages, stateKey, state);
             changed = true;
         }
 
@@ -165,8 +169,8 @@ final class FloralNativeBridgeManager {
             return;
         }
 
-        final Launch launch = new Launch(processName, app.info.packageName, versionCode, selected,
-                rule.candidates, rule.preserveTaskSurface, app.getStartTime());
+        final Launch launch = new Launch(processName, stateKey, app.info.packageName, versionCode,
+                selected, rule.candidates, rule.preserveTaskSurface, app.getStartTime());
         mLaunches.put(app, launch);
         mService.mHandler.postDelayed(() -> finishStabilityWindow(app, launch),
                 EARLY_CRASH_WINDOW_MS);
@@ -182,7 +186,7 @@ final class FloralNativeBridgeManager {
                 return;
             }
             if (app.getThread() != null && !app.isKilled() && app.getPid() > 0) {
-                final JSONObject state = packagesState().optJSONObject(launch.processName);
+                final JSONObject state = packagesState().optJSONObject(launch.stateKey);
                 if (matchesLaunch(state, launch)) {
                     put(state, "stable", true);
                     writeState();
@@ -240,7 +244,7 @@ final class FloralNativeBridgeManager {
             return false;
         }
 
-        final JSONObject state = packagesState().optJSONObject(launch.processName);
+        final JSONObject state = packagesState().optJSONObject(launch.stateKey);
         if (!matchesLaunch(state, launch)) {
             return false;
         }
@@ -342,9 +346,9 @@ final class FloralNativeBridgeManager {
             return PolicyRule.automaticDefaults();
         }
         final JSONObject packages = root.optJSONObject("packages");
-        Object value = packages == null ? null : packages.opt(processName);
+        Object value = packages == null ? null : packages.opt(packageName);
         if (value == null && packages != null) {
-            value = packages.opt(packageName);
+            value = packages.opt(processName);
         }
         if (value != null) {
             return PolicyRule.parse(value);
@@ -522,6 +526,7 @@ final class FloralNativeBridgeManager {
 
     private static final class Launch {
         final String processName;
+        final String stateKey;
         final String packageName;
         final long versionCode;
         final String candidate;
@@ -529,9 +534,11 @@ final class FloralNativeBridgeManager {
         final boolean preserveTaskSurface;
         final long startUptime;
 
-        Launch(String processName, String packageName, long versionCode, String candidate,
-                ArrayList<String> candidates, boolean preserveTaskSurface, long startUptime) {
+        Launch(String processName, String stateKey, String packageName, long versionCode,
+                String candidate, ArrayList<String> candidates, boolean preserveTaskSurface,
+                long startUptime) {
             this.processName = processName;
+            this.stateKey = stateKey;
             this.packageName = packageName;
             this.versionCode = versionCode;
             this.candidate = candidate;
-- 
2.47.3

