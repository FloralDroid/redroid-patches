From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FloralDroid <floraldroid@localhost>
Date: Fri, 7 Aug 2026 14:30:00 +0800
Subject: [PATCH] Expose binder service lookup to system server modules

System server modules can publish Binder services through SystemService, but
cannot look up a vendor stable AIDL service without using hidden ServiceManager
APIs. Export the existing protected lookup method on the system-server API
surface so modular services can receive a narrow, lifecycle-owned resolver.

Change-Id: I5bbfa29d87c880ad974f066899626644fe0362aa
---
 services/api/current.txt                              | 2 +-
 services/api/lint-baseline.txt                        | 3 +++
 services/core/java/com/android/server/SystemService.java | 6 ++++--
 3 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/services/api/current.txt b/services/api/current.txt
index 50f0052..12bddf7 100644
--- a/services/api/current.txt
+++ b/services/api/current.txt
@@ -18,6 +18,7 @@ package com.android.server {
     method public void onUserSwitching(@Nullable com.android.server.SystemService.TargetUser, @NonNull com.android.server.SystemService.TargetUser);
     method public void onUserUnlocked(@NonNull com.android.server.SystemService.TargetUser);
     method public void onUserUnlocking(@NonNull com.android.server.SystemService.TargetUser);
+    method @Nullable protected final android.os.IBinder getBinderService(@NonNull String);
     method protected final void publishBinderService(@NonNull String, @NonNull android.os.IBinder);
     method protected final void publishBinderService(@NonNull String, @NonNull android.os.IBinder, boolean);
     field public static final int PHASE_ACTIVITY_MANAGER_READY = 550; // 0x226
@@ -82,4 +83,3 @@ package com.android.server.wifi {
   }
 
 }
-
diff --git a/services/api/lint-baseline.txt b/services/api/lint-baseline.txt
index b46d21e..95ee5b5 100644
--- a/services/api/lint-baseline.txt
+++ b/services/api/lint-baseline.txt
@@ -7,3 +7,6 @@ ProtectedMember: com.android.server.SystemService#publishBinderService(String, a
     Protected methods not allowed; must be public: method com.android.server.SystemService.publishBinderService(String,android.os.IBinder)}
 ProtectedMember: com.android.server.SystemService#publishBinderService(String, android.os.IBinder, boolean):
     Protected methods not allowed; must be public: method com.android.server.SystemService.publishBinderService(String,android.os.IBinder,boolean)}
+
+ProtectedMember: com.android.server.SystemService#getBinderService(String):
+    Protected methods not allowed; must be public: method com.android.server.SystemService.getBinderService(String)}
diff --git a/services/core/java/com/android/server/SystemService.java b/services/core/java/com/android/server/SystemService.java
index 39321bf..b50e6a8 100644
--- a/services/core/java/com/android/server/SystemService.java
+++ b/services/core/java/com/android/server/SystemService.java
@@ -445,9 +445,11 @@ public abstract class SystemService {
     /**
      * Get a binder service by its name.
      *
-     * @hide
+     * @param name the name of the binder service
+     * @return the registered binder, or {@code null} when the service is not available
      */
-    protected final IBinder getBinderService(String name) {
+    @Nullable
+    protected final IBinder getBinderService(@NonNull String name) {
         return ServiceManager.getService(name);
     }
 
-- 
