@@ -525,6 +525,14 @@ public abstract class ActivityTaskManagerInternal {
     public abstract int finishTopCrashedActivities(
             WindowProcessController crashedApp, String reason);
 
+    /**
+     * Keeps the crashed app's focused task visible while NativeBridge replaces its process.
+     *
+     * @return The task id prepared for recovery, or {@code INVALID_TASK_ID} if none matched.
+     */
+    public abstract int prepareNativeBridgeRecovery(
+            WindowProcessController crashedApp, String reason);
+
     public abstract void onUidActive(int uid, int procState);
     public abstract void onUidInactive(int uid);
     public abstract void onUidProcStateChanged(int uid, int procState);
diff --git a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
