diff --git a/services/core/java/com/android/server/wm/RootWindowContainer.java b/services/core/java/com/android/server/wm/RootWindowContainer.java
index 52da4b80a75d..2a3a005b717a 100644
--- a/services/core/java/com/android/server/wm/RootWindowContainer.java
+++ b/services/core/java/com/android/server/wm/RootWindowContainer.java
@@ -2305,6 +2305,21 @@ class RootWindowContainer extends WindowContainer<DisplayContent>
         return finishedTask[0] != null ? finishedTask[0].mTaskId : INVALID_TASK_ID;
     }
 
+    /**
+     * Prepares the focused task for a bounded NativeBridge process replacement without closing it.
+     */
+    int prepareNativeBridgeRecovery(WindowProcessController app, String reason) {
+        final Task focusedRootTask = getTopDisplayFocusedRootTask();
+        final Task[] recoveredTask = new Task[1];
+        forAllTasks(rootTask -> {
+            final Task task = rootTask.prepareTopActivityForNativeBridgeRecoveryLocked(app, reason);
+            if (task != null && (rootTask == focusedRootTask || recoveredTask[0] == null)) {
+                recoveredTask[0] = task;
+            }
+        });
+        return recoveredTask[0] != null ? recoveredTask[0].mTaskId : INVALID_TASK_ID;
+    }
+
     boolean resumeFocusedTasksTopActivities() {
         return resumeFocusedTasksTopActivities(null, null, null);
     }
diff --git a/services/core/java/com/android/server/wm/Task.java b/services/core/java/com/android/server/wm/Task.java
index a223336ca5b8..b968782159da 100644
--- a/services/core/java/com/android/server/wm/Task.java
+++ b/services/core/java/com/android/server/wm/Task.java
@@ -6809,6 +6809,24 @@ class Task extends WindowContainer<WindowContainer> {
         return finishedTask;
     }
 
+    /**
+     * Keeps the top activity and task surface while a NativeBridge process is replaced.
+     *
+     * @return The task prepared for recovery, or {@code null} if the top activity does not
+     *         belong to the crashed process.
+     */
+    final Task prepareTopActivityForNativeBridgeRecoveryLocked(
+            WindowProcessController app, String reason) {
+        final ActivityRecord r = topRunningActivity();
+        if (r == null || !belongsToCrashedProcess(r, app) || r.isActivityTypeHome()) {
+            return null;
+        }
+        Slog.w(TAG, "  Preserving activity for NativeBridge recovery "
+                + r.intent.getComponent().flattenToShortString() + " reason=" + reason);
+        r.prepareForNativeBridgeRecovery();
+        return r.getTask();
+    }
+
     private static boolean belongsToCrashedProcess(ActivityRecord r,
             WindowProcessController app) {
         if (r.app == app) {
