From 2ac348d155c549cfc9f143d3b8ce41790bdb9473 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Sat, 15 Aug 2026 14:08:10 +0800
Subject: [PATCH] frameworks: preserve task surface during NativeBridge
 recovery

Change-Id: I6fc3a56d4ad3372ae5dbb9c37af683161ebf9d26
---
 .../server/am/FloralNativeBridgeManager.java  | 59 +++++++++++++------
 .../com/android/server/wm/ActivityRecord.java | 16 ++++-
 .../wm/ActivityTaskManagerInternal.java       |  8 +++
 .../server/wm/ActivityTaskManagerService.java |  8 +++
 .../server/wm/RootWindowContainer.java        | 15 +++++
 .../core/java/com/android/server/wm/Task.java | 18 ++++++
 6 files changed, 103 insertions(+), 21 deletions(-)

diff --git a/services/core/java/com/android/server/am/FloralNativeBridgeManager.java b/services/core/java/com/android/server/am/FloralNativeBridgeManager.java
index 751abb1cc3ce..1f1255e3456b 100644
--- a/services/core/java/com/android/server/am/FloralNativeBridgeManager.java
+++ b/services/core/java/com/android/server/am/FloralNativeBridgeManager.java
@@ -145,7 +145,7 @@ final class FloralNativeBridgeManager {
         }
 
         final Launch launch = new Launch(processName, app.info.packageName, versionCode, selected,
-                rule.candidates, app.getStartTime());
+                rule.candidates, rule.preserveTaskSurface, app.getStartTime());
         mLaunches.put(app, launch);
         mService.mHandler.postDelayed(() -> finishStabilityWindow(app, launch),
                 EARLY_CRASH_WINDOW_MS);
@@ -205,32 +205,40 @@ final class FloralNativeBridgeManager {
         mLaunches.remove(app);
 
         // A pre-top activity can crash before WindowManager attaches its ActivityRecord to this
-        // process. Preserve that launch identity so the starting window does not remain forever.
-        // Child services and helper processes still must not tear down the user's task.
+        // process. Child services and helper processes still must not tear down the user's task.
         final HostingRecord hostingRecord = app.getHostingRecord();
         final boolean restartTask = (hostingRecord != null && hostingRecord.isTopApp())
                 || (app == mService.getTopApp() && app.hasActivities());
-        final int taskId = restartTask
-                ? mService.mAtmInternal.finishTopCrashedActivities(
-                        app.getWindowProcessController(), "floral-nativebridge-fallback")
-                : INVALID_TASK_ID;
+        final int taskId;
+        if (!restartTask) {
+            taskId = INVALID_TASK_ID;
+        } else if (launch.preserveTaskSurface) {
+            taskId = mService.mAtmInternal.prepareNativeBridgeRecovery(
+                    app.getWindowProcessController(), "floral-nativebridge-fallback");
+        } else {
+            taskId = mService.mAtmInternal.finishTopCrashedActivities(
+                    app.getWindowProcessController(), "floral-nativebridge-fallback");
+        }
         mService.mProcessList.removeProcessLocked(app, false, true,
                 ApplicationExitInfo.REASON_CRASH_NATIVE, "native bridge fallback");
         Slog.w(TAG, "Early native crash in " + launch.processName + "; switching "
                 + launch.backend + " to " + replacement);
 
         if (taskId != INVALID_TASK_ID) {
-            // Restart on the next AMS turn after process cleanup, without exposing a
-            // fixed blank interval between the old and replacement process.
-            mService.mHandler.post(() -> restartTask(taskId));
+            // Restart on the next AMS turn after process cleanup. A zero-duration task
+            // animation prevents the recovery launch itself from exposing an intermediate frame.
+            mService.mHandler.post(() -> restartTask(taskId, launch.preserveTaskSurface));
         }
         return true;
     }
 
-    private void restartTask(int taskId) {
+    private void restartTask(int taskId, boolean preserveTaskSurface) {
         try {
-            mService.startActivityFromRecents(taskId,
-                    ActivityOptions.makeBasic().toBundle());
+            final ActivityOptions options = preserveTaskSurface
+                    ? ActivityOptions.makeCustomTaskAnimation(
+                            mService.mContext, 0, 0, null, null, null)
+                    : ActivityOptions.makeBasic();
+            mService.startActivityFromRecents(taskId, options.toBundle());
         } catch (IllegalArgumentException e) {
             Slog.w(TAG, "Unable to restart task " + taskId + " after fallback", e);
         }
@@ -376,15 +384,17 @@ final class FloralNativeBridgeManager {
         final long versionCode;
         final String backend;
         final ArrayList<String> candidates;
+        final boolean preserveTaskSurface;
         final long startUptime;
 
         Launch(String processName, String packageName, long versionCode, String backend,
-                ArrayList<String> candidates, long startUptime) {
+                ArrayList<String> candidates, boolean preserveTaskSurface, long startUptime) {
             this.processName = processName;
             this.packageName = packageName;
             this.versionCode = versionCode;
             this.backend = backend;
             this.candidates = new ArrayList<>(candidates);
+            this.preserveTaskSurface = preserveTaskSurface;
             this.startUptime = startUptime;
         }
     }
@@ -392,17 +402,19 @@ final class FloralNativeBridgeManager {
     private static final class PolicyRule {
         final boolean automatic;
         final ArrayList<String> candidates;
+        final boolean preserveTaskSurface;
 
-        PolicyRule(boolean automatic, ArrayList<String> candidates) {
+        PolicyRule(boolean automatic, ArrayList<String> candidates, boolean preserveTaskSurface) {
             this.automatic = automatic;
-            this.candidates = candidates;
+            this.candidates = new ArrayList<>(candidates);
+            this.preserveTaskSurface = preserveTaskSurface;
         }
 
         static PolicyRule automaticDefaults() {
             final ArrayList<String> candidates = new ArrayList<>();
             candidates.add(BACKEND_NDK);
             candidates.add(BACKEND_HOUDINI);
-            return new PolicyRule(true, candidates);
+            return new PolicyRule(true, candidates, true);
         }
 
         static PolicyRule preferred(String backend) {
@@ -426,6 +438,15 @@ final class FloralNativeBridgeManager {
             }
 
             final JSONObject object = (JSONObject) value;
+            final boolean preserveTaskSurface = object.optBoolean("preserve_starting_surface",
+                    !"finish_and_restart".equals(object.optString(
+                            "recovery", "preserve_task_surface")));
+            final PolicyRule selection = parseSelection(object);
+            return new PolicyRule(selection.automatic, selection.candidates,
+                    preserveTaskSurface);
+        }
+
+        private static PolicyRule parseSelection(JSONObject object) {
             String backend = object.optString("selected_backend", "");
             if (backend.isEmpty()) {
                 backend = object.optString("backend", "");
@@ -464,14 +485,14 @@ final class FloralNativeBridgeManager {
                 }
             }
             return candidates.isEmpty() ? automaticDefaults()
-                    : new PolicyRule(true, candidates);
+                    : new PolicyRule(true, candidates, true);
         }
 
         private static PolicyRule explicit(String backend) {
             final ArrayList<String> candidates = new ArrayList<>();
             if (isBackend(backend)) {
                 candidates.add(backend);
-                return new PolicyRule(false, candidates);
+                return new PolicyRule(false, candidates, true);
             }
             return automaticDefaults();
         }
diff --git a/services/core/java/com/android/server/wm/ActivityRecord.java b/services/core/java/com/android/server/wm/ActivityRecord.java
