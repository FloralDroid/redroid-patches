         return recoveredTask[0] != null ? recoveredTask[0].mTaskId : INVALID_TASK_ID;
     }
 
+    /** Clears any task-surface preservation left by an exhausted NativeBridge recovery. */
+    void cancelNativeBridgeRecovery(WindowProcessController app) {
+        forAllTasks(rootTask -> {
+            rootTask.cancelTopActivityNativeBridgeRecoveryLocked(app);
+        });
+    }
+
     boolean resumeFocusedTasksTopActivities() {
         return resumeFocusedTasksTopActivities(null, null, null);
     }
diff --git a/services/core/java/com/android/server/wm/Task.java b/services/core/java/com/android/server/wm/Task.java
index b968782159da..dd28525e55f6 100644
--- a/services/core/java/com/android/server/wm/Task.java
+++ b/services/core/java/com/android/server/wm/Task.java
@@ -6827,6 +6827,14 @@ class Task extends WindowContainer<WindowContainer> {
         return r.getTask();
     }
 
+    /** Restores ordinary crash cleanup after NativeBridge has no replacement candidate. */
+    final void cancelTopActivityNativeBridgeRecoveryLocked(WindowProcessController app) {
+        final ActivityRecord r = topRunningActivity();
+        if (r != null && belongsToCrashedProcess(r, app)) {
+            r.cancelNativeBridgeRecovery();
+        }
+    }
+
     private static boolean belongsToCrashedProcess(ActivityRecord r,
             WindowProcessController app) {
         if (r.app == app) {
@@ -6834,7 +6842,8 @@ class Task extends WindowContainer<WindowContainer> {
         }
         // During an asynchronous pre-top launch, native initialization may fail before the
         // ActivityRecord is attached. Process name and uid uniquely identify that pending process.
-        return r.app == null && r.isState(ActivityState.INITIALIZING)
+        return r.app == null
+                && r.isState(ActivityState.INITIALIZING, ActivityState.RESTARTING_PROCESS)
                 && r.getUid() == app.mUid && app.mName.equals(r.processName);
     }
 
