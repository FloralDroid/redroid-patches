@@ -265,13 +298,15 @@ final class FloralNativeBridgeManager {
 
     private static JSONObject emptyState() {
         final JSONObject root = new JSONObject();
-        put(root, "version", 1);
+        put(root, "version", STATE_VERSION);
+        put(root, "build_fingerprint", Build.FINGERPRINT);
         put(root, "packages", new JSONObject());
         return root;
     }
 
     private static boolean matchesLaunch(JSONObject state, Launch launch) {
         return state != null
+                && launch.packageName.equals(state.optString("package_name"))
                 && state.optLong("version_code", Long.MIN_VALUE) == launch.versionCode
                 && launch.backend.equals(state.optString("selected_backend"));
     }
@@ -333,14 +368,16 @@ final class FloralNativeBridgeManager {
 
