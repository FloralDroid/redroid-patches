@@ -172,6 +178,29 @@ final class FloralNativeBridgeManager {
 
     /** Handles only an early translated native crash with an available fallback. */
     boolean handleEarlyNativeCrash(ProcessRecord app) {
+        return handleEarlyFailure(app, "native crash", ApplicationExitInfo.REASON_CRASH_NATIVE);
+    }
+
+    /**
+     * Handles the narrow Java failure emitted when a translated JNI method was
+     * not registered by the selected backend. Ordinary Java crashes stay on
+     * Android's normal error path.
+     */
+    boolean handleEarlyNativeLoaderError(ProcessRecord app,
+            ApplicationErrorReport.CrashInfo crashInfo) {
+        if (crashInfo == null
+                || !"java.lang.UnsatisfiedLinkError".equals(crashInfo.exceptionClassName)
+                || crashInfo.exceptionMessage == null
+                || !crashInfo.exceptionMessage.contains("No implementation found")
+                || crashInfo.stackTrace == null
+                || !crashInfo.stackTrace.contains("com.bun.miitmdid")) {
+            return false;
+        }
+        return handleEarlyFailure(app, "native loader error", ApplicationExitInfo.REASON_CRASH);
+    }
+
+    private boolean handleEarlyFailure(ProcessRecord app, String failure,
+            int exitReason) {
         final Launch launch = mLaunches.get(app);
         if (launch == null || SystemClock.uptimeMillis() - launch.startUptime
                 > EARLY_CRASH_WINDOW_MS) {
@@ -182,24 +211,25 @@ final class FloralNativeBridgeManager {
         if (!matchesLaunch(state, launch)) {
             return false;
         }
-        final ArraySet<String> failed = readBackends(state.optJSONArray("failed_backends"));
-        failed.add(launch.backend);
+        final ArraySet<String> failed = readFailedCandidates(state);
+        failed.add(launch.candidate);
         final String replacement = firstAvailable(launch.candidates, failed);
-        put(state, "failed_backends", toJsonArray(failed));
+        put(state, "failed_candidates", toJsonArray(failed));
         put(state, "stable", false);
         put(state, "failure_count", state.optInt("failure_count", 0) + 1);
         put(state, "last_failure_timestamp_ms", System.currentTimeMillis());
         if (replacement == null) {
             put(state, "selected_backend", "");
+            put(state, "selected_loader_mode", "");
             put(state, "exhausted", true);
             writeState();
             mLaunches.remove(app);
             Slog.w(TAG, "NativeBridge candidates exhausted after " + launch.processName
-                    + " crashed with " + launch.backend);
+                    + " failed with " + launch.candidate + " (" + failure + ")");
             return false;
         }
 
-        put(state, "selected_backend", replacement);
+        putSelectedCandidate(state, replacement);
         put(state, "exhausted", false);
         writeState();
         mLaunches.remove(app);
@@ -220,9 +250,9 @@ final class FloralNativeBridgeManager {
                     app.getWindowProcessController(), "floral-nativebridge-fallback");
         }
         mService.mProcessList.removeProcessLocked(app, false, true,
-                ApplicationExitInfo.REASON_CRASH_NATIVE, "native bridge fallback");
-        Slog.w(TAG, "Early native crash in " + launch.processName + "; switching "
-                + launch.backend + " to " + replacement);
+                exitReason, "native bridge fallback");
+        Slog.w(TAG, "Early NativeBridge failure in " + launch.processName + "; switching "
+                + launch.candidate + " to " + replacement + " (" + failure + ")");
 
         if (taskId != INVALID_TASK_ID) {
             // Restart on the next AMS turn after process cleanup. A zero-duration task
@@ -320,7 +350,7 @@ final class FloralNativeBridgeManager {
         return state != null
                 && launch.packageName.equals(state.optString("package_name"))
                 && state.optLong("version_code", Long.MIN_VALUE) == launch.versionCode
-                && launch.backend.equals(state.optString("selected_backend"));
+                && launch.candidate.equals(selectedCandidate(state));
     }
 
     private static boolean sameCandidates(JSONArray json, ArrayList<String> candidates) {
@@ -335,18 +365,70 @@ final class FloralNativeBridgeManager {
         return true;
     }
 
-    private static ArraySet<String> readBackends(JSONArray json) {
-        final ArraySet<String> backends = new ArraySet<>();
+    private static ArraySet<String> readCandidates(JSONArray json) {
+        final ArraySet<String> candidates = new ArraySet<>();
         if (json == null) {
-            return backends;
+            return candidates;
         }
         for (int i = 0; i < json.length(); i++) {
-            final String backend = json.optString(i);
-            if (isBackend(backend)) {
-                backends.add(backend);
+            final String candidate = json.optString(i);
+            if (isCandidate(candidate)) {
+                candidates.add(candidate);
+            }
+        }
+        return candidates;
+    }
+
+    private static ArraySet<String> readFailedCandidates(JSONObject state) {
+        final ArraySet<String> failed = readCandidates(
+                state.optJSONArray("failed_candidates"));
+        // State version 2 only knew about backends. Treat those records as a
+        // failed hybrid attempt so the new compat candidate can still run.
+        final JSONArray legacy = state.optJSONArray("failed_backends");
+        if (legacy != null) {
+            for (int i = 0; i < legacy.length(); i++) {
+                final String backend = legacy.optString(i);
+                if (isBackend(backend)) {
+                    failed.add(candidateName(backend, MODE_HYBRID));
+                }
             }
         }
-        return backends;
+        return failed;
+    }
+
+    private static String selectedCandidate(JSONObject state) {
+        if (state == null) {
+            return "";
+        }
+        final String backend = state.optString("selected_backend", "");
+        final String mode = state.optString("selected_loader_mode", MODE_HYBRID);
+        return isBackend(backend) && isMode(mode) ? candidateName(backend, mode) : "";
+    }
+
+    private static void putSelectedCandidate(JSONObject state, String candidate) {
+        final int separator = candidate.indexOf('/');
+        if (separator <= 0 || separator == candidate.length() - 1) {
+            put(state, "selected_backend", "");
+            put(state, "selected_loader_mode", "");
+            return;
+        }
+        put(state, "selected_backend", candidate.substring(0, separator));
+        put(state, "selected_loader_mode", candidate.substring(separator + 1));
+    }
+
+    private static String candidateName(String backend, String mode) {
+        return backend + "/" + mode;
+    }
+
+    private static boolean isCandidate(String value) {
+        final int separator = value.indexOf('/');
+        return separator > 0 && separator < value.length() - 1
+                && isBackend(value.substring(0, separator))
+                && isMode(value.substring(separator + 1));
+    }
+
+    private static boolean isMode(String value) {
+        return MODE_HYBRID.equals(value) || MODE_COMPAT.equals(value);
     }
 
     private static String firstAvailable(ArrayList<String> candidates, ArraySet<String> failed) {
@@ -382,17 +464,17 @@ final class FloralNativeBridgeManager {
         final String processName;
         final String packageName;
         final long versionCode;
-        final String backend;
+        final String candidate;
         final ArrayList<String> candidates;
         final boolean preserveTaskSurface;
         final long startUptime;
 
-        Launch(String processName, String packageName, long versionCode, String backend,
+        Launch(String processName, String packageName, long versionCode, String candidate,
                 ArrayList<String> candidates, boolean preserveTaskSurface, long startUptime) {
             this.processName = processName;
             this.packageName = packageName;
             this.versionCode = versionCode;
-            this.backend = backend;
+            this.candidate = candidate;
             this.candidates = new ArrayList<>(candidates);
             this.preserveTaskSurface = preserveTaskSurface;
             this.startUptime = startUptime;
@@ -412,8 +494,8 @@ final class FloralNativeBridgeManager {
 
         static PolicyRule automaticDefaults() {
             final ArrayList<String> candidates = new ArrayList<>();
-            candidates.add(BACKEND_NDK);
-            candidates.add(BACKEND_HOUDINI);
+            addBackendCandidates(candidates, BACKEND_NDK);
+            addBackendCandidates(candidates, BACKEND_HOUDINI);
             return new PolicyRule(true, candidates, true);
         }
 
@@ -421,8 +503,8 @@ final class FloralNativeBridgeManager {
             final PolicyRule rule = automaticDefaults();
             if (BACKEND_HOUDINI.equals(backend)) {
                 rule.candidates.clear();
-                rule.candidates.add(BACKEND_HOUDINI);
-                rule.candidates.add(BACKEND_NDK);
+                addBackendCandidates(rule.candidates, BACKEND_HOUDINI);
+                addBackendCandidates(rule.candidates, BACKEND_NDK);
             }
             return rule;
         }
@@ -459,8 +541,7 @@ final class FloralNativeBridgeManager {
                         return preferred(preferred);
                     }
                     final PolicyRule rule = fromCandidates(array);
-                    rule.candidates.remove(preferred);
-                    rule.candidates.add(0, preferred);
+                    reorderBackendFirst(rule.candidates, preferred);
                     return rule;
                 }
             }
@@ -475,26 +556,53 @@ final class FloralNativeBridgeManager {
         }
 
         private static PolicyRule fromCandidates(JSONArray array) {
-            final ArrayList<String> candidates = new ArrayList<>();
+            final ArrayList<String> backends = new ArrayList<>();
             if (array != null) {
                 for (int i = 0; i < array.length(); i++) {
                     final String candidate = array.optString(i);
-                    if (isBackend(candidate) && !candidates.contains(candidate)) {
-                        candidates.add(candidate);
+                    if (isBackend(candidate) && !backends.contains(candidate)) {
+                        backends.add(candidate);
                     }
                 }
             }
-            return candidates.isEmpty() ? automaticDefaults()
-                    : new PolicyRule(true, candidates, true);
+            if (backends.isEmpty()) {
+                return automaticDefaults();
+            }
+            final ArrayList<String> candidates = new ArrayList<>();
+            for (String backend : backends) {
+                addBackendCandidates(candidates, backend);
+            }
+            return new PolicyRule(true, candidates, true);
         }
 
         private static PolicyRule explicit(String backend) {
             final ArrayList<String> candidates = new ArrayList<>();
             if (isBackend(backend)) {
-                candidates.add(backend);
+                addBackendCandidates(candidates, backend);
                 return new PolicyRule(false, candidates, true);
             }
             return automaticDefaults();
         }
+
+        private static void addBackendCandidates(ArrayList<String> candidates, String backend) {
+            candidates.add(candidateName(backend, MODE_HYBRID));
+            candidates.add(candidateName(backend, MODE_COMPAT));
+        }
+
+        private static void reorderBackendFirst(ArrayList<String> candidates, String backend) {
+            final ArrayList<String> ordered = new ArrayList<>();
+            for (String candidate : candidates) {
+                if (candidate.startsWith(backend + "/")) {
+                    ordered.add(candidate);
+                }
+            }
+            for (String candidate : candidates) {
+                if (!candidate.startsWith(backend + "/")) {
+                    ordered.add(candidate);
+                }
+            }
+            candidates.clear();
+            candidates.addAll(ordered);
+        }
     }
 }
