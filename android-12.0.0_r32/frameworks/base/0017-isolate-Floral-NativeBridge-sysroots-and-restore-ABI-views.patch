+static void MountFloralNativeBridgeSysroot(const std::string& backend,
+                                           const std::string& instruction_set,
+                                           fail_fn_t fail_fn) {
+  const size_t separator = backend.find('/');
+  const std::string backend_name = separator == std::string::npos
+          ? backend : backend.substr(0, separator);
+  if (backend_name != "ndk" && backend_name != "houdini") {
+    fail_fn(CREATE_ERROR("Unknown Floral NativeBridge backend: %s", backend.c_str()));
+    return;
+  }
+
+  // NDK Translation uses the ARM guest userspace produced by this AOSP
+  // build. Only Houdini owns a private guest sysroot that must be mounted.
+  if (backend_name == "ndk") {
+    return;
+  }
+
+  const bool arm64 = instruction_set == "arm64" || instruction_set == "arm64-v8a";
+  const std::string root = "/system/floral/" + backend_name;
+  const std::string lib_root = root + (arm64 ? "/lib64" : "/lib");
+  const std::string guest_lib = lib_root + (arm64 ? "/arm64" : "/arm");
+  const std::string guest_bin = root + "/bin/" + (arm64 ? "arm64" : "arm");
+  const std::string guest_lib_target = arm64 ? "/system/lib64/arm64" : "/system/lib/arm";
+  const std::string guest_bin_target = arm64 ? "/system/bin/arm64" : "/system/bin/arm";
+
+  struct stat source_stat;
+  if (TEMP_FAILURE_RETRY(stat(guest_lib.c_str(), &source_stat)) == -1 ||
+      !S_ISDIR(source_stat.st_mode)) {
+    fail_fn(CREATE_ERROR("Missing Floral NativeBridge guest library directory: %s",
+                         guest_lib.c_str()));
+    return;
+  }
+  PrepareDirIfNotPresent(guest_lib_target, 0755, AID_ROOT, AID_ROOT, fail_fn);
+  if (!BindMount(guest_lib, guest_lib_target)) {
+    fail_fn(CREATE_ERROR("Failed to mount Floral NativeBridge guest libraries %s to %s: %s",
+                         guest_lib.c_str(), guest_lib_target.c_str(), strerror(errno)));
+    return;
+  }
+
+  // NDK Translation keeps its guest linker and app_process under an ABI
+  // directory. Houdini resolves the host linker itself and does not ship this
+  // directory, so never replace the host /system/bin/linker[64].
+  if (TEMP_FAILURE_RETRY(stat(guest_bin.c_str(), &source_stat)) == 0 &&
+      S_ISDIR(source_stat.st_mode)) {
+    PrepareDirIfNotPresent(guest_bin_target, 0755, AID_ROOT, AID_ROOT, fail_fn);
+    if (!BindMount(guest_bin, guest_bin_target)) {
+      fail_fn(CREATE_ERROR("Failed to mount Floral NativeBridge guest binaries %s to %s: %s",
+                           guest_bin.c_str(), guest_bin_target.c_str(), strerror(errno)));
+      return;
+    }
+  }
+
+  const std::string config = root + "/etc/ld.config." + (arm64 ? "arm64" : "arm") + ".txt";
+  if (TEMP_FAILURE_RETRY(stat(config.c_str(), &source_stat)) == 0 &&
+      S_ISREG(source_stat.st_mode)) {
+    const char* target = arm64 ? "/system/etc/ld.config.arm64.txt"
+                               : "/system/etc/ld.config.arm.txt";
+    struct stat target_stat;
+    if (TEMP_FAILURE_RETRY(stat(target, &target_stat)) == -1) {
+      const int fd = TEMP_FAILURE_RETRY(open(target, O_CREAT | O_WRONLY | O_CLOEXEC, 0644));
+      if (fd == -1) {
+        fail_fn(CREATE_ERROR("Failed to create Floral NativeBridge linker config target %s: %s",
+                             target, strerror(errno)));
+        return;
+      }
+      close(fd);
+    }
+    if (TEMP_FAILURE_RETRY(mount(config.c_str(), target, nullptr, MS_BIND, nullptr)) == -1) {
+      fail_fn(CREATE_ERROR("Failed to mount Floral NativeBridge linker config %s to %s: %s",
+                           config.c_str(), target, strerror(errno)));
+      return;
+    }
+  }
+
+  const std::string cpuinfo = root + "/etc/cpuinfo." + (arm64 ? "arm64" : "arm") + ".txt";
+  if (TEMP_FAILURE_RETRY(stat(cpuinfo.c_str(), &source_stat)) == 0 &&
+      S_ISREG(source_stat.st_mode)) {
+    const char* target = arm64 ? "/system/etc/cpuinfo.arm64.txt"
+                               : "/system/etc/cpuinfo.arm.txt";
+    struct stat target_stat;
+    if (TEMP_FAILURE_RETRY(stat(target, &target_stat)) == -1) {
+      const int fd = TEMP_FAILURE_RETRY(open(target, O_CREAT | O_WRONLY | O_CLOEXEC, 0644));
+      if (fd == -1) {
+        fail_fn(CREATE_ERROR("Failed to create Floral NativeBridge cpuinfo target %s: %s",
+                             target, strerror(errno)));
+        return;
+      }
+      close(fd);
+    }
+    if (TEMP_FAILURE_RETRY(mount(cpuinfo.c_str(), target, nullptr, MS_BIND, nullptr)) == -1) {
+      fail_fn(CREATE_ERROR("Failed to mount Floral NativeBridge cpuinfo %s to %s: %s",
+                           cpuinfo.c_str(), target, strerror(errno)));
+    }
+  }
+}
