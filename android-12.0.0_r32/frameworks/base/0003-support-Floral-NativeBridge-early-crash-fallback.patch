+
+package com.android.server.am;
+
+import static android.app.ActivityTaskManager.INVALID_TASK_ID;
+
+import android.app.ActivityOptions;
+import android.app.ApplicationExitInfo;
+import android.os.FileUtils;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.util.ArrayMap;
+import android.util.ArraySet;
+import android.util.AtomicFile;
+import android.util.Slog;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+
+/** Coordinates per-process recovery for Floral's aggregate NativeBridge. */
+final class FloralNativeBridgeManager {
+    private static final String TAG = "FloralNativeBridge";
+    private static final String POLICY_PATH =
+            "/data/system/floral/nativebridge-policy.json";
+    private static final String STATE_PATH =
+            "/data/system/floral/nativebridge-state.json";
+    // Translated games commonly initialize optional native SDKs well after their first frame.
+    private static final long EARLY_CRASH_WINDOW_MS = 60_000L;
+    private static final int MAX_JSON_BYTES = 256 * 1024;
+
+    private static final String BACKEND_AUTO = "auto";
+    private static final String BACKEND_NDK = "ndk";
+    private static final String BACKEND_HOUDINI = "houdini";
+
+    private final ActivityManagerService mService;
+    private final AtomicFile mStateFile = new AtomicFile(new File(STATE_PATH));
+    private final ArrayMap<ProcessRecord, Launch> mLaunches = new ArrayMap<>();
+    private JSONObject mState;
+
+    FloralNativeBridgeManager(ActivityManagerService service) {
+        mService = service;
+        mState = readJsonFile(mStateFile.getBaseFile());
+        if (mState == null) {
+            mState = emptyState();
+        }
+    }
+
+    /** Called while holding the ActivityManagerService lock, before zygote fork. */
+    void onProcessStarting(ProcessRecord app) {
+        mLaunches.remove(app);
+        if (!isTranslatedApp(app)) {
+            return;
+        }
+
+        final PolicyRule rule = resolvePolicy(app.processName, app.info.packageName);
+        if (!rule.automatic || rule.candidates.isEmpty()) {
+            return;
+        }
+
+        final String processName = app.processName;
+        final long versionCode = app.info.longVersionCode;
+        final JSONObject packages = packagesState();
+        JSONObject state = packages.optJSONObject(processName);
+        boolean changed = false;
+        if (state == null || state.optLong("version_code", Long.MIN_VALUE) != versionCode
+                || !sameCandidates(state.optJSONArray("candidates"), rule.candidates)) {
+            state = new JSONObject();
+            put(state, "version_code", versionCode);
+            put(state, "candidates", toJsonArray(rule.candidates));
+            put(state, "failed_backends", new JSONArray());
+            put(state, "selected_backend", rule.candidates.get(0));
+            put(state, "stable", false);
+            put(packages, processName, state);
+            changed = true;
+        }
+
+        final ArraySet<String> failed = readBackends(state.optJSONArray("failed_backends"));
+        String selected = state.optString("selected_backend", "");
+        if (!rule.candidates.contains(selected) || failed.contains(selected)) {
+            final String replacement = firstAvailable(rule.candidates, failed);
+            if (replacement == null) {
+                if (changed) {
+                    writeState();
+                }
+                Slog.w(TAG, "NativeBridge candidates exhausted for " + processName);
+                return;
+            }
+            selected = replacement;
+            put(state, "selected_backend", selected);
+            changed = true;
+        }
+        if (selected.isEmpty()) {
+            return;
+        }
+        if (state.optBoolean("stable", false)) {
+            put(state, "stable", false);
+            changed = true;
+        }
+        if (changed) {
+            writeState();
+        }
+
+        final Launch launch = new Launch(processName, versionCode, selected,
+                rule.candidates, app.getStartTime());
+        mLaunches.put(app, launch);
+        mService.mHandler.postDelayed(() -> finishStabilityWindow(app, launch),
+                EARLY_CRASH_WINDOW_MS);
+        Slog.i(TAG, "Starting " + processName + " with " + selected);
+    }
+
+    private void finishStabilityWindow(ProcessRecord app, Launch launch) {
+        synchronized (mService) {
+            if (mLaunches.get(app) != launch) {
+                return;
+            }
+            if (app.getThread() != null && !app.isKilled() && app.getPid() > 0) {
+                final JSONObject state = packagesState().optJSONObject(launch.processName);
+                if (matchesLaunch(state, launch)) {
+                    put(state, "stable", true);
+                    writeState();
+                    Slog.i(TAG, "NativeBridge stable for " + launch.processName
+                            + " with " + launch.backend);
+                }
+            }
+            mLaunches.remove(app);
+        }
+    }
+
+    /** Handles only an early translated native crash with an unused fallback. */
+    boolean handleEarlyNativeCrash(ProcessRecord app) {
+        final Launch launch = mLaunches.get(app);
+        if (launch == null || SystemClock.uptimeMillis() - launch.startUptime
+                > EARLY_CRASH_WINDOW_MS) {
+            return false;
+        }
+
+        final JSONObject state = packagesState().optJSONObject(launch.processName);
+        if (!matchesLaunch(state, launch)) {
+            return false;
+        }
+        final ArraySet<String> failed = readBackends(state.optJSONArray("failed_backends"));
+        failed.add(launch.backend);
+        final String replacement = firstAvailable(launch.candidates, failed);
+        put(state, "failed_backends", toJsonArray(failed));
+        put(state, "stable", false);
+        if (replacement == null) {
+            writeState();
+            mLaunches.remove(app);
+            Slog.w(TAG, "NativeBridge candidates exhausted after " + launch.processName
+                    + " crashed with " + launch.backend);
+            return false;
+        }
+
+        put(state, "selected_backend", replacement);
+        writeState();
+        mLaunches.remove(app);
+
+        final int taskId = mService.mAtmInternal.finishTopCrashedActivities(
+                app.getWindowProcessController(), "floral-nativebridge-fallback");
+        mService.mProcessList.removeProcessLocked(app, false, true,
+                ApplicationExitInfo.REASON_CRASH_NATIVE, "native bridge fallback");
+        Slog.w(TAG, "Early native crash in " + launch.processName + "; switching "
+                + launch.backend + " to " + replacement);
+
+        if (taskId != INVALID_TASK_ID) {
+            // Restart on the next AMS turn after process cleanup, without exposing a
+            // fixed blank interval between the old and replacement process.
+            mService.mHandler.post(() -> restartTask(taskId));
+        }
+        return true;
+    }
+
+    private void restartTask(int taskId) {
+        try {
+            mService.startActivityFromRecents(taskId,
+                    ActivityOptions.makeBasic().toBundle());
+        } catch (IllegalArgumentException e) {
+            Slog.w(TAG, "Unable to restart task " + taskId + " after fallback", e);
+        }
+    }
+
+    private static boolean isTranslatedApp(ProcessRecord app) {
+        if (app.info == null || !UserHandle.isApp(app.uid) || app.isolated) {
+            return false;
+        }
+        final String instructionSet = app.getInstructionSet();
+        return "arm".equals(instructionSet) || "arm64".equals(instructionSet);
+    }
+
+    private PolicyRule resolvePolicy(String processName, String packageName) {
+        final JSONObject root = readJsonFile(new File(POLICY_PATH));
+        if (root == null) {
+            return PolicyRule.automaticDefaults();
+        }
+        final JSONObject packages = root.optJSONObject("packages");
+        Object value = packages == null ? null : packages.opt(processName);
+        if (value == null && packages != null) {
+            value = packages.opt(packageName);
+        }
+        if (value != null) {
+            return PolicyRule.parse(value);
+        }
+        if (root.has("default_backend")) {
+            return PolicyRule.parse(root.opt("default_backend"));
+        }
+        return PolicyRule.preferred(root.optString("preferred_backend", ""));
+    }
+
+    private JSONObject packagesState() {
+        JSONObject packages = mState.optJSONObject("packages");
+        if (packages == null) {
+            packages = new JSONObject();
+            put(mState, "packages", packages);
+        }
+        return packages;
+    }
+
+    private void writeState() {
+        FileOutputStream output = null;
+        try {
+            output = mStateFile.startWrite();
+            output.write(mState.toString().getBytes(StandardCharsets.UTF_8));
+            mStateFile.finishWrite(output);
+            FileUtils.setPermissions(STATE_PATH,
+                    FileUtils.S_IRUSR | FileUtils.S_IWUSR, -1, -1);
+        } catch (IOException e) {
+            if (output != null) {
+                mStateFile.failWrite(output);
+            }
+            Slog.e(TAG, "Unable to persist NativeBridge state", e);
+        }
+    }
+
+    private static JSONObject readJsonFile(File file) {
+        if (!file.isFile()) {
+            return null;
+        }
+        try {
+            return new JSONObject(FileUtils.readTextFile(file, MAX_JSON_BYTES, null));
+        } catch (IOException | JSONException e) {
+            Slog.w(TAG, "Ignoring invalid NativeBridge JSON at " + file, e);
+            return null;
+        }
+    }
+
+    private static JSONObject emptyState() {
+        final JSONObject root = new JSONObject();
+        put(root, "version", 1);
+        put(root, "packages", new JSONObject());
+        return root;
+    }
+
+    private static boolean matchesLaunch(JSONObject state, Launch launch) {
+        return state != null
+                && state.optLong("version_code", Long.MIN_VALUE) == launch.versionCode
+                && launch.backend.equals(state.optString("selected_backend"));
+    }
+
+    private static boolean sameCandidates(JSONArray json, ArrayList<String> candidates) {
+        if (json == null || json.length() != candidates.size()) {
+            return false;
+        }
+        for (int i = 0; i < candidates.size(); i++) {
+            if (!candidates.get(i).equals(json.optString(i))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static ArraySet<String> readBackends(JSONArray json) {
+        final ArraySet<String> backends = new ArraySet<>();
+        if (json == null) {
+            return backends;
+        }
+        for (int i = 0; i < json.length(); i++) {
+            final String backend = json.optString(i);
+            if (isBackend(backend)) {
+                backends.add(backend);
+            }
+        }
+        return backends;
+    }
+
+    private static String firstAvailable(ArrayList<String> candidates, ArraySet<String> failed) {
+        for (String candidate : candidates) {
+            if (!failed.contains(candidate)) {
+                return candidate;
+            }
+        }
+        return null;
+    }
+
+    private static JSONArray toJsonArray(Iterable<String> values) {
+        final JSONArray result = new JSONArray();
+        for (String value : values) {
+            result.put(value);
+        }
+        return result;
+    }
+
+    private static boolean isBackend(String value) {
+        return BACKEND_NDK.equals(value) || BACKEND_HOUDINI.equals(value);
+    }
+
+    private static void put(JSONObject object, String key, Object value) {
+        try {
+            object.put(key, value);
+        } catch (JSONException e) {
+            throw new IllegalStateException("Unable to construct NativeBridge state", e);
+        }
+    }
+
+    private static final class Launch {
+        final String processName;
+        final long versionCode;
+        final String backend;
+        final ArrayList<String> candidates;
+        final long startUptime;
+
+        Launch(String processName, long versionCode, String backend,
+                ArrayList<String> candidates, long startUptime) {
+            this.processName = processName;
+            this.versionCode = versionCode;
+            this.backend = backend;
+            this.candidates = new ArrayList<>(candidates);
+            this.startUptime = startUptime;
+        }
+    }
+
+    private static final class PolicyRule {
+        final boolean automatic;
+        final ArrayList<String> candidates;
+
+        PolicyRule(boolean automatic, ArrayList<String> candidates) {
+            this.automatic = automatic;
+            this.candidates = candidates;
+        }
+
+        static PolicyRule automaticDefaults() {
+            final ArrayList<String> candidates = new ArrayList<>();
+            candidates.add(BACKEND_NDK);
+            candidates.add(BACKEND_HOUDINI);
+            return new PolicyRule(true, candidates);
+        }
+
+        static PolicyRule preferred(String backend) {
+            final PolicyRule rule = automaticDefaults();
+            if (BACKEND_HOUDINI.equals(backend)) {
+                rule.candidates.clear();
+                rule.candidates.add(BACKEND_HOUDINI);
+                rule.candidates.add(BACKEND_NDK);
+            }
+            return rule;
+        }
+
+        static PolicyRule parse(Object value) {
+            if (value instanceof String) {
+                final String backend = (String) value;
+                return BACKEND_AUTO.equals(backend) ? automaticDefaults()
+                        : explicit(backend);
+            }
+            if (!(value instanceof JSONObject)) {
+                return automaticDefaults();
+            }
+
+            final JSONObject object = (JSONObject) value;
+            String backend = object.optString("selected_backend", "");
+            if (backend.isEmpty()) {
+                backend = object.optString("backend", "");
+            }
+            if (backend.isEmpty()) {
+                backend = object.optString("mode", BACKEND_AUTO);
+            }
+            if (!BACKEND_AUTO.equals(backend)) {
+                return explicit(backend);
+            }
+
+            final ArrayList<String> candidates = new ArrayList<>();
+            final JSONArray array = object.optJSONArray("candidates");
+            if (array != null) {
+                for (int i = 0; i < array.length(); i++) {
+                    final String candidate = array.optString(i);
+                    if (isBackend(candidate) && !candidates.contains(candidate)) {
+                        candidates.add(candidate);
+                    }
+                }
+            }
+            return candidates.isEmpty() ? automaticDefaults()
+                    : new PolicyRule(true, candidates);
+        }
+
+        private static PolicyRule explicit(String backend) {
+            final ArrayList<String> candidates = new ArrayList<>();
+            if (isBackend(backend)) {
+                candidates.add(backend);
+                return new PolicyRule(false, candidates);
+            }
+            return automaticDefaults();
+        }
+    }
+}
