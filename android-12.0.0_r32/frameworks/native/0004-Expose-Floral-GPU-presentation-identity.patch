+void GetPhysicalDeviceProperties(VkPhysicalDevice physicalDevice,
+                                 VkPhysicalDeviceProperties* pProperties) {
+    GetData(physicalDevice).dispatch.GetPhysicalDeviceProperties(physicalDevice, pProperties);
+    if (const char* model = android::floral::GetGpuModelOverride()) {
+        strlcpy(pProperties->deviceName, model, sizeof(pProperties->deviceName));
+    }
+}
+
+void GetPhysicalDeviceProperties2(VkPhysicalDevice physicalDevice,
+                                  VkPhysicalDeviceProperties2* pProperties) {
+    GetData(physicalDevice).dispatch.GetPhysicalDeviceProperties2(physicalDevice, pProperties);
+    if (const char* model = android::floral::GetGpuModelOverride()) {
+        strlcpy(pProperties->properties.deviceName, model,
+                sizeof(pProperties->properties.deviceName));
+    }
+}
