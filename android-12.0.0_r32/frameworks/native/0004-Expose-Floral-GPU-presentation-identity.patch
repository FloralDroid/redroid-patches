+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "FloralGpuIdentity.h"
+
+#include <pthread.h>
+
+#include <cutils/properties.h>
+
+namespace android {
+namespace floral {
+namespace {
+
+struct GpuIdentity {
+    char vendor[PROP_VALUE_MAX] = {};
+    char model[PROP_VALUE_MAX] = {};
+};
+
+GpuIdentity identity;
+pthread_once_t identity_once = PTHREAD_ONCE_INIT;
+
+void ReadIdentity() {
+    property_get("ro.boot.floral_gpu_vendor", identity.vendor, "");
+    property_get("ro.boot.floral_gpu_model", identity.model, "");
+}
+
+const GpuIdentity& GetIdentity() {
+    pthread_once(&identity_once, ReadIdentity);
+    return identity;
+}
+
+} // namespace
+
+const char* GetGpuVendorOverride() {
+    const char* value = GetIdentity().vendor;
+    return value[0] == '\0' ? nullptr : value;
+}
+
+const char* GetGpuModelOverride() {
+    const char* value = GetIdentity().model;
+    return value[0] == '\0' ? nullptr : value;
+}
+
+} // namespace floral
+} // namespace android
