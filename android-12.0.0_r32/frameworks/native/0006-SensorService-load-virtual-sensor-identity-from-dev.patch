+#include "FloralSensorIdentity.h"
+
+#include <floral/device/profile/DeviceProfile.h>
+#include <log/log.h>
+
+namespace android {
+namespace {
+
+struct CachedProfile {
+    CachedProfile() {
+        std::string error;
+        valid = floral::device::profile::ReadDeviceProfile(floral::device::profile::kDefaultPath,
+                                                           &profile, &error);
+        if (!valid) {
+            ALOGW("device profile unavailable; using virtual sensor identities: %s", error.c_str());
+        }
+    }
+
+    floral::device::profile::DeviceProfile profile;
+    bool valid = false;
+};
+
+}  // namespace
+
+FloralSensorIdentity GetFloralSensorIdentity(std::string_view key, const char* default_name,
+                                             const char* default_vendor) {
+    static const CachedProfile cached;
+    FloralSensorIdentity identity{default_name, default_vendor};
+    if (!cached.valid) {
+        return identity;
+    }
+
+    const std::string prefix = "sensor_virtual_" + std::string(key);
+    const std::string* name = cached.profile.Find(prefix + "_name");
+    const std::string* vendor = cached.profile.Find(prefix + "_vendor");
+    if (name != nullptr && vendor != nullptr) {
+        identity.name = *name;
+        identity.vendor = *vendor;
+    }
+    return identity;
+}
+
+}  // namespace android
