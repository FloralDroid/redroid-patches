 // ---------------------------------------------------------------------------
 
+namespace {
+
+const char* IdentityKeyForMode(int mode) {
+    switch (mode) {
+        case FUSION_9AXIS:
+            return "rotation_vector";
+        case FUSION_NOMAG:
+            return "game_rotation_vector";
+        case FUSION_NOGYRO:
+            return "geomagnetic_rotation_vector";
+        default:
+            return "rotation_vector";
+    }
+}
+
+}  // namespace
+
 RotationVectorSensor::RotationVectorSensor(int mode) :
       mMode(mode) {
+    const FloralSensorIdentity identity =
+            GetFloralSensorIdentity(IdentityKeyForMode(mode), getSensorName(), "AOSP");
     const sensor_t sensor = {
-        .name       = getSensorName(),
-        .vendor     = "AOSP",
+        .name       = identity.name.c_str(),
+        .vendor     = identity.vendor.c_str(),
         .version    = 3,
         .handle     = getSensorToken(),
         .type       = getSensorType(),
