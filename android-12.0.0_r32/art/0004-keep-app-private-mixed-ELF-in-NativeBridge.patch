From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FloralDroid <opensource@floraldroid.dev>
Date: Sat, 15 Aug 2026 11:20:00 +0800
Subject: [PATCH] art: keep app-private mixed ELF in NativeBridge

Let the selected translation backend own app-private x86/x86_64 libraries
before falling back to the host linker. This keeps JNI registration, symbol
lookup, and unloading in the same runtime for mixed app dependency graphs.

System-provided native libraries continue to load directly through the host
namespace. Non-bridged x86 processes retain the existing native-only path.
---
 libnativeloader/native_loader_namespace.cpp | 59 +++++++++++++++++++++++----
 1 file changed, 50 insertions(+), 9 deletions(-)

diff --git a/libnativeloader/native_loader_namespace.cpp b/libnativeloader/native_loader_namespace.cpp
index fd1138b..a591fe6 100644
--- a/libnativeloader/native_loader_namespace.cpp
+++ b/libnativeloader/native_loader_namespace.cpp
@@ -92,6 +92,27 @@ ElfTarget ReadElfTarget(const char* path) {
   return ElfTarget::kUnknown;
 }
 
+bool IsPlatformLibraryPath(const char* path) {
+  if (path == nullptr || path[0] != '/') {
+    return false;
+  }
+
+  // System-provided native libraries must stay in the host namespace. This
+  // keeps framework and provider code independent from the selected app
+  // translation backend.
+  constexpr const char* kPlatformRoots[] = {
+      "/apex", "/odm", "/product", "/system", "/system_ext", "/vendor",
+  };
+  for (const char* root : kPlatformRoots) {
+    const size_t root_length = strlen(root);
+    if (strncmp(path, root, root_length) == 0 &&
+        (path[root_length] == '\0' || path[root_length] == '/')) {
+      return true;
+    }
+  }
+  return false;
+}
+
 std::string GetLinkerError(bool is_bridged) {
   const char* msg = is_bridged ? NativeBridgeGetError() : dlerror();
   if (msg == nullptr) {
@@ -244,27 +265,47 @@ Result<void> NativeLoaderNamespace::Link(const NativeLoaderNamespace* target,
 }
 
 Result<NativeLoaderNamespace::LoadResult> NativeLoaderNamespace::Load(const char* lib_name) const {
-  if (!IsBridged()) {
+  auto load_native = [&]() -> void* {
     android_dlextinfo extinfo;
     extinfo.flags = ANDROID_DLEXT_USE_NAMESPACE;
     extinfo.library_namespace = this->ToRawAndroidNamespace();
-    void* handle = android_dlopen_ext(lib_name, RTLD_NOW, &extinfo);
+    return android_dlopen_ext(lib_name, RTLD_NOW, &extinfo);
+  };
+  auto load_bridged = [&]() -> void* {
+    return NativeBridgeLoadLibraryExt(lib_name, RTLD_NOW, this->ToRawNativeBridgeNamespace());
+  };
+
+  if (!IsBridged()) {
+    void* handle = load_native();
     if (handle != nullptr) {
       return LoadResult{handle, false};
     }
   } else {
     if (IsHybrid() && ReadElfTarget(lib_name) == ElfTarget::kNative) {
-      android_dlextinfo extinfo;
-      extinfo.flags = ANDROID_DLEXT_USE_NAMESPACE;
-      extinfo.library_namespace = this->ToRawAndroidNamespace();
-      void* handle = android_dlopen_ext(lib_name, RTLD_NOW, &extinfo);
+      if (IsPlatformLibraryPath(lib_name)) {
+        void* handle = load_native();
+        if (handle != nullptr) {
+          return LoadResult{handle, false};
+        }
+        return Error() << GetLinkerError(false);
+      }
+
+      // App-private native ELF files may be part of a mixed dependency graph.
+      // Let the selected backend claim the graph first, then fall back to the
+      // host linker if it does not support this particular library.
+      void* handle = load_bridged();
+      if (handle != nullptr) {
+        return LoadResult{handle, true};
+      }
+      const std::string bridged_error = GetLinkerError(true);
+      handle = load_native();
       if (handle != nullptr) {
         return LoadResult{handle, false};
       }
-      return Error() << GetLinkerError(false);
+      return Error() << "NativeBridge load failed: " << bridged_error
+                     << "; native load failed: " << GetLinkerError(false);
     }
-    void* handle =
-        NativeBridgeLoadLibraryExt(lib_name, RTLD_NOW, this->ToRawNativeBridgeNamespace());
+    void* handle = load_bridged();
     if (handle != nullptr) {
       return LoadResult{handle, true};
     }
-- 
