diff --git a/libnativeloader/native_loader_namespace.cpp b/libnativeloader/native_loader_namespace.cpp
index fd1138b..f81dd9a 100644
--- a/libnativeloader/native_loader_namespace.cpp
+++ b/libnativeloader/native_loader_namespace.cpp
@@ -34,6 +34,7 @@
 #include <android-base/strings.h>
 #include <log/log.h>
 #include <nativebridge/native_bridge.h>
+#include <nativebridge/native_bridge_private.h>
 
 #include "nativeloader/dlext_namespaces.h"
 
@@ -112,7 +113,7 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::GetExportedNamespace(const
   } else {
     auto bridged_raw = NativeBridgeGetExportedNamespace(name.c_str());
     if (bridged_raw != nullptr) {
-      if (HybridElfRoutingEnabled()) {
+      if (HybridElfRoutingEnabled() && !NativeBridgeUseDirectLoader()) {
         auto native_raw = android_get_exported_namespace(name.c_str());
         return NativeLoaderNamespace(name, native_raw, bridged_raw);
       }
@@ -136,7 +137,7 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::GetSystemNamespace(bool is_
   if (!is_bridged) {
     return NativeLoaderNamespace(kDefaultNamespaceName, static_cast<android_namespace_t*>(nullptr));
   } else {
-    if (HybridElfRoutingEnabled()) {
+    if (HybridElfRoutingEnabled() && !NativeBridgeUseDirectLoader()) {
       return NativeLoaderNamespace(kDefaultNamespaceName,
                                    static_cast<android_namespace_t*>(nullptr),
                                    static_cast<native_bridge_namespace_t*>(nullptr));
@@ -150,11 +151,16 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::Create(
     const std::string& name, const std::string& search_paths, const std::string& permitted_paths,
     const NativeLoaderNamespace* parent, bool is_shared, bool is_exempt_list_enabled,
     bool also_used_as_anonymous) {
-  bool is_bridged = false;
-  if (parent != nullptr) {
-    is_bridged = parent->IsBridged();
-  } else if (!search_paths.empty()) {
-    is_bridged = NativeBridgeIsPathSupported(search_paths.c_str());
+  // Direct is a process-level ownership decision. Do not let a native-looking
+  // search path turn the classloader back into a host namespace before direct
+  // routing gets a chance to handle the load.
+  bool is_bridged = NativeBridgeUseDirectLoader();
+  if (!is_bridged) {
+    if (parent != nullptr) {
+      is_bridged = parent->IsBridged();
+    } else if (!search_paths.empty()) {
+      is_bridged = NativeBridgeIsPathSupported(search_paths.c_str());
+    }
   }
 
   // Fall back to the system namespace if no parent is set.
@@ -191,7 +197,7 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::Create(
     }
   } else {
     android_namespace_t* native_raw = nullptr;
-    if (HybridElfRoutingEnabled()) {
+    if (HybridElfRoutingEnabled() && !NativeBridgeUseDirectLoader()) {
       const std::string native_name = name + "-native";
       native_raw = android_create_namespace(
           native_name.c_str(), nullptr, search_paths.c_str(), type, permitted_paths.c_str(),
@@ -253,7 +259,10 @@ Result<NativeLoaderNamespace::LoadResult> NativeLoaderNamespace::Load(const char
       return LoadResult{handle, false};
     }
   } else {
-    if (IsHybrid() && ReadElfTarget(lib_name) == ElfTarget::kNative) {
+    const bool native_elf = ReadElfTarget(lib_name) == ElfTarget::kNative;
+    // Hybrid keeps native ELF in the host namespace. Direct mode never has a
+    // host namespace, so every bridged load is owned by NativeBridge.
+    if (IsHybrid() && native_elf) {
       android_dlextinfo extinfo;
       extinfo.flags = ANDROID_DLEXT_USE_NAMESPACE;
       extinfo.library_namespace = this->ToRawAndroidNamespace();
@@ -263,8 +272,8 @@ Result<NativeLoaderNamespace::LoadResult> NativeLoaderNamespace::Load(const char
       }
       return Error() << GetLinkerError(false);
     }
-    void* handle =
-        NativeBridgeLoadLibraryExt(lib_name, RTLD_NOW, this->ToRawNativeBridgeNamespace());
+    void* handle = NativeBridgeLoadLibraryExt(
+        lib_name, RTLD_NOW, this->ToRawNativeBridgeNamespace());
     if (handle != nullptr) {
       return LoadResult{handle, true};
     }
