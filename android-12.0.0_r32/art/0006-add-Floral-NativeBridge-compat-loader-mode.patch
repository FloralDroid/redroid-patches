diff --git a/libnativebridge/include-private/nativebridge/native_bridge_private.h b/libnativebridge/include-private/nativebridge/native_bridge_private.h
new file mode 100644
index 0000000..6ffdbcf
--- /dev/null
+++ b/libnativebridge/include-private/nativebridge/native_bridge_private.h
@@ -0,0 +1,24 @@
+/*
+ * Copyright 2026 FloralDroid
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+#ifndef ART_LIBNATIVEBRIDGE_INCLUDE_PRIVATE_NATIVEBRIDGE_NATIVE_BRIDGE_PRIVATE_H_
+#define ART_LIBNATIVEBRIDGE_INCLUDE_PRIVATE_NATIVEBRIDGE_NATIVE_BRIDGE_PRIVATE_H_
+
+namespace android {
+extern "C" {
+
+// Returns true for the selected per-process bridged-only direct loader mode.
+// This extension is internal to ART and is not part of the stable VNDK header.
+bool NativeBridgeUseDirectLoader();
+
+// Legacy name retained for incremental images.
+bool NativeBridgeUseCompatibilityLoader();
+
+}  // extern "C"
+}  // namespace android
+
+#endif  // ART_LIBNATIVEBRIDGE_INCLUDE_PRIVATE_NATIVEBRIDGE_NATIVE_BRIDGE_PRIVATE_H_
diff --git a/libnativebridge/libnativebridge.map.txt b/libnativebridge/libnativebridge.map.txt
index 5ac4b3d..c541a8e 100644
--- a/libnativebridge/libnativebridge.map.txt
+++ b/libnativebridge/libnativebridge.map.txt
@@ -27,6 +27,8 @@ LIBNATIVEBRIDGE_1 {
     NativeBridgeAvailable;
     NeedsNativeBridge;
     SetFloralNativeBridgeProcessContext;
+    NativeBridgeUseDirectLoader;
+    NativeBridgeUseCompatibilityLoader;
   local:
     *;
 };
diff --git a/libnativebridge/native_bridge.cc b/libnativebridge/native_bridge.cc
index 0d99711..42df9fa 100644
--- a/libnativebridge/native_bridge.cc
+++ b/libnativebridge/native_bridge.cc
@@ -17,6 +17,7 @@
 #define LOG_TAG "nativebridge"
 
 #include "nativebridge/native_bridge.h"
+#include "nativebridge/native_bridge_private.h"
 
 #include <dlfcn.h>
 #include <errno.h>
@@ -396,6 +397,29 @@ void SetFloralNativeBridgeProcessContext(const char* process_name, const char* a
   }
 }
 
+bool NativeBridgeUseDirectLoader() {
+  if ((state != NativeBridgeState::kOpened &&
+       state != NativeBridgeState::kPreInitialized &&
+       state != NativeBridgeState::kInitialized) ||
+      native_bridge_handle == nullptr) {
+    return false;
+  }
+
+  using DirectLoaderFn = bool (*)();
+  auto use_direct_loader = reinterpret_cast<DirectLoaderFn>(
+      dlsym(native_bridge_handle, "FloralNativeBridgeUseDirectLoader"));
+  if (use_direct_loader != nullptr) {
+    return use_direct_loader();
+  }
+  auto use_legacy_loader = reinterpret_cast<DirectLoaderFn>(
+      dlsym(native_bridge_handle, "FloralNativeBridgeUseCompatibilityLoader"));
+  return use_legacy_loader != nullptr && use_legacy_loader();
+}
+
+bool NativeBridgeUseCompatibilityLoader() {
+  return NativeBridgeUseDirectLoader();
+}
+
 void PreZygoteForkNativeBridge() {
   if (NativeBridgeInitialized()) {
     if (isCompatibleWith(PRE_ZYGOTE_FORK_VERSION)) {
diff --git a/libnativebridge/native_bridge_lazy.cc b/libnativebridge/native_bridge_lazy.cc
index 2927623..3727d0a 100644
--- a/libnativebridge/native_bridge_lazy.cc
+++ b/libnativebridge/native_bridge_lazy.cc
@@ -15,6 +15,7 @@
  */
 
 #include "nativebridge/native_bridge.h"
+#include "nativebridge/native_bridge_private.h"
 #define LOG_TAG "nativebridge"
 
 #include <dlfcn.h>
@@ -59,6 +60,15 @@ void SetFloralNativeBridgeProcessContext(const char* process_name, const char* a
   f(process_name, app_data_dir);
 }
 
+bool NativeBridgeUseDirectLoader() {
+  static auto f = GET_FUNC_PTR(NativeBridgeUseDirectLoader);
+  return f();
+}
+
+bool NativeBridgeUseCompatibilityLoader() {
+  return NativeBridgeUseDirectLoader();
+}
+
 bool NativeBridgeAvailable() {
   static auto f = GET_FUNC_PTR(NativeBridgeAvailable);
   return f();
