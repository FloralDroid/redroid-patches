 .../nativebridge/native_bridge_private.h      | 21 ++++++++++
 libnativebridge/libnativebridge.map.txt       |  1 +
 libnativebridge/native_bridge.cc              | 15 +++++++
 libnativebridge/native_bridge_lazy.cc         |  6 +++
 libnativeloader/Android.bp                    |  1 +
 libnativeloader/native_loader_namespace.cpp   | 39 +++++++++++++++++--
 libnativeloader/native_loader_test.h          |  6 +++
 8 files changed, 108 insertions(+), 3 deletions(-)
 create mode 100644 libnativebridge/include-private/nativebridge/native_bridge_private.h

