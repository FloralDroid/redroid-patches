+    ],
+    min_sdk_version: "S",
+}
+
 art_cc_library {
     name: "libnativebridge",
     defaults: ["libnativebridge-defaults"],
@@ -57,6 +77,7 @@ art_cc_library {
     srcs: ["native_bridge.cc"],
     header_libs: [
         "libbase_headers",
+        "libnativebridge-private-headers",
     ],
     shared_libs: [
         "liblog",
@@ -97,6 +118,7 @@ cc_library {
 
     host_supported: false,
     srcs: ["native_bridge_lazy.cc"],
+    header_libs: ["libnativebridge-private-headers"],
     runtime_libs: ["libnativebridge"],
     shared_libs: ["liblog"],
