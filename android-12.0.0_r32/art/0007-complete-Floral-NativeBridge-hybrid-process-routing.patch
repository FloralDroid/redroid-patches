+#include "floral_nativebridge_diagnostics.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <utility>
+
+namespace art {
+namespace {
+
+std::string ReadProcessName() {
+  char buffer[512] = {};
+  const int fd = TEMP_FAILURE_RETRY(open("/proc/self/cmdline", O_RDONLY | O_CLOEXEC));
+  if (fd < 0) {
+    return {};
+  }
+  const ssize_t size = TEMP_FAILURE_RETRY(read(fd, buffer, sizeof(buffer) - 1));
+  close(fd);
+  if (size <= 0) {
+    return {};
+  }
+  buffer[size] = '\0';
+  return buffer;
+}
+
+thread_local std::string g_current_library;
+
+}  // namespace
+
+bool ShouldTraceFloralNativeBridgeProcess() {
+  if (!android::native_bridge_diagnostics::IsEnabled()) {
+    return false;
+  }
+  const std::string process_name = ReadProcessName();
+  return android::native_bridge_diagnostics::ShouldTraceProcess(process_name.c_str());
+}
+
+bool ShouldTraceFloralNativeBridgeLibrary(const char* library_path) {
+  if (!android::native_bridge_diagnostics::IsEnabled()) {
+    return false;
+  }
+  const std::string process_name = ReadProcessName();
+  return android::native_bridge_diagnostics::ShouldTraceLibrary(process_name.c_str(), library_path);
+}
+
+const char* CurrentFloralNativeBridgeLibrary() {
+  return g_current_library.empty() ? nullptr : g_current_library.c_str();
+}
+
+ScopedFloralNativeBridgeLibrary::ScopedFloralNativeBridgeLibrary(
+    const std::string& library_path)
+    : previous_library_(std::move(g_current_library)) {
+  g_current_library = library_path;
+}
+
+ScopedFloralNativeBridgeLibrary::~ScopedFloralNativeBridgeLibrary() {
+  g_current_library = std::move(previous_library_);
+}
+
+}  // namespace art
