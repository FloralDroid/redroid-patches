+#ifndef ART_LIBNATIVEBRIDGE_INCLUDE_NATIVEBRIDGE_NATIVE_BRIDGE_DIAGNOSTICS_H_
+#define ART_LIBNATIVEBRIDGE_INCLUDE_NATIVEBRIDGE_NATIVE_BRIDGE_DIAGNOSTICS_H_
+
+#include <cstdarg>
+#include <cstring>
+
+#if defined(__ANDROID__)
+#include <android/log.h>
+#include <sys/system_properties.h>
+#endif
+
+namespace android::native_bridge_diagnostics {
+
+inline constexpr char kPackageProperty[] = "debug.floral.nbdiag.package";
+inline constexpr char kLibraryProperty[] = "debug.floral.nbdiag.library";
+inline constexpr char kLogTag[] = "FloralNBDiag";
+
+inline bool ProcessMatches(const char* configured_package, const char* process_name) {
+  if (configured_package == nullptr || configured_package[0] == '\0' ||
+      process_name == nullptr || process_name[0] == '\0') {
+    return false;
+  }
+  if (strcmp(configured_package, "*") == 0) {
+    return true;
+  }
+
+  const size_t package_length = strlen(configured_package);
+  return strncmp(configured_package, process_name, package_length) == 0 &&
+         (process_name[package_length] == '\0' || process_name[package_length] == ':');
+}
+
+inline const char* Basename(const char* path) {
+  if (path == nullptr) {
+    return nullptr;
+  }
+  const char* separator = strrchr(path, '/');
+  return separator == nullptr ? path : separator + 1;
+}
+
+inline bool LibraryMatches(const char* configured_library, const char* library_path) {
+  if (configured_library == nullptr || configured_library[0] == '\0' ||
+      strcmp(configured_library, "*") == 0) {
+    return true;
+  }
+  if (library_path == nullptr || library_path[0] == '\0') {
+    return false;
+  }
+  return strcmp(configured_library, library_path) == 0 ||
+         strcmp(configured_library, Basename(library_path)) == 0;
+}
+
+inline bool IsEnabled() {
+#if defined(__ANDROID__)
+  char configured_package[PROP_VALUE_MAX] = {};
+  return __system_property_get(kPackageProperty, configured_package) > 0 &&
+         configured_package[0] != '\0';
+#else
+  return false;
+#endif
+}
+
+inline bool ShouldTraceProcess(const char* process_name) {
+#if defined(__ANDROID__)
+  char configured_package[PROP_VALUE_MAX] = {};
+  if (__system_property_get(kPackageProperty, configured_package) <= 0) {
+    return false;
+  }
+  return ProcessMatches(configured_package, process_name);
+#else
+  (void)process_name;
+  return false;
+#endif
+}
+
+inline bool ShouldTraceLibrary(const char* process_name, const char* library_path) {
+#if defined(__ANDROID__)
+  if (!ShouldTraceProcess(process_name)) {
+    return false;
+  }
+  char configured_library[PROP_VALUE_MAX] = {};
+  __system_property_get(kLibraryProperty, configured_library);
+  return LibraryMatches(configured_library, library_path);
+#else
+  (void)process_name;
+  (void)library_path;
+  return false;
+#endif
+}
+
+inline void Trace(const char* format, ...) __attribute__((format(printf, 1, 2)));
+
+inline void Trace(const char* format, ...) {
+#if defined(__ANDROID__)
+  va_list args;
+  va_start(args, format);
+  __android_log_vprint(ANDROID_LOG_INFO, kLogTag, format, args);
+  va_end(args);
+#else
+  (void)format;
+#endif
+}
+
+}  // namespace android::native_bridge_diagnostics
+
+#endif  // ART_LIBNATIVEBRIDGE_INCLUDE_NATIVEBRIDGE_NATIVE_BRIDGE_DIAGNOSTICS_H_
