+bool ShouldTraceFloralNativeBridgeProcess();
+bool ShouldTraceFloralNativeBridgeLibrary(const char* library_path);
+const char* CurrentFloralNativeBridgeLibrary();
+
+// RegisterNatives normally runs synchronously inside JNI_OnLoad. Preserve the
+// active library across nested loads so registration logs retain attribution.
+class ScopedFloralNativeBridgeLibrary final {
+ public:
+  explicit ScopedFloralNativeBridgeLibrary(const std::string& library_path);
+  ~ScopedFloralNativeBridgeLibrary();
+
+  ScopedFloralNativeBridgeLibrary(const ScopedFloralNativeBridgeLibrary&) = delete;
+  ScopedFloralNativeBridgeLibrary& operator=(const ScopedFloralNativeBridgeLibrary&) = delete;
+
+ private:
+  std::string previous_library_;
+};
+
+}  // namespace art
