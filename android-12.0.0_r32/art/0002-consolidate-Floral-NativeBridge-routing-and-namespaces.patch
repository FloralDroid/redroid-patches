+constexpr const char* kHybridElfProperty = "ro.floral.bridge.hybrid_elf";
+constexpr const char* kNamespaceAuditProperty = "persist.floral.nb.audit";
+
+enum class ElfTarget {
+  kUnknown,
+  kNative,
+  kGuest,
+};
+
+bool HybridElfRoutingEnabled() {
+  return android::base::GetBoolProperty(kHybridElfProperty, false);
+}
+
+bool NamespaceAuditEnabled() {
+  return android::base::GetBoolProperty(kNamespaceAuditProperty, false);
+}
+
+size_t CountListEntries(const std::string& value) {
+  return value.empty() ? 0 : 1 + std::count(value.begin(), value.end(), ':');
+}
+
+ElfTarget ReadElfTarget(const char* path) {
+  if (path == nullptr || path[0] != '/') {
+    return ElfTarget::kUnknown;
+  }
+
+  constexpr size_t kMachineOffset = offsetof(Elf64_Ehdr, e_machine);
+  unsigned char header[kMachineOffset + sizeof(uint16_t)] = {};
+  const int fd = TEMP_FAILURE_RETRY(open(path, O_RDONLY | O_CLOEXEC));
+  if (fd < 0) {
+    return ElfTarget::kUnknown;
+  }
+  const ssize_t size = TEMP_FAILURE_RETRY(read(fd, header, sizeof(header)));
+  close(fd);
+  if (size != static_cast<ssize_t>(sizeof(header)) ||
+      memcmp(header, ELFMAG, SELFMAG) != 0) {
+    return ElfTarget::kUnknown;
+  }
+
+  uint16_t machine;
+  memcpy(&machine, header + kMachineOffset, sizeof(machine));
+  if (header[EI_DATA] == ELFDATA2MSB) {
+    machine = __builtin_bswap16(machine);
+  } else if (header[EI_DATA] != ELFDATA2LSB) {
+    return ElfTarget::kUnknown;
+  }
+
+  if (machine == EM_386 || machine == EM_X86_64) {
+    return ElfTarget::kNative;
+  }
+  if (machine == EM_ARM || machine == EM_AARCH64) {
+    return ElfTarget::kGuest;
+  }
+  return ElfTarget::kUnknown;
+}
+
+bool IsPlatformLibraryPath(const char* path) {
+  if (path == nullptr || path[0] != '/') {
+    return false;
+  }
+  static constexpr const char* kPlatformPrefixes[] = {
+      "/apex/", "/odm/", "/product/", "/system/", "/system_ext/", "/vendor/"};
+  for (const char* prefix : kPlatformPrefixes) {
+    if (android::base::StartsWith(path, prefix)) {
+      return true;
+    }
+  }
+  return false;
+}
 
