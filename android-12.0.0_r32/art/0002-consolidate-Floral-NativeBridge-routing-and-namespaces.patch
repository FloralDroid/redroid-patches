-Result<void*> NativeLoaderNamespace::Load(const char* lib_name) const {
+Result<void> NativeLoaderNamespace::LinkNativeBridge(const NativeLoaderNamespace* target,
+                                                     const std::string& shared_libs) const {
+  LOG_ALWAYS_FATAL_IF(!IsBridged(), "NativeBridge-only link requested from native namespace %s",
+                      name_.c_str());
+  LOG_ALWAYS_FATAL_IF(shared_libs.empty(), "empty NativeBridge share lib when linking %s to %s",
+                      name_.c_str(), target == nullptr ? "default" : target->name().c_str());
+
+  if (NativeBridgeLinkNamespaces(this->ToRawNativeBridgeNamespace(),
+                                 target == nullptr ? nullptr : target->ToRawNativeBridgeNamespace(),
+                                 shared_libs.c_str())) {
+    return {};
+  }
+  return Error() << GetLinkerError(true);
+}
+
+Result<NativeLoaderNamespace::LoadResult> NativeLoaderNamespace::Load(const char* lib_name) const {
   if (!IsBridged()) {
     android_dlextinfo extinfo;
     extinfo.flags = ANDROID_DLEXT_USE_NAMESPACE;
     extinfo.library_namespace = this->ToRawAndroidNamespace();
     void* handle = android_dlopen_ext(lib_name, RTLD_NOW, &extinfo);
     if (handle != nullptr) {
-      return handle;
+      return LoadResult{handle, false};
     }
   } else {
-    void* handle =
-        NativeBridgeLoadLibraryExt(lib_name, RTLD_NOW, this->ToRawNativeBridgeNamespace());
+    const bool native_elf = ReadElfTarget(lib_name) == ElfTarget::kNative;
+    // Give the selected NativeBridge backend first ownership of every library
+    // in a bridged classloader. A package can contain an ELF that advertises
+    // the host machine while its JNI state belongs to the translated guest
+    // chain; routing that file to the host first splits JNI_OnLoad and
+    // RegisterNatives across incompatible loader contexts. Keep the native
+    // namespace as a compatibility fallback for libraries the backend rejects.
+    void* handle = NativeBridgeLoadLibraryExt(
+        lib_name, RTLD_NOW, this->ToRawNativeBridgeNamespace());
     if (handle != nullptr) {
-      return handle;
+      return LoadResult{handle, true};
+    }
+
+    if (IsHybrid() && native_elf) {
+      android_dlextinfo extinfo;
+      extinfo.flags = ANDROID_DLEXT_USE_NAMESPACE;
+      extinfo.library_namespace = this->ToRawAndroidNamespace();
+      handle = android_dlopen_ext(lib_name, RTLD_NOW, &extinfo);
+      if (handle != nullptr) {
+        return LoadResult{handle, false};
+      }
+      return Error() << GetLinkerError(false);
