+void PreloadBridgedNativeLoader() {
+  if (!NativeBridgeInitialized()) {
+    return;
+  }
+
+  native_bridge_namespace_t* system_ns = NativeBridgeGetExportedNamespace("system");
+  if (system_ns == nullptr) {
+    system_ns = NativeBridgeGetExportedNamespace("default");
+  }
+  if (system_ns == nullptr) {
+    ALOGW("Cannot preload guest %s: system NativeBridge namespace is unavailable",
+          kBridgedNativeLoaderLibrary);
+    return;
+  }
+
+  // SoLoader resolves NativeLoader entry points with dlopen/dlsym. The
+  // classloader link alone is insufficient until the guest library has been
+  // materialized in the NativeBridge system namespace.
+  void* handle = NativeBridgeLoadLibraryExt(
+      kBridgedNativeLoaderLibrary, RTLD_NOW | RTLD_NODELETE, system_ns);
+  if (handle == nullptr) {
+    const char* error = NativeBridgeGetError();
+    ALOGW("Failed to preload guest %s: %s", kBridgedNativeLoaderLibrary,
+          error == nullptr ? "unknown error" : error);
+  }
+}
+
 }  // namespace
 
