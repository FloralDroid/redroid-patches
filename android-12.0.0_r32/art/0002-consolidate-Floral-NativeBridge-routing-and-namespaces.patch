+bool NativeBridgeUseHybridLoader() {
+  if ((state != NativeBridgeState::kOpened &&
+       state != NativeBridgeState::kPreInitialized &&
+       state != NativeBridgeState::kInitialized) ||
+      native_bridge_handle == nullptr) {
