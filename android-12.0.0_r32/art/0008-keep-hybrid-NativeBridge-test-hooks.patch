From f973a5bc92bcf1b29ee1e2544567df97255a72f8 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Fri, 28 Aug 2026 01:08:07 +0800
Subject: [PATCH] art: keep hybrid NativeBridge test hooks

Change-Id: I80ec348b51455631e2e53db31167187619562973
---
 libnativeloader/native_loader_test.h | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/libnativeloader/native_loader_test.h b/libnativeloader/native_loader_test.h
index 0f623c3..6abffd6 100644
--- a/libnativeloader/native_loader_test.h
+++ b/libnativeloader/native_loader_test.h
@@ -57,6 +57,7 @@ class Platform {
   // libnativebridge APIs for which libdl_android has no corresponding APIs
   virtual bool NativeBridgeInitialized() = 0;
   virtual bool NativeBridgeUseDirectLoader() = 0;
+  virtual bool NativeBridgeUseHybridLoader() = 0;
   virtual const char* NativeBridgeGetError() = 0;
   virtual bool NativeBridgeIsPathSupported(const char*) = 0;
   virtual bool NativeBridgeIsSupported(const char*) = 0;
@@ -124,6 +125,7 @@ class MockPlatform : public Platform {
   // Mocking libnativebridge APIs
   MOCK_METHOD0(NativeBridgeInitialized, bool());
   MOCK_METHOD0(NativeBridgeUseDirectLoader, bool());
+  MOCK_METHOD0(NativeBridgeUseHybridLoader, bool());
   MOCK_METHOD0(NativeBridgeGetError, const char*());
   MOCK_METHOD1(NativeBridgeIsPathSupported, bool(const char*));
   MOCK_METHOD1(NativeBridgeIsSupported, bool(const char*));
@@ -206,6 +208,10 @@ bool NativeBridgeUseDirectLoader() {
   return mock->NativeBridgeUseDirectLoader();
 }
 
+bool NativeBridgeUseHybridLoader() {
+  return mock->NativeBridgeUseHybridLoader();
+}
+
 bool NativeBridgeInitAnonymousNamespace(const char* public_ns_sonames,
                                         const char* anon_ns_library_path) {
   return mock->mock_init_anonymous_namespace(true, public_ns_sonames, anon_ns_library_path);
-- 
