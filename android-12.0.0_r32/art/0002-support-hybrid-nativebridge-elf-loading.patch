From fb7dc6d25408e28add8d3fea79a3665e6a262ccd Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Wed, 12 Aug 2026 02:35:00 +0800
Subject: [PATCH] art: support hybrid NativeBridge ELF routing

Keep system-owned native ELF files on the host linker. For app-private native
files, let the selected bridge claim the path first and fall back to the host
linker only when the bridge rejects it.

Change-Id: I2b59ad7b250261de5681f7edd680a09a3989dbd5
---
 libnativeloader/native_loader.cpp           |  10 +-
 libnativeloader/native_loader_namespace.cpp | 145 ++++++++++++++++++--
 libnativeloader/native_loader_namespace.h   |  31 +++--
 3 files changed, 167 insertions(+), 19 deletions(-)

diff --git a/libnativeloader/native_loader.cpp b/libnativeloader/native_loader.cpp
index 2deb5ef..c53df8f 100644
--- a/libnativeloader/native_loader.cpp
+++ b/libnativeloader/native_loader.cpp
@@ -133,7 +133,11 @@ Result<void*> TryLoadNativeloaderExtraLib(const char* path) {
   if (!ns.ok()) {
     return ns.error();
   }
-  return ns.value()->Load(path);
+  auto result = ns.value()->Load(path);
+  if (!result.ok()) {
+    return result.error();
+  }
+  return result->handle;
 }
 
 Result<NativeLoaderNamespace*> CreateClassLoaderNamespaceLocked(JNIEnv* env,
@@ -356,9 +360,9 @@ void* OpenNativeLibraryInNamespace(NativeLoaderNamespace* ns, const char* path,
     *error_msg = strdup(handle.error().message().c_str());
   }
   if (needs_native_bridge != nullptr) {
-    *needs_native_bridge = ns->IsBridged();
+    *needs_native_bridge = handle.ok() ? handle->needs_native_bridge : ns->IsBridged();
   }
-  return handle.ok() ? *handle : nullptr;
+  return handle.ok() ? handle->handle : nullptr;
 }
 
 // native_bridge_namespaces are not supported for callers of this function.
diff --git a/libnativeloader/native_loader_namespace.cpp b/libnativeloader/native_loader_namespace.cpp
index 669fa74..a295929 100644
--- a/libnativeloader/native_loader_namespace.cpp
+++ b/libnativeloader/native_loader_namespace.cpp
@@ -21,9 +21,16 @@
 #include "native_loader_namespace.h"
 
 #include <dlfcn.h>
+#include <elf.h>
+#include <fcntl.h>
+#include <unistd.h>
 
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
 #include <functional>
 
+#include <android-base/properties.h>
 #include <android-base/strings.h>
 #include <log/log.h>
 #include <nativebridge/native_bridge.h>
@@ -38,6 +45,68 @@ namespace {
 
 constexpr const char* kDefaultNamespaceName = "default";
 constexpr const char* kSystemNamespaceName = "system";
+constexpr const char* kHybridElfProperty = "ro.floral.nativebridge.hybrid_elf";
+
+enum class ElfTarget {
+  kUnknown,
+  kNative,
+  kGuest,
+};
+
+bool HybridElfRoutingEnabled() {
+  return android::base::GetBoolProperty(kHybridElfProperty, false);
+}
+
+ElfTarget ReadElfTarget(const char* path) {
+  if (path == nullptr || path[0] != '/') {
+    return ElfTarget::kUnknown;
+  }
+
+  constexpr size_t kMachineOffset = offsetof(Elf64_Ehdr, e_machine);
+  unsigned char header[kMachineOffset + sizeof(uint16_t)] = {};
+  const int fd = TEMP_FAILURE_RETRY(open(path, O_RDONLY | O_CLOEXEC));
+  if (fd < 0) {
+    return ElfTarget::kUnknown;
+  }
+  const ssize_t size = TEMP_FAILURE_RETRY(read(fd, header, sizeof(header)));
+  close(fd);
+  if (size != static_cast<ssize_t>(sizeof(header)) ||
+      memcmp(header, ELFMAG, SELFMAG) != 0) {
+    return ElfTarget::kUnknown;
+  }
+
+  uint16_t machine;
+  memcpy(&machine, header + kMachineOffset, sizeof(machine));
+  if (header[EI_DATA] == ELFDATA2MSB) {
+    machine = __builtin_bswap16(machine);
+  } else if (header[EI_DATA] != ELFDATA2LSB) {
+    return ElfTarget::kUnknown;
+  }
+
+  if (machine == EM_386 || machine == EM_X86_64) {
+    return ElfTarget::kNative;
+  }
+  if (machine == EM_ARM || machine == EM_AARCH64) {
+    return ElfTarget::kGuest;
+  }
+  return ElfTarget::kUnknown;
+}
+
+bool IsSystemLibraryPath(const char* path) {
+  if (path == nullptr || path[0] != '/') {
+    return false;
+  }
+  constexpr const char* kSystemPrefixes[] = {
+      "/system/", "/system_ext/", "/product/", "/vendor/",
+      "/odm/",    "/apex/",
+  };
+  for (const char* prefix : kSystemPrefixes) {
+    if (strncmp(path, prefix, strlen(prefix)) == 0) {
+      return true;
+    }
+  }
+  return false;
+}
 
 std::string GetLinkerError(bool is_bridged) {
   const char* msg = is_bridged ? NativeBridgeGetError() : dlerror();
@@ -57,9 +126,13 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::GetExportedNamespace(const
       return NativeLoaderNamespace(name, raw);
     }
   } else {
-    auto raw = NativeBridgeGetExportedNamespace(name.c_str());
-    if (raw != nullptr) {
-      return NativeLoaderNamespace(name, raw);
+    auto bridged_raw = NativeBridgeGetExportedNamespace(name.c_str());
+    if (bridged_raw != nullptr) {
+      if (HybridElfRoutingEnabled()) {
+        auto native_raw = android_get_exported_namespace(name.c_str());
+        return NativeLoaderNamespace(name, native_raw, bridged_raw);
+      }
+      return NativeLoaderNamespace(name, bridged_raw);
     }
   }
   return Errorf("namespace {} does not exist or exported", name);
@@ -79,6 +152,11 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::GetSystemNamespace(bool is_
   if (!is_bridged) {
     return NativeLoaderNamespace(kDefaultNamespaceName, static_cast<android_namespace_t*>(nullptr));
   } else {
+    if (HybridElfRoutingEnabled()) {
+      return NativeLoaderNamespace(kDefaultNamespaceName,
+                                   static_cast<android_namespace_t*>(nullptr),
+                                   static_cast<native_bridge_namespace_t*>(nullptr));
+    }
     return NativeLoaderNamespace(kDefaultNamespaceName,
                                  static_cast<native_bridge_namespace_t*>(nullptr));
   }
@@ -128,10 +206,24 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::Create(
       return NativeLoaderNamespace(name, raw);
     }
   } else {
+    android_namespace_t* native_raw = nullptr;
+    if (HybridElfRoutingEnabled()) {
+      const std::string native_name = name + "-native";
+      native_raw = android_create_namespace(
+          native_name.c_str(), nullptr, search_paths.c_str(), type, permitted_paths.c_str(),
+          effective_parent.ToRawAndroidNamespace());
+      if (native_raw == nullptr) {
+        ALOGW("Failed to create hybrid native namespace %s; using bridged namespace only",
+              native_name.c_str());
+      }
+    }
     native_bridge_namespace_t* raw = NativeBridgeCreateNamespace(
         name.c_str(), nullptr, search_paths.c_str(), type, permitted_paths.c_str(),
         effective_parent.ToRawNativeBridgeNamespace());
     if (raw != nullptr) {
+      if (native_raw != nullptr) {
+        return NativeLoaderNamespace(name, native_raw, raw);
+      }
       return NativeLoaderNamespace(name, raw);
     }
   }
@@ -150,6 +242,14 @@ Result<void> NativeLoaderNamespace::Link(const NativeLoaderNamespace* target,
       return {};
     }
   } else {
+    if (IsHybrid() && (target == nullptr || target->HasNativeNamespace())) {
+      if (!android_link_namespaces(
+              this->ToRawAndroidNamespace(),
+              target == nullptr ? nullptr : target->ToRawAndroidNamespace(),
+              shared_libs.c_str())) {
+        ALOGW("Failed to link hybrid native namespace %s: %s", name_.c_str(), dlerror());
+      }
+    }
     if (NativeBridgeLinkNamespaces(this->ToRawNativeBridgeNamespace(),
                                    target == nullptr ? nullptr : target->ToRawNativeBridgeNamespace(),
                                    shared_libs.c_str())) {
@@ -159,20 +259,49 @@ Result<void> NativeLoaderNamespace::Link(const NativeLoaderNamespace* target,
   return Error() << GetLinkerError(IsBridged());
 }
 
-Result<void*> NativeLoaderNamespace::Load(const char* lib_name) const {
+Result<NativeLoaderNamespace::LoadResult> NativeLoaderNamespace::Load(const char* lib_name) const {
   if (!IsBridged()) {
     android_dlextinfo extinfo;
     extinfo.flags = ANDROID_DLEXT_USE_NAMESPACE;
     extinfo.library_namespace = this->ToRawAndroidNamespace();
     void* handle = android_dlopen_ext(lib_name, RTLD_NOW, &extinfo);
     if (handle != nullptr) {
-      return handle;
+      return LoadResult{handle, false};
     }
   } else {
-    void* handle =
-        NativeBridgeLoadLibraryExt(lib_name, RTLD_NOW, this->ToRawNativeBridgeNamespace());
+    const ElfTarget target = ReadElfTarget(lib_name);
+    const bool native_elf = target == ElfTarget::kNative;
+    const bool system_library = IsSystemLibraryPath(lib_name);
+
+    // System x86 libraries keep host ownership. App-private native ELFs try
+    // the selected bridge first so Houdini can handle protected x86 names.
+    if (IsHybrid() && native_elf && system_library) {
+      android_dlextinfo extinfo;
+      extinfo.flags = ANDROID_DLEXT_USE_NAMESPACE;
+      extinfo.library_namespace = this->ToRawAndroidNamespace();
+      void* handle = android_dlopen_ext(lib_name, RTLD_NOW, &extinfo);
+      if (handle != nullptr) {
+        return LoadResult{handle, false};
+      }
+      return Error() << GetLinkerError(false);
+    }
+    void* handle = NativeBridgeLoadLibraryExt(
+        lib_name, RTLD_NOW, this->ToRawNativeBridgeNamespace());
     if (handle != nullptr) {
-      return handle;
+      return LoadResult{handle, true};
+    }
+
+    // A real app-private x86 ELF can still be native. Only fall back to the
+    // host linker after the selected translation backend rejects it.
+    if (IsHybrid() && native_elf && !system_library) {
+      android_dlextinfo extinfo;
+      extinfo.flags = ANDROID_DLEXT_USE_NAMESPACE;
+      extinfo.library_namespace = this->ToRawAndroidNamespace();
+      handle = android_dlopen_ext(lib_name, RTLD_NOW, &extinfo);
+      if (handle != nullptr) {
+        return LoadResult{handle, false};
+      }
+      return Error() << GetLinkerError(false);
     }
   }
   return Error() << GetLinkerError(IsBridged());
diff --git a/libnativeloader/native_loader_namespace.h b/libnativeloader/native_loader_namespace.h
index 9a5aeac..4f6f2f6 100644
--- a/libnativeloader/native_loader_namespace.h
+++ b/libnativeloader/native_loader_namespace.h
@@ -20,7 +20,6 @@
 #if defined(ART_TARGET_ANDROID)
 
 #include <string>
-#include <variant>
 #include <vector>
 
 #include <android-base/logging.h>
@@ -38,6 +37,11 @@ using android::base::Result;
 // x86). Instances of this class are managed by LibraryNamespaces object.
 struct NativeLoaderNamespace {
  public:
+  struct LoadResult {
+    void* handle;
+    bool needs_native_bridge;
+  };
+
   static Result<NativeLoaderNamespace> Create(const std::string& name,
                                               const std::string& search_paths,
                                               const std::string& permitted_paths,
@@ -49,18 +53,22 @@ struct NativeLoaderNamespace {
   NativeLoaderNamespace(const NativeLoaderNamespace&) = default;
   NativeLoaderNamespace& operator=(const NativeLoaderNamespace&) = default;
 
-  android_namespace_t* ToRawAndroidNamespace() const { return std::get<0>(raw_); }
-  native_bridge_namespace_t* ToRawNativeBridgeNamespace() const { return std::get<1>(raw_); }
+  android_namespace_t* ToRawAndroidNamespace() const { return native_namespace_; }
+  native_bridge_namespace_t* ToRawNativeBridgeNamespace() const {
+    return bridged_namespace_;
+  }
 
   std::string name() const { return name_; }
-  bool IsBridged() const { return raw_.index() == 1; }
+  bool IsBridged() const { return is_bridged_; }
+  bool HasNativeNamespace() const { return has_native_namespace_; }
+  bool IsHybrid() const { return IsBridged() && HasNativeNamespace(); }
 
   // Creates a link from this namespace to target for the ":"-separated list of
   // libraries in shared_libs. If target is nullptr it creates a link to the
   // default namespace.
   Result<void> Link(const NativeLoaderNamespace* target, const std::string& shared_libs) const;
 
-  Result<void*> Load(const char* lib_name) const;
+  Result<LoadResult> Load(const char* lib_name) const;
 
   static Result<NativeLoaderNamespace> GetExportedNamespace(const std::string& name,
                                                             bool is_bridged);
@@ -68,12 +76,19 @@ struct NativeLoaderNamespace {
 
  private:
   explicit NativeLoaderNamespace(const std::string& name, android_namespace_t* ns)
-      : name_(name), raw_(ns) {}
+      : name_(name), has_native_namespace_(true), native_namespace_(ns) {}
   explicit NativeLoaderNamespace(const std::string& name, native_bridge_namespace_t* ns)
-      : name_(name), raw_(ns) {}
+      : name_(name), is_bridged_(true), bridged_namespace_(ns) {}
+  NativeLoaderNamespace(const std::string& name, android_namespace_t* native_ns,
+                        native_bridge_namespace_t* bridged_ns)
+      : name_(name), is_bridged_(true), has_native_namespace_(true),
+        native_namespace_(native_ns), bridged_namespace_(bridged_ns) {}
 
   std::string name_;
-  std::variant<android_namespace_t*, native_bridge_namespace_t*> raw_;
+  bool is_bridged_ = false;
+  bool has_native_namespace_ = false;
+  android_namespace_t* native_namespace_ = nullptr;
+  native_bridge_namespace_t* bridged_namespace_ = nullptr;
 };
 
 }  // namespace android
