     CHECK(NeedsNativeBridge());
 
     uint32_t len = 0;
-    return android::NativeBridgeGetTrampoline(handle_, symbol_name.c_str(), shorty, len);
+    void* symbol = android::NativeBridgeGetTrampoline(handle_, symbol_name.c_str(), shorty, len);
+    if (ShouldTraceFloralNativeBridgeLibrary(path_.c_str())) {
+      Dl_info symbol_info = {};
+      const char* owner = symbol != nullptr && dladdr(symbol, &symbol_info) != 0
+                              ? symbol_info.dli_fname
+                              : nullptr;
+      android::native_bridge_diagnostics::Trace(
+          "stage=art_get_trampoline path=%s handle=%p symbol=%s shorty=%s result=%p owner=%s",
+          path_.c_str(),
+          handle_,
+          symbol_name.c_str(),
+          shorty == nullptr ? "<null>" : shorty,
+          symbol,
+          owner == nullptr ? "<unknown>" : owner);
+    }
+    return symbol;
   }
 
  private:
@@ -1020,6 +1036,15 @@ bool JavaVMExt::LoadNativeLibrary(JNIEnv* env,
       library_path.get(),
       &needs_native_bridge,
       &nativeloader_error_msg);
+  if (ShouldTraceFloralNativeBridgeLibrary(path_str)) {
+    android::native_bridge_diagnostics::Trace(
+        "stage=art_open_library path=%s class_loader=%p handle=%p native_bridge=%d error=%s",
+        path_str == nullptr ? "<null>" : path_str,
+        reinterpret_cast<void*>(class_loader),
+        handle,
+        needs_native_bridge,
+        nativeloader_error_msg == nullptr ? "<none>" : nativeloader_error_msg);
+  }
   VLOG(jni) << "[Call to dlopen(\"" << path << "\", RTLD_NOW) returned " << handle << "]";
 
   if (handle == nullptr) {
@@ -1079,7 +1104,17 @@ bool JavaVMExt::LoadNativeLibrary(JNIEnv* env,
     VLOG(jni) << "[Calling JNI_OnLoad in \"" << path << "\"]";
     using JNI_OnLoadFn = int(*)(JavaVM*, void*);
     JNI_OnLoadFn jni_on_load = reinterpret_cast<JNI_OnLoadFn>(sym);
+    ScopedFloralNativeBridgeLibrary diagnostic_library(path);
     int version = (*jni_on_load)(this, nullptr);
+    if (ShouldTraceFloralNativeBridgeLibrary(path.c_str())) {
+      android::native_bridge_diagnostics::Trace(
+          "stage=jni_onload_result path=%s symbol=%p version=%d exception=%d class_loader=%p",
+          path.c_str(),
+          sym,
+          version,
+          env->ExceptionCheck(),
+          reinterpret_cast<void*>(class_loader));
+    }
 
     if (IsSdkVersionSetAndAtMost(runtime_->GetTargetSdkVersion(), SdkVersion::kL)) {
       // Make sure that sigchain owns SIGSEGV.
