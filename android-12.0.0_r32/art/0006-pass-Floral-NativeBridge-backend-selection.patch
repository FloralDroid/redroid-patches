From 3ea14bb86a2b58e2372de678481a4f0d02f0dc7c Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Tue, 25 Aug 2026 23:55:54 +0800
Subject: [PATCH] art: pass Floral NativeBridge backend through process context

Change-Id: I976c4647d391ea714cc6a7a0daab07d34513c4b1
---
 libnativebridge/include/nativebridge/native_bridge.h | 5 +++++
 libnativebridge/native_bridge.cc                     | 8 +++++---
 libnativebridge/native_bridge_lazy.cc                | 6 ++++--
 3 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/libnativebridge/include/nativebridge/native_bridge.h b/libnativebridge/include/nativebridge/native_bridge.h
index 2199bab..02fd404 100644
--- a/libnativebridge/include/nativebridge/native_bridge.h
+++ b/libnativebridge/include/nativebridge/native_bridge.h
@@ -59,6 +59,11 @@ bool PreInitializeNativeBridge(const char* app_data_dir, const char* instruction
 // close emulated file descriptors, after doPreload() in app-zygote.
 void PreZygoteForkNativeBridge();
 
+// Private Floral process-selection hook used by the zygote specialization path.
+void SetFloralNativeBridgeProcessContext(const char* process_name,
+                                         const char* app_data_dir,
+                                         const char* selected_backend);
+
 // Initialize the native bridge, if any. Should be called by Runtime::DidForkFromZygote. The JNIEnv*
 // will be used to modify the app environment for the bridge.
 bool InitializeNativeBridge(JNIEnv* env, const char* instruction_set);
diff --git a/libnativebridge/native_bridge.cc b/libnativebridge/native_bridge.cc
index cc61f02..4cccf12 100644
--- a/libnativebridge/native_bridge.cc
+++ b/libnativebridge/native_bridge.cc
@@ -476,18 +476,20 @@ static bool BindFloralDirectBackend(void* router_handle) {
   return true;
 }
 
-void SetFloralNativeBridgeProcessContext(const char* process_name, const char* app_data_dir) {
+void SetFloralNativeBridgeProcessContext(const char* process_name,
+                                         const char* app_data_dir,
+                                         const char* selected_backend) {
   if (!FloralNativeLoaderEnabled() || state != NativeBridgeState::kOpened ||
       native_bridge_handle == nullptr ||
       floral_direct_backend_bound) {
     return;
   }
 
-  using SetProcessContextFn = void (*)(const char*, const char*);
+  using SetProcessContextFn = void (*)(const char*, const char*, const char*);
   auto set_process_context = reinterpret_cast<SetProcessContextFn>(
       dlsym(native_bridge_handle, "FloralNativeBridgeSetProcessContext"));
   if (set_process_context != nullptr) {
-    set_process_context(process_name, app_data_dir);
+    set_process_context(process_name, app_data_dir, selected_backend);
     using HybridLoaderFn = bool (*)();
     auto use_hybrid_loader = reinterpret_cast<HybridLoaderFn>(
         dlsym(native_bridge_handle, "FloralNativeBridgeUseHybridLoader"));
diff --git a/libnativebridge/native_bridge_lazy.cc b/libnativebridge/native_bridge_lazy.cc
index c531890..76e2a8d 100644
--- a/libnativebridge/native_bridge_lazy.cc
+++ b/libnativebridge/native_bridge_lazy.cc
@@ -55,9 +55,11 @@ bool PreInitializeNativeBridge(const char* app_data_dir, const char* instruction
   return f(app_data_dir, instruction_set);
 }
 
-void SetFloralNativeBridgeProcessContext(const char* process_name, const char* app_data_dir) {
+void SetFloralNativeBridgeProcessContext(const char* process_name,
+                                         const char* app_data_dir,
+                                         const char* selected_backend) {
   static auto f = GET_FUNC_PTR(SetFloralNativeBridgeProcessContext);
-  f(process_name, app_data_dir);
+  f(process_name, app_data_dir, selected_backend);
 }
 
 bool NativeBridgeUseHybridLoader() {
-- 
