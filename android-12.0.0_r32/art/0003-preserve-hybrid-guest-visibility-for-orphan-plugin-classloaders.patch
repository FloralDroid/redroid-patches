From 306f2c196febacdc5773ba41099fb4317c53ea5e Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Wed, 19 Aug 2026 23:30:36 +0800
Subject: [PATCH] art: preserve hybrid guest visibility for orphan plugin
 classloaders

Change-Id: Ie9bea235f511e5c39d93189bf061310fedeaf0fc
---
 libnativeloader/library_namespaces.cpp      | 10 +++-
 libnativeloader/native_loader.cpp           |  1 +
 libnativeloader/native_loader_namespace.cpp | 25 +++++++---
 libnativeloader/native_loader_namespace.h   |  4 +-
 libnativeloader/native_loader_test.cpp      | 53 +++++++++++++++++++++
 5 files changed, 84 insertions(+), 9 deletions(-)

diff --git a/libnativeloader/library_namespaces.cpp b/libnativeloader/library_namespaces.cpp
index 8cd980c..a6ae88e 100644
--- a/libnativeloader/library_namespaces.cpp
+++ b/libnativeloader/library_namespaces.cpp
@@ -283,6 +283,14 @@ Result<NativeLoaderNamespace*> LibraryNamespaces::Create(JNIEnv* env, uint32_t t
 
   // Create the app namespace
   NativeLoaderNamespace* parent_ns = FindParentNamespaceByClassLoader(env, class_loader);
+  // Some plugin frameworks construct a classloader whose Java parent chain
+  // cannot be associated with the app's main NativeLoader namespace. Preserve
+  // isolation on the host side, but give a hybrid guest namespace the main app
+  // namespace as its fallback parent so app-private guest runtimes stay visible.
+  NativeLoaderNamespace* guest_fallback_parent =
+      parent_ns == nullptr && app_main_namespace_ != nullptr && app_main_namespace_->IsHybrid()
+          ? app_main_namespace_
+          : nullptr;
   // Heuristic: the first classloader with non-empty library_path is assumed to
   // be the main classloader for app
   // TODO(b/139178525) remove this heuristic by determining this in LoadedApk (or its
@@ -294,7 +302,7 @@ Result<NativeLoaderNamespace*> LibraryNamespaces::Create(JNIEnv* env, uint32_t t
   // Note: this function is executed with g_namespaces_mutex held, thus no
   // racing here.
   auto app_ns = NativeLoaderNamespace::Create(
-      namespace_name, library_path, permitted_path, parent_ns, is_shared,
+      namespace_name, library_path, permitted_path, parent_ns, guest_fallback_parent, is_shared,
       target_sdk_version < 24 /* is_exempt_list_enabled */, also_used_as_anonymous);
   if (!app_ns.ok()) {
     return app_ns.error();
diff --git a/libnativeloader/native_loader.cpp b/libnativeloader/native_loader.cpp
index c53df8f..51349b9 100644
--- a/libnativeloader/native_loader.cpp
+++ b/libnativeloader/native_loader.cpp
@@ -100,6 +100,7 @@ Result<NativeLoaderNamespace*> GetNativeloaderExtraLibsNamespace() REQUIRES(g_na
                                     /*search_paths=*/"",
                                     /*permitted_paths=*/"",
                                     /*parent=*/nullptr,
+                                    /*guest_fallback_parent=*/nullptr,
                                     /*is_shared=*/false,
                                     /*is_exempt_list_enabled=*/false,
                                     /*also_used_as_anonymous=*/false);
diff --git a/libnativeloader/native_loader_namespace.cpp b/libnativeloader/native_loader_namespace.cpp
index fcdc58a..8108740 100644
--- a/libnativeloader/native_loader_namespace.cpp
+++ b/libnativeloader/native_loader_namespace.cpp
@@ -198,8 +198,8 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::GetSystemNamespace(bool is_
 
 Result<NativeLoaderNamespace> NativeLoaderNamespace::Create(
     const std::string& name, const std::string& search_paths, const std::string& permitted_paths,
-    const NativeLoaderNamespace* parent, bool is_shared, bool is_exempt_list_enabled,
-    bool also_used_as_anonymous) {
+    const NativeLoaderNamespace* parent, const NativeLoaderNamespace* guest_fallback_parent,
+    bool is_shared, bool is_exempt_list_enabled, bool also_used_as_anonymous) {
   bool is_bridged = false;
   if (parent != nullptr) {
     is_bridged = parent->IsBridged();
@@ -215,6 +215,8 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::Create(
   const NativeLoaderNamespace& effective_parent = parent != nullptr ? *parent : *system_ns;
   const bool use_hybrid =
       is_bridged && HybridElfRoutingEnabled() && NativeBridgeUseHybridLoader();
+  const NativeLoaderNamespace& effective_guest_parent =
+      use_hybrid && guest_fallback_parent != nullptr ? *guest_fallback_parent : effective_parent;
 
   // All namespaces for apps are isolated
   uint64_t type = ANDROID_NAMESPACE_TYPE_ISOLATED;
@@ -233,14 +235,23 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::Create(
   if (is_exempt_list_enabled) {
     type |= ANDROID_NAMESPACE_TYPE_EXEMPT_LIST_ENABLED;
   }
+  // A custom plugin classloader may hide its Java parent from NativeLoader.
+  // In hybrid mode only, let its guest namespace inherit the main app guest
+  // namespace so APK-private runtimes already loaded there remain available.
+  // The host namespace deliberately retains the original isolated topology.
+  uint64_t guest_type = type;
+  if (use_hybrid && guest_fallback_parent != nullptr) {
+    guest_type |= ANDROID_NAMESPACE_TYPE_SHARED;
+  }
 
   if (NamespaceAuditEnabled()) {
     ALOGI("Floral NB audit: create name=%s bridged=%d hybrid=%d parent_native=%p "
-          "parent_guest=%p search_entries=%zu permitted_entries=%zu flags=0x%" PRIx64,
+          "parent_guest=%p search_entries=%zu permitted_entries=%zu flags=0x%" PRIx64
+          " guest_flags=0x%" PRIx64,
           name.c_str(), is_bridged, use_hybrid,
           static_cast<void*>(effective_parent.ToRawAndroidNamespace()),
-          static_cast<void*>(effective_parent.ToRawNativeBridgeNamespace()),
-          CountListEntries(search_paths), CountListEntries(permitted_paths), type);
+          static_cast<void*>(effective_guest_parent.ToRawNativeBridgeNamespace()),
+          CountListEntries(search_paths), CountListEntries(permitted_paths), type, guest_type);
   }
 
   if (!is_bridged) {
@@ -267,8 +278,8 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::Create(
       }
     }
     native_bridge_namespace_t* raw = NativeBridgeCreateNamespace(
-        name.c_str(), nullptr, search_paths.c_str(), type, permitted_paths.c_str(),
-        effective_parent.ToRawNativeBridgeNamespace());
+        name.c_str(), nullptr, search_paths.c_str(), guest_type, permitted_paths.c_str(),
+        effective_guest_parent.ToRawNativeBridgeNamespace());
     if (raw != nullptr) {
       if (NamespaceAuditEnabled()) {
         ALOGI("Floral NB audit: created name=%s bridged=1 hybrid=%d native=%p guest=%p",
diff --git a/libnativeloader/native_loader_namespace.h b/libnativeloader/native_loader_namespace.h
index 153a1e8..700fed5 100644
--- a/libnativeloader/native_loader_namespace.h
+++ b/libnativeloader/native_loader_namespace.h
@@ -45,7 +45,9 @@ struct NativeLoaderNamespace {
   static Result<NativeLoaderNamespace> Create(const std::string& name,
                                               const std::string& search_paths,
                                               const std::string& permitted_paths,
-                                              const NativeLoaderNamespace* parent, bool is_shared,
+                                              const NativeLoaderNamespace* parent,
+                                              const NativeLoaderNamespace* guest_fallback_parent,
+                                              bool is_shared,
                                               bool is_exempt_list_enabled,
                                               bool also_used_as_anonymous);
 
diff --git a/libnativeloader/native_loader_test.cpp b/libnativeloader/native_loader_test.cpp
index b009a64..ef5e187 100644
--- a/libnativeloader/native_loader_test.cpp
+++ b/libnativeloader/native_loader_test.cpp
@@ -20,6 +20,7 @@
 
 #include <dlfcn.h>
 
+#include <android-base/properties.h>
 #include <android-base/strings.h>
 #include <gtest/gtest.h>
 
@@ -329,6 +330,58 @@ TEST_P(NativeLoaderTest_Create, BridgedDefaultNamespaceFallback) {
   RunTest();
 }
 
+TEST_P(NativeLoaderTest_Create, HybridOrphanPluginInheritsOnlyMainGuestNamespace) {
+  if (!IsBridged()) {
+    GTEST_SKIP() << "The fallback is specific to hybrid NativeBridge namespaces";
+  }
+
+  NativeLoaderTest::SetExpectations();
+  ASSERT_TRUE(android::base::SetProperty("ro.floral.bridge.hybrid_elf", "1") ||
+              android::base::GetBoolProperty("ro.floral.bridge.hybrid_elf", false));
+  ON_CALL(*mock, NativeBridgeUseHybridLoader()).WillByDefault(Return(true));
+  EXPECT_CALL(*mock, NativeBridgeIsPathSupported(_)).Times(testing::AnyNumber());
+
+  const std::string main_path = "/data/app/foo/lib/arm64";
+  const std::string plugin_path = "/data/user/0/foo/files/plugins/lib";
+  const std::string permitted_path = "/data:/mnt/expand:/data/user/0/foo";
+  constexpr uint64_t kMainType = ANDROID_NAMESPACE_TYPE_ISOLATED |
+                                 ANDROID_NAMESPACE_TYPE_ALSO_USED_AS_ANONYMOUS;
+
+  EXPECT_CALL(*mock, mock_create_namespace(false, StrEq("main-native"), nullptr,
+                                            StrEq(main_path), kMainType,
+                                            StrEq(permitted_path), NsEq("system")))
+      .WillOnce(Return(TO_MOCK_NAMESPACE(TO_ANDROID_NAMESPACE("main-host"))));
+  EXPECT_CALL(*mock, mock_create_namespace(true, StrEq("main"), nullptr,
+                                            StrEq(main_path), kMainType,
+                                            StrEq(permitted_path), NsEq("system")))
+      .WillOnce(Return(TO_MOCK_NAMESPACE(TO_ANDROID_NAMESPACE("main-guest"))));
+
+  auto main_ns = NativeLoaderNamespace::Create(
+      "main", main_path, permitted_path, /*parent=*/nullptr,
+      /*guest_fallback_parent=*/nullptr, /*is_shared=*/false,
+      /*is_exempt_list_enabled=*/false, /*also_used_as_anonymous=*/true);
+  ASSERT_TRUE(main_ns.ok()) << main_ns.error().message();
+
+  // The host plugin remains an isolated child of the system namespace. Only
+  // its guest peer becomes a shared child of the main application namespace.
+  EXPECT_CALL(*mock, mock_create_namespace(false, StrEq("plugin-native"), nullptr,
+                                            StrEq(plugin_path), ANDROID_NAMESPACE_TYPE_ISOLATED,
+                                            StrEq(permitted_path), NsEq("system")))
+      .WillOnce(Return(TO_MOCK_NAMESPACE(TO_ANDROID_NAMESPACE("plugin-host"))));
+  EXPECT_CALL(*mock, mock_create_namespace(
+                         true, StrEq("plugin"), nullptr, StrEq(plugin_path),
+                         ANDROID_NAMESPACE_TYPE_SHARED_ISOLATED, StrEq(permitted_path),
+                         NsEq("main-guest")))
+      .WillOnce(Return(TO_MOCK_NAMESPACE(TO_ANDROID_NAMESPACE("plugin-guest"))));
+
+  auto plugin_ns = NativeLoaderNamespace::Create(
+      "plugin", plugin_path, permitted_path, /*parent=*/nullptr,
+      /*guest_fallback_parent=*/&main_ns.value(), /*is_shared=*/false,
+      /*is_exempt_list_enabled=*/false, /*also_used_as_anonymous=*/false);
+  ASSERT_TRUE(plugin_ns.ok()) << plugin_ns.error().message();
+  EXPECT_TRUE(plugin_ns->IsHybrid());
+}
+
 TEST_P(NativeLoaderTest_Create, BundledSystemApp) {
   dex_path = "/system/app/foo/foo.apk";
   is_shared = true;
