From c51d50e3af52279f51f1ed7f5d78ccb405b33658 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Tue, 18 Aug 2026 19:34:04 +0800
Subject: [PATCH] art: keep guest JNI libraries in one NativeBridge namespace

Change-Id: Ic0d87c179f0aa588862fa1a1dde0d0ad31fb3d22
---
 libnativeloader/native_loader_namespace.cpp | 43 ++++-----------------
 1 file changed, 8 insertions(+), 35 deletions(-)

diff --git a/libnativeloader/native_loader_namespace.cpp b/libnativeloader/native_loader_namespace.cpp
index ab21f46..0183b60 100644
--- a/libnativeloader/native_loader_namespace.cpp
+++ b/libnativeloader/native_loader_namespace.cpp
@@ -93,22 +93,6 @@ ElfTarget ReadElfTarget(const char* path) {
   return ElfTarget::kUnknown;
 }
 
-bool IsSystemLibraryPath(const char* path) {
-  if (path == nullptr || path[0] != '/') {
-    return false;
-  }
-  constexpr const char* kSystemPrefixes[] = {
-      "/system/", "/system_ext/", "/product/", "/vendor/",
-      "/odm/",    "/apex/",
-  };
-  for (const char* prefix : kSystemPrefixes) {
-    if (strncmp(path, prefix, strlen(prefix)) == 0) {
-      return true;
-    }
-  }
-  return false;
-}
-
 std::string GetLinkerError(bool is_bridged) {
   const char* msg = is_bridged ? NativeBridgeGetError() : dlerror();
   if (msg == nullptr) {
@@ -281,31 +265,20 @@ Result<NativeLoaderNamespace::LoadResult> NativeLoaderNamespace::Load(const char
       return LoadResult{handle, false};
     }
   } else {
-    const ElfTarget target = ReadElfTarget(lib_name);
-    const bool native_elf = target == ElfTarget::kNative;
-    const bool system_library = IsSystemLibraryPath(lib_name);
-
-    // System x86 libraries keep host ownership. App-private native ELFs try
-    // the selected bridge first so Houdini can handle protected x86 names.
-    if (IsHybrid() && native_elf && system_library) {
-      android_dlextinfo extinfo;
-      extinfo.flags = ANDROID_DLEXT_USE_NAMESPACE;
-      extinfo.library_namespace = this->ToRawAndroidNamespace();
-      void* handle = android_dlopen_ext(lib_name, RTLD_NOW, &extinfo);
-      if (handle != nullptr) {
-        return LoadResult{handle, false};
-      }
-      return Error() << GetLinkerError(false);
-    }
+    const bool native_elf = ReadElfTarget(lib_name) == ElfTarget::kNative;
+    // Give the selected NativeBridge backend first ownership of every library
+    // in a bridged classloader. A package can contain an ELF that advertises
+    // the host machine while its JNI state belongs to the translated guest
+    // chain; routing that file to the host first splits JNI_OnLoad and
+    // RegisterNatives across incompatible loader contexts. Keep the native
+    // namespace as a compatibility fallback for libraries the backend rejects.
     void* handle = NativeBridgeLoadLibraryExt(
         lib_name, RTLD_NOW, this->ToRawNativeBridgeNamespace());
     if (handle != nullptr) {
       return LoadResult{handle, true};
     }
 
-    // A real app-private x86 ELF can still be native. Only fall back to the
-    // host linker after the selected translation backend rejects it.
-    if (IsHybrid() && native_elf && !system_library) {
+    if (IsHybrid() && native_elf) {
       android_dlextinfo extinfo;
       extinfo.flags = ANDROID_DLEXT_USE_NAMESPACE;
       extinfo.library_namespace = this->ToRawAndroidNamespace();
-- 
