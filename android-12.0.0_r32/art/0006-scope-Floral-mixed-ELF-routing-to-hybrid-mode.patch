diff --git a/libnativebridge/native_bridge.cc b/libnativebridge/native_bridge.cc
index 0d99711..01b9363 100644
--- a/libnativebridge/native_bridge.cc
+++ b/libnativebridge/native_bridge.cc
@@ -17,6 +17,7 @@
 #define LOG_TAG "nativebridge"
 
 #include "nativebridge/native_bridge.h"
+#include "nativebridge/native_bridge_private.h"
 
 #include <dlfcn.h>
 #include <errno.h>
@@ -138,6 +139,12 @@ static bool had_error = false;
 
 // Handle of the loaded library.
 static void* native_bridge_handle = nullptr;
+// Direct mode briefly uses the aggregate router to resolve the explicit
+// package rule, then releases it after ART owns the selected backend callbacks.
+// Application callbacks and namespace operations therefore cannot return to
+// libmixbridge after the direct binding point.
+static void* floral_router_handle = nullptr;
+static bool floral_direct_backend_bound = false;
 // Pointer to the callbacks. Available as soon as LoadNativeBridge succeeds, but only initialized
 // later.
 static const NativeBridgeCallbacks* callbacks = nullptr;
@@ -205,21 +211,25 @@ bool NativeBridgeNameAcceptable(const char* nb_library_filename) {
 
 // The policy of invoking Nativebridge changed in v3 with/without namespace.
 // Suggest Nativebridge implementation not maintain backward-compatible.
-static bool isCompatibleWith(const uint32_t version) {
+static bool isCompatibleWithCallbacks(const NativeBridgeCallbacks* cbs, const uint32_t version) {
   // Libnativebridge is now designed to be forward-compatible. So only "0" is an unsupported
   // version.
-  if (callbacks == nullptr || callbacks->version == 0 || version == 0) {
+  if (cbs == nullptr || cbs->version == 0 || version == 0) {
     return false;
   }
 
   // If this is a v2+ bridge, it may not be forwards- or backwards-compatible. Check.
-  if (callbacks->version >= SIGNAL_VERSION) {
-    return callbacks->isCompatibleWith(version);
+  if (cbs->version >= SIGNAL_VERSION) {
+    return cbs->isCompatibleWith(version);
   }
 
   return true;
 }
 
+static bool isCompatibleWith(const uint32_t version) {
+  return isCompatibleWithCallbacks(callbacks, version);
+}
+
 static void CloseNativeBridge(bool with_error) {
   state = NativeBridgeState::kClosed;
   had_error |= with_error;
@@ -383,8 +393,58 @@ bool PreInitializeNativeBridge(const char* app_data_dir_in, const char* instruct
   return true;
 }
 
+static bool BindFloralDirectBackend(void* router_handle) {
+  using PrepareDirectBackendFn = const char* (*)();
+  auto prepare_direct_backend = reinterpret_cast<PrepareDirectBackendFn>(
+      dlsym(router_handle, "FloralNativeBridgePrepareDirectBackend"));
+  if (prepare_direct_backend == nullptr) {
+    return false;
+  }
+
+  const char* backend_path = prepare_direct_backend();
+  if (backend_path == nullptr || backend_path[0] == '\0') {
+    return false;
+  }
+
+  void* backend_handle = OpenSystemLibrary(backend_path, RTLD_LAZY);
+  if (backend_handle == nullptr) {
+    ALOGE("Failed to bind Floral direct NativeBridge backend %s: %s", backend_path, dlerror());
+    return false;
+  }
+  if (backend_handle == router_handle) {
+    ALOGE("Floral direct NativeBridge backend resolved to the aggregate router: %s",
+          backend_path);
+    dlclose(backend_handle);
+    return false;
+  }
+
+  auto direct_callbacks = reinterpret_cast<const NativeBridgeCallbacks*>(
+      dlsym(backend_handle, kNativeBridgeInterfaceSymbol));
+  if (!isCompatibleWithCallbacks(direct_callbacks, NAMESPACE_VERSION)) {
+    ALOGE("Floral direct NativeBridge backend %s has an incompatible interface", backend_path);
+    dlclose(backend_handle);
+    return false;
+  }
+
+  floral_router_handle = router_handle;
+  native_bridge_handle = backend_handle;
+  callbacks = direct_callbacks;
+  floral_direct_backend_bound = true;
+  // The router is a selection shim only. Do not leave it mapped in a direct
+  // process where an app could observe Floral's loader or diagnostics path.
+  if (dlclose(router_handle) != 0) {
+    ALOGW("Failed to release Floral direct NativeBridge router: %s", dlerror());
+  }
+  floral_router_handle = nullptr;
+  ALOGI("Bound Floral direct NativeBridge backend %s (interface v%u)",
+        backend_path,
+        direct_callbacks->version);
+  return true;
+}
+
 void SetFloralNativeBridgeProcessContext(const char* process_name, const char* app_data_dir) {
-  if (state != NativeBridgeState::kOpened || native_bridge_handle == nullptr) {
+  if (state != NativeBridgeState::kOpened || native_bridge_handle == nullptr ||
+      floral_direct_backend_bound) {
     return;
   }
 
@@ -393,9 +447,27 @@ void SetFloralNativeBridgeProcessContext(const char* process_name, const char* a
       dlsym(native_bridge_handle, "FloralNativeBridgeSetProcessContext"));
   if (set_process_context != nullptr) {
     set_process_context(process_name, app_data_dir);
+    BindFloralDirectBackend(native_bridge_handle);
   }
 }
 
+bool NativeBridgeUseHybridLoader() {
+  if ((state != NativeBridgeState::kOpened &&
+       state != NativeBridgeState::kPreInitialized &&
+       state != NativeBridgeState::kInitialized) ||
+      native_bridge_handle == nullptr) {
+    return false;
+  }
+  if (floral_direct_backend_bound) {
+    return false;
+  }
+
+  using HybridLoaderFn = bool (*)();
+  auto use_hybrid_loader = reinterpret_cast<HybridLoaderFn>(
+      dlsym(native_bridge_handle, "FloralNativeBridgeUseHybridLoader"));
+  return use_hybrid_loader != nullptr && use_hybrid_loader();
+}
+
 void PreZygoteForkNativeBridge() {
   if (NativeBridgeInitialized()) {
     if (isCompatibleWith(PRE_ZYGOTE_FORK_VERSION)) {
@@ -523,6 +595,10 @@ bool InitializeNativeBridge(JNIEnv* env, const char* instruction_set) {
       } else {
         // Unload the library.
         dlclose(native_bridge_handle);
+        if (floral_router_handle != nullptr) {
+          dlclose(floral_router_handle);
+          floral_router_handle = nullptr;
+        }
         CloseNativeBridge(true);
       }
     }
@@ -543,6 +619,10 @@ void UnloadNativeBridge() {
     case NativeBridgeState::kInitialized:
       // Unload.
       dlclose(native_bridge_handle);
+      if (floral_router_handle != nullptr) {
+        dlclose(floral_router_handle);
+        floral_router_handle = nullptr;
+      }
       CloseNativeBridge(false);
       break;
 
