From 3716176aa6e28c5e6a28bd69744373f92a306113 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Thu, 20 Aug 2026 22:07:17 +0800
Subject: [PATCH] art: keep hybrid app classloaders in one namespace

Change-Id: I00d9a5b0d7b469642cf258e4774acbcee674f176
---
 libnativeloader/native_loader_namespace.cpp | 22 ++++++---------------
 1 file changed, 6 insertions(+), 16 deletions(-)

diff --git a/libnativeloader/native_loader_namespace.cpp b/libnativeloader/native_loader_namespace.cpp
index 79bc9d7..376775d 100644
--- a/libnativeloader/native_loader_namespace.cpp
+++ b/libnativeloader/native_loader_namespace.cpp
@@ -284,27 +284,17 @@ Result<NativeLoaderNamespace> NativeLoaderNamespace::Create(
       return NativeLoaderNamespace(name, raw);
     }
   } else {
-    android_namespace_t* native_raw = nullptr;
-    if (use_hybrid) {
-      const std::string native_name = name + "-native";
-      native_raw = android_create_namespace(
-          native_name.c_str(), nullptr, search_paths.c_str(), type, permitted_paths.c_str(),
-          effective_parent.ToRawAndroidNamespace());
-      if (native_raw == nullptr) {
-        ALOGW("Failed to create hybrid native namespace %s; using bridged namespace only",
-              native_name.c_str());
-      }
-    }
+    // Keep a bridged app classloader in one NativeBridge namespace. Houdini's
+    // own mixed-ABI loader remains responsible for deciding how each ELF is
+    // executed; creating a parallel host namespace here splits loader state
+    // and changes the ownership semantics observed by the application.
     native_bridge_namespace_t* raw = NativeBridgeCreateNamespace(
         name.c_str(), nullptr, search_paths.c_str(), guest_type, permitted_paths.c_str(),
         effective_guest_parent.ToRawNativeBridgeNamespace());
     if (raw != nullptr) {
       if (NamespaceAuditEnabled()) {
-        ALOGI("Floral NB audit: created name=%s bridged=1 hybrid=%d native=%p guest=%p",
-              name.c_str(), use_hybrid, static_cast<void*>(native_raw), static_cast<void*>(raw));
-      }
-      if (native_raw != nullptr) {
-        return NativeLoaderNamespace(name, native_raw, raw);
+        ALOGI("Floral NB audit: created name=%s bridged=1 hybrid=%d guest=%p",
+              name.c_str(), use_hybrid, static_cast<void*>(raw));
       }
       return NativeLoaderNamespace(name, raw);
     }
-- 
