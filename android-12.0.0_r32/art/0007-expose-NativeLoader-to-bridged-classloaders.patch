From 6e8276a6ed1e11999622c3a3b0f13bd07358275f Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Tue, 18 Aug 2026 17:38:48 +0800
Subject: [PATCH] art: expose NativeLoader to bridged classloaders

Some translated applications resolve CreateClassLoaderNamespace and the other public NativeLoader entry points with dlopen and dlsym. Their bridged classloader namespaces currently cannot reach the guest libnativeloader copy, so those applications fail their native namespace initialization.

Preload the guest libnativeloader into the NativeBridge system namespace before creating app namespaces, then add a guest-only classloader link. Keep the existing host link unchanged in hybrid mode and cover both steps with the NativeLoader tests.

Change-Id: I73b213dfc104642bc74456e25023f67328de0fcc
---
 libnativeloader/library_namespaces.cpp      | 42 +++++++++++++++++++++
 libnativeloader/native_loader_namespace.cpp | 21 ++++++++---
 libnativeloader/native_loader_namespace.h   |  6 +++
 libnativeloader/native_loader_test.cpp      | 11 ++++++
 4 files changed, 75 insertions(+), 5 deletions(-)

diff --git a/libnativeloader/library_namespaces.cpp b/libnativeloader/library_namespaces.cpp
index 8b87338..1d0c6d8 100644
--- a/libnativeloader/library_namespaces.cpp
+++ b/libnativeloader/library_namespaces.cpp
@@ -30,6 +30,7 @@
 #include <android-base/macros.h>
 #include <android-base/result.h>
 #include <android-base/strings.h>
+#include <nativebridge/native_bridge.h>
 #include <nativehelper/scoped_utf_chars.h>
 
 #include "nativeloader/dlext_namespaces.h"
@@ -61,6 +62,9 @@ constexpr const char* kVndkProductNamespaceName = "vndk_product";
 constexpr const char* kClassloaderNamespaceName = "classloader-namespace";
 // Same thing for vendor APKs.
 constexpr const char* kVendorClassloaderNamespaceName = "vendor-classloader-namespace";
+// NativeBridge applications may load this guest library to resolve the stable
+// NativeLoader API through dlopen/dlsym.
+constexpr const char* kBridgedNativeLoaderLibrary = "libnativeloader.so";
 // If the namespace is shared then add this suffix to form
 // "classloader-namespace-shared" or "vendor-classloader-namespace-shared",
 // respectively. A shared namespace (cf. ANDROID_NAMESPACE_TYPE_SHARED) has
@@ -111,6 +115,33 @@ ApkOrigin GetApkOriginFromDexPath(const std::string& dex_path) {
   return apk_origin;
 }
 
+void PreloadBridgedNativeLoader() {
+  if (!NativeBridgeInitialized()) {
+    return;
+  }
+
+  native_bridge_namespace_t* system_ns = NativeBridgeGetExportedNamespace("system");
+  if (system_ns == nullptr) {
+    system_ns = NativeBridgeGetExportedNamespace("default");
+  }
+  if (system_ns == nullptr) {
+    ALOGW("Cannot preload guest %s: system NativeBridge namespace is unavailable",
+          kBridgedNativeLoaderLibrary);
+    return;
+  }
+
+  // SoLoader resolves NativeLoader entry points with dlopen/dlsym. The
+  // classloader link alone is insufficient until the guest library has been
+  // materialized in the NativeBridge system namespace.
+  void* handle = NativeBridgeLoadLibraryExt(
+      kBridgedNativeLoaderLibrary, RTLD_NOW | RTLD_NODELETE, system_ns);
+  if (handle == nullptr) {
+    const char* error = NativeBridgeGetError();
+    ALOGW("Failed to preload guest %s: %s", kBridgedNativeLoaderLibrary,
+          error == nullptr ? "unknown error" : error);
+  }
+}
+
 }  // namespace
 
 void LibraryNamespaces::Initialize() {
@@ -121,6 +152,8 @@ void LibraryNamespaces::Initialize() {
     return;
   }
 
+  PreloadBridgedNativeLoader();
+
   // Load the preloadable public libraries. Since libnativeloader is in the
   // com_android_art namespace, use OpenSystemLibrary rather than dlopen to
   // ensure the libraries are loaded in the system namespace.
@@ -311,6 +344,15 @@ Result<NativeLoaderNamespace*> LibraryNamespaces::Create(JNIEnv* env, uint32_t t
     return linked.error();
   }
 
+  if (is_bridged) {
+    // Keep libnativeloader guest-only. In hybrid mode Link() would otherwise
+    // expose the host ART copy to the app's parallel host namespace.
+    linked = app_ns->LinkNativeBridge(&system_ns.value(), kBridgedNativeLoaderLibrary);
+    if (!linked.ok()) {
+      return linked.error();
+    }
+  }
+
   for (const auto&[apex_ns_name, public_libs] : apex_public_libraries()) {
     auto ns = NativeLoaderNamespace::GetExportedNamespace(apex_ns_name, is_bridged);
     // Even if APEX namespace is visible, it may not be available to bridged.
diff --git a/libnativeloader/native_loader_namespace.cpp b/libnativeloader/native_loader_namespace.cpp
index 20daa7f..ab21f46 100644
--- a/libnativeloader/native_loader_namespace.cpp
+++ b/libnativeloader/native_loader_namespace.cpp
@@ -251,15 +251,26 @@ Result<void> NativeLoaderNamespace::Link(const NativeLoaderNamespace* target,
         ALOGW("Failed to link hybrid native namespace %s: %s", name_.c_str(), dlerror());
       }
     }
-    if (NativeBridgeLinkNamespaces(this->ToRawNativeBridgeNamespace(),
-                                   target == nullptr ? nullptr : target->ToRawNativeBridgeNamespace(),
-                                   shared_libs.c_str())) {
-      return {};
-    }
+    return LinkNativeBridge(target, shared_libs);
   }
   return Error() << GetLinkerError(IsBridged());
 }
 
+Result<void> NativeLoaderNamespace::LinkNativeBridge(const NativeLoaderNamespace* target,
+                                                     const std::string& shared_libs) const {
+  LOG_ALWAYS_FATAL_IF(!IsBridged(), "NativeBridge-only link requested from native namespace %s",
+                      name_.c_str());
+  LOG_ALWAYS_FATAL_IF(shared_libs.empty(), "empty NativeBridge share lib when linking %s to %s",
+                      name_.c_str(), target == nullptr ? "default" : target->name().c_str());
+
+  if (NativeBridgeLinkNamespaces(this->ToRawNativeBridgeNamespace(),
+                                 target == nullptr ? nullptr : target->ToRawNativeBridgeNamespace(),
+                                 shared_libs.c_str())) {
+    return {};
+  }
+  return Error() << GetLinkerError(true);
+}
+
 Result<NativeLoaderNamespace::LoadResult> NativeLoaderNamespace::Load(const char* lib_name) const {
   if (!IsBridged()) {
     android_dlextinfo extinfo;
diff --git a/libnativeloader/native_loader_namespace.h b/libnativeloader/native_loader_namespace.h
index 4f6f2f6..c4d6f44 100644
--- a/libnativeloader/native_loader_namespace.h
+++ b/libnativeloader/native_loader_namespace.h
@@ -68,6 +68,12 @@ struct NativeLoaderNamespace {
   // default namespace.
   Result<void> Link(const NativeLoaderNamespace* target, const std::string& shared_libs) const;
 
+  // Creates a link only between NativeBridge namespaces. Hybrid classloaders
+  // use this for guest-only system libraries that must not be visible to the
+  // host namespace.
+  Result<void> LinkNativeBridge(const NativeLoaderNamespace* target,
+                                const std::string& shared_libs) const;
+
   Result<LoadResult> Load(const char* lib_name) const;
 
   static Result<NativeLoaderNamespace> GetExportedNamespace(const std::string& name,
diff --git a/libnativeloader/native_loader_test.cpp b/libnativeloader/native_loader_test.cpp
index c1dd4aa..a7eeec0 100644
