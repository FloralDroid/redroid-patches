 hardware.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/hardware.c b/hardware.c
index 6e72ce9f..6f16270b 100644
--- a/hardware.c
+++ b/hardware.c
@@ -57,8 +57,9 @@
  */
 
 static const char *variant_keys[] = {
-    "ro.hardware",  /* This goes first so that it can pick up a different
