diff --git a/Android.bp b/Android.bp
index cbc59cb0..87d62fe4 100644
--- a/Android.bp
+++ b/Android.bp
@@ -226,6 +226,16 @@ llvm_x86_static_libraries = [
     "libLLVMX86Disassembler",
 ]
 
+llvm_amdgpu_static_libraries = [
+    "libLLVMAMDGPUCodeGen",
+    "libLLVMAMDGPUInfo",
+    "libLLVMAMDGPUDesc",
+    "libLLVMAMDGPUAsmParser",
+    "libLLVMAMDGPUAsmPrinter",
+    "libLLVMAMDGPUDisassembler",
+    "libLLVMAMDGPUUtils",
+]
+
 llvm_mips_static_libraries = [
     "libLLVMMipsCodeGen",
     "libLLVMMipsInfo",
@@ -328,12 +338,14 @@ cc_library {
         android_x86: {
             whole_static_libs: llvm_x86_static_libraries +
                 llvm_arm_static_libraries +
-                llvm_aarch64_static_libraries,
+                llvm_aarch64_static_libraries +
+                llvm_amdgpu_static_libraries,
         },
         android_x86_64: {
             whole_static_libs: llvm_x86_static_libraries +
                 llvm_arm_static_libraries +
-                llvm_aarch64_static_libraries,
+                llvm_aarch64_static_libraries +
+                llvm_amdgpu_static_libraries,
         },
         android_arm64: {
             whole_static_libs: llvm_aarch64_static_libraries +
