diff --git a/device/include/llvm/Config/Targets.def b/device/include/llvm/Config/Targets.def
index fe326530..0b35ad35 100755
--- a/device/include/llvm/Config/Targets.def
+++ b/device/include/llvm/Config/Targets.def
@@ -30,6 +30,9 @@
   LLVM_TARGET(Mips)
 #elif defined(__i386__) || defined(__x86_64__)
   LLVM_TARGET(X86)
+#if !defined(MCLD_TARGET) && !defined(MCLD_LINKER)
+  LLVM_TARGET(AMDGPU)
+#endif
 
 #if defined(FORCE_BUILD_ARM)
   LLVM_TARGET(ARM)
diff --git a/lib/Target/AMDGPU/Android.bp b/lib/Target/AMDGPU/Android.bp
new file mode 100644
index 00000000..9b8105dc
--- /dev/null
+++ b/lib/Target/AMDGPU/Android.bp
@@ -0,0 +1,54 @@
+package {
+    default_applicable_licenses: ["external_llvm_license"],
+}
+
+cc_library_static {
+    name: "libLLVMAMDGPUCodeGen",
+    defaults: [
+        "llvm-lib-defaults",
+        "llvm-amdgpu-defaults",
+    ],
+    srcs: ["*.cpp"],
+    exclude_srcs: ["AMDGPUCallLowering.cpp"],
+    cflags: ["-Wno-unreachable-code-loop-increment"],
+}
+
+cc_defaults {
+    name: "llvm-amdgpu-defaults",
+    generated_headers: ["llvm-gen-amdgpu"],
+    static_libs: ["llvm-amdgpu-headers"],
+}
+
+cc_library_static {
+    name: "llvm-amdgpu-headers",
+    vendor_available: true,
+    product_available: true,
+    host_supported: true,
+    native_bridge_supported: true,
+    target: {
+        windows: {
+            enabled: true,
+        },
+    },
+    export_include_dirs: ["."],
+}
+
+llvm_tblgen {
+    name: "llvm-gen-amdgpu",
+    in: "AMDGPU.td",
+    outs: [
+        "AMDGPUGenRegisterInfo.inc",
+        "AMDGPUGenInstrInfo.inc",
+        "AMDGPUGenDAGISel.inc",
+        "AMDGPUGenCallingConv.inc",
+        "AMDGPUGenSubtargetInfo.inc",
+        "AMDGPUGenIntrinsics.inc",
+        "AMDGPUGenMCCodeEmitter.inc",
+        "AMDGPUGenDFAPacketizer.inc",
+        "AMDGPUGenAsmWriter.inc",
+        "AMDGPUGenAsmMatcher.inc",
+        "AMDGPUGenDisassemblerTables.inc",
+    ],
+}
+
+subdirs = ["*"]
