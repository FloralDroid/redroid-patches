From 07305d4053449bc92c6fca5dd0d639de98b38466 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Tue, 18 Aug 2026 14:06:12 +0800
Subject: [PATCH] mesa: import Floral gralloc planes for Android EGL

Change-Id: I4f59e51156372b682eee21e5c6ff0844f72f3b1d
---
 src/egl/drivers/dri2/platform_android.c | 130 +++++++++++++++++++++++-
 1 file changed, 128 insertions(+), 2 deletions(-)

diff --git a/src/egl/drivers/dri2/platform_android.c b/src/egl/drivers/dri2/platform_android.c
index 2b75dfa..12a52c8 100644
--- a/src/egl/drivers/dri2/platform_android.c
+++ b/src/egl/drivers/dri2/platform_android.c
@@ -32,9 +32,11 @@
 #include <dirent.h>
 #include <dlfcn.h>
 #include <fcntl.h>
+#include <limits.h>
 #include <xf86drm.h>
 #include <stdbool.h>
 #include <stdio.h>
+#include <stdint.h>
 #include <sync/sync.h>
 #include <sys/types.h>
 #include <drm-uapi/drm_fourcc.h>
@@ -159,7 +161,7 @@ static int get_fourcc(int native)
 
 /* returns # of fds, and by reference the actual fds */
 static unsigned
-get_native_buffer_fds(struct ANativeWindowBuffer *buf, int fds[3])
+get_native_buffer_fds(struct ANativeWindowBuffer *buf, int *fds, unsigned capacity)
 {
    native_handle_t *handle = (native_handle_t *)buf->handle;
 
@@ -171,6 +173,10 @@ get_native_buffer_fds(struct ANativeWindowBuffer *buf, int fds[3])
     * to be first. Access it directly to avoid a dependency on specific
     * gralloc versions.
     */
+   if (capacity == 0 || handle->numFds < 0 ||
+       (unsigned)handle->numFds > capacity)
+      return 0;
+
    for (int i = 0; i < handle->numFds; i++)
       fds[i] = handle->data[i];
 
@@ -282,7 +288,7 @@ droid_create_image_from_prime_fds(_EGLDisplay *disp,
    int num_fds;
    int fds[3];
 
-   num_fds = get_native_buffer_fds(buf, fds);
+   num_fds = get_native_buffer_fds(buf, fds, 3);
    if (num_fds == 0)
       return NULL;
 
@@ -341,6 +347,55 @@ droid_create_image_from_prime_fds(_EGLDisplay *disp,
 
 static const char cros_gralloc_module_name[] = "CrOS Gralloc";
 
+/*
+ * Floral gralloc exposes canonical dma-buf metadata through a versioned
+ * gralloc0 perform operation. Keep this wire layout local to Mesa so the
+ * optional integration does not create a build-time dependency on Floral.
+ */
+#define FLORAL_GRALLOC_MODULE_PERFORM_GET_BUFFER_METADATA 0x464c0001
+#define FLORAL_GRALLOC_BUFFER_METADATA_VERSION_1 1
+#define FLORAL_GRALLOC_BUFFER_METADATA_V1_SIZE 256
+#define FLORAL_GRALLOC_BUFFER_METADATA_FLAG_DRM_PRIME (1U << 0)
+#define FLORAL_GRALLOC_BUFFER_MAX_DRM_OBJECTS 4
+#define FLORAL_GRALLOC_BUFFER_MAX_DRM_PLANES 4
+
+struct floral_gralloc_drm_object_v1 {
+   uint32_t fd_index;
+   uint32_t flags;
+   uint64_t size;
+   uint64_t modifier;
+};
+
+struct floral_gralloc_drm_plane_v1 {
+   uint32_t object_index;
+   uint32_t reserved_0;
+   uint64_t offset;
+   uint64_t pitch;
+};
+
+struct floral_gralloc_buffer_metadata_v1 {
+   uint32_t struct_size;
+   uint32_t version;
+   uint32_t flags;
+   uint32_t width;
+   uint32_t height;
+   uint32_t layers;
+   int32_t format;
+   uint32_t stride;
+   uint64_t usage;
+   uint64_t buffer_id;
+   uint32_t drm_format;
+   uint32_t drm_object_count;
+   uint32_t drm_plane_count;
+   uint32_t reserved_0;
+   struct floral_gralloc_drm_object_v1 drm_objects[FLORAL_GRALLOC_BUFFER_MAX_DRM_OBJECTS];
+   struct floral_gralloc_drm_plane_v1 drm_planes[FLORAL_GRALLOC_BUFFER_MAX_DRM_PLANES];
+};
+
+_Static_assert(sizeof(struct floral_gralloc_buffer_metadata_v1) ==
+                  FLORAL_GRALLOC_BUFFER_METADATA_V1_SIZE,
+               "Floral gralloc metadata ABI layout changed");
+
 #define CROS_GRALLOC_DRM_GET_BUFFER_INFO 4
 
 struct cros_gralloc0_buffer_info {
@@ -352,6 +407,73 @@ struct cros_gralloc0_buffer_info {
    int stride[4];
 };
 
+static __DRIimage *
+droid_create_image_from_floral_info(_EGLDisplay *disp,
+                                    struct ANativeWindowBuffer *buf)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   struct floral_gralloc_buffer_metadata_v1 info;
+   int native_fds[3];
+   int fds[FLORAL_GRALLOC_BUFFER_MAX_DRM_OBJECTS] = { 0 };
+   int offsets[FLORAL_GRALLOC_BUFFER_MAX_DRM_PLANES] = { 0 };
+   int strides[FLORAL_GRALLOC_BUFFER_MAX_DRM_PLANES] = { 0 };
+   unsigned num_native_fds;
+   unsigned num_fds = 0;
+   unsigned error;
+
+   if (strcmp(dri2_dpy->gralloc->common.name, "GBM Memory Allocator") != 0 ||
+       !dri2_dpy->gralloc->perform ||
+       dri2_dpy->image->base.version < 15 ||
+       !dri2_dpy->image->createImageFromDmaBufs2)
+      return NULL;
+
+   memset(&info, 0, sizeof(info));
+   info.struct_size = sizeof(info);
+   info.version = FLORAL_GRALLOC_BUFFER_METADATA_VERSION_1;
+   if (dri2_dpy->gralloc->perform(
+          dri2_dpy->gralloc, FLORAL_GRALLOC_MODULE_PERFORM_GET_BUFFER_METADATA,
+          buf->handle, &info) != 0 ||
+       info.struct_size != sizeof(info) ||
+       info.version != FLORAL_GRALLOC_BUFFER_METADATA_VERSION_1 ||
+       !(info.flags & FLORAL_GRALLOC_BUFFER_METADATA_FLAG_DRM_PRIME) ||
+       info.drm_object_count == 0 ||
+       info.drm_object_count > FLORAL_GRALLOC_BUFFER_MAX_DRM_OBJECTS ||
+       info.drm_plane_count == 0 ||
+       info.drm_plane_count > FLORAL_GRALLOC_BUFFER_MAX_DRM_PLANES)
+      return NULL;
+
+   num_native_fds = get_native_buffer_fds(buf, native_fds, sizeof(native_fds) / sizeof(native_fds[0]));
+   if (!num_native_fds)
+      return NULL;
+
+   for (unsigned i = 0; i < info.drm_object_count; ++i) {
+      const struct floral_gralloc_drm_object_v1 *object = &info.drm_objects[i];
+      if (object->fd_index >= num_native_fds || object->fd_index >= 3 ||
+          object->modifier != info.drm_objects[0].modifier)
+         return NULL;
+   }
+
+   for (unsigned i = 0; i < info.drm_plane_count; ++i) {
+      const struct floral_gralloc_drm_plane_v1 *plane = &info.drm_planes[i];
+      if (plane->object_index >= info.drm_object_count ||
+          plane->offset > INT_MAX || plane->pitch > INT_MAX)
+         return NULL;
+      /* DRI expects one fd entry per DRM plane, even when several planes
+       * share one dma-buf object. */
+      fds[i] = native_fds[info.drm_objects[plane->object_index].fd_index];
+      offsets[i] = (int)plane->offset;
+      strides[i] = (int)plane->pitch;
+   }
+   num_fds = info.drm_plane_count;
+
+   return dri2_dpy->image->createImageFromDmaBufs2(
+      dri2_dpy->dri_screen, buf->width, buf->height, info.drm_format,
+      info.drm_objects[0].modifier, fds, num_fds, strides, offsets,
+      EGL_ITU_REC601_EXT, EGL_YUV_NARROW_RANGE_EXT,
+      EGL_YUV_CHROMA_SITING_0_EXT, EGL_YUV_CHROMA_SITING_0_EXT,
+      &error, NULL);
+}
+
 static __DRIimage *
 droid_create_image_from_cros_info(_EGLDisplay *disp,
                                   struct ANativeWindowBuffer *buf)
@@ -389,6 +511,10 @@ droid_create_image_from_native_buffer(_EGLDisplay *disp,
 {
    __DRIimage *dri_image;
 
+   dri_image = droid_create_image_from_floral_info(disp, buf);
+   if (dri_image)
+      return dri_image;
+
    dri_image = droid_create_image_from_cros_info(disp, buf);
    if (dri_image)
       return dri_image;
-- 
